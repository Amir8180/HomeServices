{
  "ConnectionStrings": {
    "DefaultConnection": "Server=.;Database=HomeServicesDb;User Id=sa;Password=1;TrustServerCertificate=True;Encrypt=False;",
    "Redis": ""
  },
  "IdentityApiSettings": {
    "BaseUrl": "https://localhost:7047",
    "TokenEndpoint": "/api/auth/login"
  },
  "JwtSettings": {
    "Key": "HomeServices_SecretKey_ForDev_Only!Min32Chars!!",
    "Issuer": "HomeServices.Identity",
    "Audience": "HomeServices.Mvc",
    "AccessTokenExpirationMinutes": 60,
    "RefreshTokenExpirationDays": 7
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/homeservices-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14
        }
      },
      {
        "Name": "Seq",
        "Args": { "serverUrl": "http://localhost:5341" }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  },
  "AllowedHosts": "*"
}
