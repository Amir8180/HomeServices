@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Portfolio</title>
<link href="https://cdn.jsdelivr.net/gh/rastikerdar/vazirmatn@v33.003/Vazirmatn-font-face.css" rel="stylesheet" />
<style>
/* ── reset ─────────────────────────────────── */
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
html,body{width:100%;height:100%;overflow:hidden;font-family:'Vazirmatn',sans-serif}

/* ── video background ───────────────────────── */
.bg-video{
    position:fixed;
    inset:0;
    width:100%;
    height:100%;
    object-fit:cover;
    object-position:center center;
    z-index:0;
    pointer-events:none;
}

/* thin dark overlay so text stays readable */
.bg-overlay{
    position:fixed;
    inset:0;
    z-index:1;
    background:linear-gradient(
        to left,
        rgba(0,0,0,0.18) 0%,
        rgba(0,0,0,0.06) 50%,
        rgba(0,0,0,0.0)  100%
    );
    pointer-events:none;
}

/* ── page layout ─────────────────────────────
   The video has the sun + tree in the center/left.
   We anchor the content panel to the RIGHT side.
──────────────────────────────────────────────── */
.page{
    position:relative;
    z-index:2;
    width:100%;
    min-height:100vh;
    display:flex;
    align-items:center;
    /* push content to the right half + extra 100px from edge */
    justify-content:flex-end;
    padding:24px calc(5vw + 100px) 24px 50%;
}

/* ── card ────────────────────────────────────── */
.card{
    position:relative;
    background:rgba(255,255,255,0.74);
    backdrop-filter:blur(20px);
    -webkit-backdrop-filter:blur(20px);
    border:1px solid rgba(255,255,255,0.60);
    border-radius:28px;
    padding:68px 48px 44px;
    width:100%;
    max-width:480px;
    box-shadow:
        0 8px 40px rgba(0,0,0,0.18),
        0 2px 8px rgba(0,0,0,0.08),
        inset 0 1px 0 rgba(255,255,255,0.85);
    text-align:right;
    animation:card-in 0.85s cubic-bezier(0.16,1,0.3,1) both;
}

@@keyframes card-in{
    from{opacity:0;transform:translateY(28px) scale(0.97)}
    to{opacity:1;transform:translateY(0) scale(1)}
}

/* ── avatar ─────────────────────────────────── */
.avatar-wrap{
    position:absolute;
    /* right side of card, near top, since page is RTL */
    top:-60px;
    right:40px;
    width:112px;
    height:112px;
}

.avatar-ring{
    width:112px;
    height:112px;
    border-radius:50%;
    border:3.5px solid rgba(139,100,50,0.50);
    background:rgba(255,255,255,0.65);
    backdrop-filter:blur(10px);
    box-shadow:
        0 8px 32px rgba(100,70,30,0.28),
        inset 0 1px 0 rgba(255,255,255,0.9);
    overflow:hidden;
    display:flex;
    align-items:center;
    justify-content:center;
    transition:box-shadow 0.3s, transform 0.3s;
    cursor:default;
}

.avatar-ring:hover{
    transform:scale(1.06);
    box-shadow:0 12px 40px rgba(100,70,30,0.38);
}

.avatar-ring img{
    width:100%;
    height:100%;
    object-fit:cover;
    border-radius:50%;
    display:block;
}

/* ── bio text ────────────────────────────────── */
.bio{
    margin-top:16px;
    font-size:0.975rem;
    line-height:1.95;
    color:#1e1610;
    font-weight:400;
    letter-spacing:0.01em;
}

.bio strong{
    color:#7a5c2a;
    font-weight:700;
}

.bio p+p{margin-top:0.85rem}

/* ── CTA button ─────────────────────────────── */
.cta-wrap{
    margin-top:32px;
    display:flex;
    justify-content:center;
}

.cta-btn{
    position:relative;
    display:inline-flex;
    align-items:center;
    gap:10px;
    padding:14px 40px;
    background:linear-gradient(135deg,#7a5c2a 0%,#c9902e 50%,#7a5c2a 100%);
    background-size:200% 200%;
    color:white;
    text-decoration:none;
    border-radius:100px;
    font-size:1rem;
    font-weight:700;
    font-family:'Vazirmatn',sans-serif;
    letter-spacing:0.03em;
    box-shadow:0 6px 28px rgba(122,92,42,0.42), 0 2px 8px rgba(0,0,0,0.14);
    transition:all 0.32s cubic-bezier(0.16,1,0.3,1);
    overflow:hidden;
    animation:grad-shift 4s ease infinite;
}

@@keyframes grad-shift{
    0%{background-position:0% 50%}
    50%{background-position:100% 50%}
    100%{background-position:0% 50%}
}

.cta-btn::before{
    content:'';
    position:absolute;
    inset:0;
    background:linear-gradient(120deg,transparent 0%,rgba(255,255,255,0.24) 50%,transparent 100%);
    transform:translateX(-100%);
    transition:transform 0.52s ease;
}

.cta-btn:hover{
    transform:translateY(-3px) scale(1.04);
    box-shadow:0 12px 36px rgba(122,92,42,0.52), 0 4px 12px rgba(0,0,0,0.16);
    color:white;
}

.cta-btn:hover::before{transform:translateX(100%)}
.cta-btn:active{transform:translateY(-1px) scale(1.01)}

.arr{
    display:inline-block;
    font-style:normal;
    animation:arr-pulse 1.8s ease-in-out infinite;
}

@@keyframes arr-pulse{
    0%,100%{transform:translateX(0)}
    50%{transform:translateX(-5px)}
}

/* ── responsive ──────────────────────────────── */
@@media(max-width:900px){
    .page{
        justify-content:center;
        padding:80px 20px 40px;
    }
    .card{max-width:520px}
}
@@media(max-width:540px){
    .card{padding:72px 24px 36px;border-radius:22px}
    .avatar-wrap{right:50%;transform:translateX(50%);top:-54px;width:96px;height:96px}
    .avatar-ring{width:96px;height:96px}
    .bio{font-size:0.92rem;line-height:1.85}
    .cta-btn{padding:13px 32px;font-size:0.95rem}
}

@@media(prefers-reduced-motion:reduce){
    .card,.cta-btn,.arr{animation:none!important}
}
</style>
</head>
<body>

<!-- ── background video ───────────────────────── -->
<video
    class="bg-video"
    src="/images/fall.webm"
    autoplay
    loop
    muted
    playsinline
    aria-hidden="true">
</video>

<!-- ── subtle directional overlay ────────────── -->
<div class="bg-overlay" aria-hidden="true"></div>

<!-- ── content ───────────────────────────────── -->
<div class="page">
    <div class="card" role="main">

        <!-- avatar circle: top-right of card (RTL: right side) -->
        <div class="avatar-wrap">
            <div class="avatar-ring">
                <img src="/images/perseneli.jpg" alt="profile photo" />
            </div>
        </div>

        <!-- bio injected via JS (unicode escapes = no encoding risk) -->
        <div class="bio" id="bio-text"></div>

        <!-- CTA button -->
        <div class="cta-wrap">
            <a href="/Home/Index" class="cta-btn" id="cta-link">
                <i class="arr" aria-hidden="true">&larr;</i>
                <span id="cta-label"></span>
            </a>
        </div>

    </div>
</div>

<script>
(function () {
    var bio = document.getElementById('bio-text');
    var p1  = document.createElement('p');
    var p2  = document.createElement('p');
    var br  = document.createElement('br');

    p1.innerHTML =
        '\u062F\u0627\u0646\u0634\u200C\u0622\u0645\u0648\u062E\u062A\u0647 \u0645\u0647\u0646\u062F\u0633\u06CC '
        + '\u0635\u0646\u0627\u06CC\u0639 \u0628\u0627 \u062A\u062C\u0631\u0628\u0647 \u0639\u0645\u0644\u06CC '
        + '\u062F\u0631 \u062A\u0648\u0633\u0639\u0647 \u0627\u067E\u0644\u06CC\u06A9\u0634\u0646\u200C\u0647\u0627\u06CC '
        + '<strong>.NET</strong> '
        + '\u0648 \u0645\u0628\u0627\u0646\u06CC \u062A\u0648\u0633\u0639\u0647 '
        + '\u0631\u0627\u0628\u0637 \u06A9\u0627\u0631\u0628\u0631\u06CC <strong>(UI)</strong> '
        + '\u0647\u0645\u0631\u0627\u0647 \u0628\u0627 \u0633\u0627\u0628\u0642\u0647 '
        + '\u0627\u062B\u0628\u0627\u062A\u200C\u0634\u062F\u0647 \u062F\u0631 \u062A\u062F\u0631\u06CC\u0633 '
        + '<strong>C#</strong> '
        + '\u0628\u0647 \u0628\u06CC\u0634 \u0627\u0632 <strong>60 \u0641\u0631\u0627\u06AF\u06CC\u0631</strong>.';

    p2.innerHTML =
        '\u062F\u0631 \u062D\u0627\u0644 \u062D\u0627\u0636\u0631 \u0628\u0647 '
        + '\u062F\u0646\u0628\u0627\u0644 \u0641\u0631\u0635\u062A '
        + '\u06A9\u0627\u0631\u0622\u0645\u0648\u0632\u06CC\u200C\u0627\u06CC '
        + '\u0647\u0633\u062A\u0645 \u06A9\u0647 \u0628\u0627 \u067E\u06CC\u0634\u06CC\u0646\u0647 '
        + '\u062A\u062D\u0635\u06CC\u0644\u06CC\u200C\u0627\u0645 \u0647\u0645\u0631\u0627\u0633\u062A\u0627 \u0628\u0627\u0634\u062F '
        + '\u0648 \u0627\u0645\u06A9\u0627\u0646 \u0647\u0645\u06A9\u0627\u0631\u06CC \u0628\u0627 \u06CC\u06A9 '
        + '<strong>\u062A\u06CC\u0645 \u062D\u0631\u0641\u0647\u200C\u0627\u06CC</strong>\u060C '
        + '\u0645\u0634\u0627\u0631\u06A9\u062A \u062F\u0631 \u067E\u0631\u0648\u0698\u0647\u200C\u0647\u0627\u06CC '
        + '\u0648\u0627\u0642\u0639\u06CC\u060C \u0648 \u0627\u0631\u062A\u0642\u0627\u06CC \u0645\u0633\u062A\u0645\u0631 '
        + '\u062A\u062E\u0635\u0635 \u0641\u0646\u06CC\u200C\u0627\u0645 \u0631\u0627 \u0641\u0631\u0627\u0647\u0645 \u06A9\u0646\u062F.';

    bio.appendChild(p1);
    bio.appendChild(br);
    bio.appendChild(p2);

    document.getElementById('cta-label').textContent =
        '\u0646\u0645\u0648\u0646\u0647 \u06A9\u0627\u0631';
}());
</script>

</body>
</html>
