@model CreateServiceRequestViewModel
@{ ViewData["Title"] = "ثبت درخواست"; }
@section Styles {
<style>
.create-page { padding:var(--space-10) 0 var(--space-20); }
/* Wizard */
.wizard-header { text-align:center; margin-bottom:var(--space-10); }
.wizard-header__title { font-size:clamp(1.75rem,3vw,2.5rem); font-weight:var(--font-black); letter-spacing:-.03em; margin-bottom:var(--space-2); }
.wizard-header__sub { color:var(--color-text-secondary); font-size:var(--text-base); }
/* Steps track */
.steps-track { display:flex; align-items:center; justify-content:center; gap:0; margin-bottom:var(--space-10); }
.step-node { display:flex; flex-direction:column; align-items:center; gap:var(--space-2); flex:1; max-width:140px; }
.step-circle {
    width:44px; height:44px; border-radius:50%;
    background:var(--gray-100); border:2.5px solid var(--gray-200);
    display:flex; align-items:center; justify-content:center;
    font-size:var(--text-sm); font-weight:var(--font-bold); color:var(--gray-500);
    transition:all .3s var(--ease-spring); position:relative; z-index:1;
}
.step-node.active  .step-circle { background:var(--gradient-primary); border-color:transparent; color:white; transform:scale(1.15); box-shadow:var(--shadow-brand); }
.step-node.done    .step-circle { background:var(--success-500); border-color:transparent; color:white; }
.step-label { font-size:var(--text-xs); font-weight:var(--font-semibold); color:var(--color-text-tertiary); text-align:center; }
.step-node.active  .step-label { color:var(--primary-700); }
.step-node.done    .step-label { color:var(--success-600); }
.step-connector { flex:1; height:2px; background:var(--gray-200); margin:0; position:relative; top:-16px; transition:background .3s; }
.step-connector.done { background:var(--success-400); }
/* Wizard card */
.wizard-card { background:white; border:1px solid var(--color-border-subtle); border-radius:var(--radius-3xl); padding:var(--space-10); box-shadow:var(--shadow-xl); }
/* Step panels */
.step-panel { display:none; animation:fadeInUp .35s var(--ease-out) both; }
.step-panel.active { display:block; }
.step-panel__title { font-size:var(--text-2xl); font-weight:var(--font-bold); margin-bottom:var(--space-2); }
.step-panel__sub { color:var(--color-text-secondary); font-size:var(--text-sm); margin-bottom:var(--space-8); }
/* Budget slider */
.budget-slider { -webkit-appearance:none; width:100%; height:6px; border-radius:var(--radius-full); background:var(--gray-200); outline:none; cursor:pointer; }
.budget-slider::-webkit-slider-thumb { -webkit-appearance:none; width:22px; height:22px; border-radius:50%; background:var(--gradient-primary); cursor:pointer; box-shadow:var(--shadow-brand); }
.budget-slider::-moz-range-thumb { width:22px; height:22px; border-radius:50%; background:var(--primary-600); border:none; cursor:pointer; }
/* Image upload */
.upload-zone { border:2px dashed var(--color-border); border-radius:var(--radius-2xl); padding:var(--space-8); text-align:center; cursor:pointer; transition:all .2s; background:var(--gray-50); }
.upload-zone:hover { border-color:var(--primary-400); background:var(--primary-50); }
.img-preview-grid { display:flex; flex-wrap:wrap; gap:var(--space-3); margin-top:var(--space-4); }
.img-thumb { position:relative; width:100px; height:100px; border-radius:var(--radius-xl); overflow:hidden; border:2px solid var(--color-border); }
.img-thumb img { width:100%; height:100%; object-fit:cover; }
.img-thumb__rm { position:absolute; top:4px; right:4px; width:22px; height:22px; border-radius:50%; background:var(--error-600); color:white; border:none; cursor:pointer; font-size:.8rem; display:flex; align-items:center; justify-content:center; }
/* Wizard footer */
.wizard-footer { display:flex; align-items:center; justify-content:space-between; padding-top:var(--space-8); border-top:1px solid var(--color-border-subtle); margin-top:var(--space-8); }
/* Owner toggle */
.toggle-row { display:flex; align-items:center; justify-content:space-between; background:var(--gray-50); padding:var(--space-4) var(--space-5); border-radius:var(--radius-xl); }
.toggle-switch { position:relative; width:44px; height:24px; }
.toggle-switch input { opacity:0; width:0; height:0; position:absolute; }
.toggle-track { position:absolute; inset:0; background:var(--gray-200); border-radius:var(--radius-full); transition:background .2s; }
.toggle-switch input:checked + .toggle-track { background:var(--primary-500); }
.toggle-knob { position:absolute; top:2px; right:2px; width:20px; height:20px; border-radius:50%; background:white; box-shadow:var(--shadow-sm); transition:transform .2s; }
.toggle-switch input:checked ~ .toggle-knob { transform:translateX(-20px); }
</style>
}

<div class="create-page">
    <div class="hs-container">
        <div style="max-width:800px;margin:0 auto;">
            <div class="wizard-header" data-reveal="up">
                <div class="section-label" style="display:inline-flex;margin-bottom:var(--space-4);">درخواست خدمت</div>
                <h1 class="wizard-header__title">ثبت درخواست خدمت</h1>
                <p class="wizard-header__sub">در چهار مرحله ساده درخواست خود را ثبت کنید</p>
            </div>

            @* Steps track *@
            <div class="steps-track" id="stepsTrack">
                @{ var stepLabels = new[]{"انتخاب خدمت","جزئیات","موقعیت","بودجه"}; }
                @for (int i = 0; i < 4; i++)
                {
                    <div class="step-node @(i==0?"active":"")" data-step-node="@(i+1)">
                        <div class="step-circle">
                            <span class="step-num">@(i+1)</span>
                            <span class="step-check" style="display:none;">✓</span>
                        </div>
                        <div class="step-label">@stepLabels[i]</div>
                    </div>
                    @if (i < 3) { <div class="step-connector" data-connector="@(i+1)"></div> }
                }
            </div>

            <div class="wizard-card" data-reveal="up">
                <form asp-action="Create" method="post" enctype="multipart/form-data" id="wizardForm" data-loading="bar">
                    <div asp-validation-summary="All" class="alert alert--error" style="margin-bottom:var(--space-6);"></div>

                    @* Step 1 *@
                    <div class="step-panel active" data-panel="1">
                        <div class="step-panel__title">🛠️ چه خدمتی نیاز دارید؟</div>
                        <p class="step-panel__sub">دسته‌بندی خدمت مورد نیاز خود را انتخاب کنید.</p>
                        <div class="row g-4">
                            <div class="col-md-8">
                                <div class="form-group">
                                    <label asp-for="CategoryId" class="form-label form-label--required">دسته‌بندی خدمت</label>
                                    <select asp-for="CategoryId" class="form-control"
                                            asp-items="@(new SelectList(Model.Categories,"Id","Name"))">
                                        <option value="">انتخاب کنید…</option>
                                    </select>
                                    <span asp-validation-for="CategoryId" class="form-error"></span>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label asp-for="ServiceId" class="form-label">خدمت خاص (اختیاری)</label>
                                    <input asp-for="ServiceId" type="number" class="form-control" placeholder="شناسه خدمت" />
                                </div>
                            </div>
                        </div>
                        <div class="alert alert--info" style="margin-top:var(--space-5);">
                            <span class="alert__icon">💡</span>
                            <div class="alert__content">اگر خدمت خاصی مدنظر دارید شناسه را وارد کنید، در غیر این صورت خالی بگذارید.</div>
                        </div>
                    </div>

                    @* Step 2 *@
                    <div class="step-panel" data-panel="2">
                        <div class="step-panel__title">📋 جزئیات درخواست</div>
                        <p class="step-panel__sub">هرچه دقیق‌تر توضیح دهید، پیشنهادهای بهتری می‌گیرید.</p>
                        <div class="form-group" style="margin-bottom:var(--space-5);">
                            <label asp-for="Title" class="form-label form-label--required">عنوان درخواست</label>
                            <input asp-for="Title" class="form-control" placeholder="مثلاً: تعمیر نشتی لوله زیر سینک آشپزخانه" data-maxlength="100" />
                            <span asp-validation-for="Title" class="form-error"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="Description" class="form-label form-label--required">توضیحات کامل</label>
                            <textarea asp-for="Description" class="form-control" rows="6"
                                      placeholder="مشکل را توضیح دهید، زمان مناسب، جزئیات محیط…" data-maxlength="1000"></textarea>
                            <span asp-validation-for="Description" class="form-error"></span>
                        </div>
                    </div>

                    @* Step 3 *@
                    <div class="step-panel" data-panel="3">
                        <div class="step-panel__title">📍 موقعیت و زمان</div>
                        <p class="step-panel__sub">محل و زمان انجام کار را مشخص کنید.</p>
                        <div class="form-group" style="margin-bottom:var(--space-4);">
                            <label asp-for="Address" class="form-label">آدرس</label>
                            <input asp-for="Address" class="form-control" placeholder="خیابان، کوچه، پلاک…" />
                        </div>
                        <div class="row g-4" style="margin-bottom:var(--space-4);">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label asp-for="City" class="form-label form-label--required">شهر</label>
                                    <input asp-for="City" class="form-control" placeholder="تهران" />
                                    <span asp-validation-for="City" class="form-error"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label asp-for="ZipCode" class="form-label">کد پستی</label>
                                    <input asp-for="ZipCode" class="form-control" placeholder="۱۰ رقم" maxlength="10" />
                                </div>
                            </div>
                        </div>
                        <div class="row g-4" style="margin-bottom:var(--space-4);">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label asp-for="Urgency" class="form-label">میزان فوریت</label>
                                    <select asp-for="Urgency" class="form-control" asp-items="Html.GetEnumSelectList<UrgencyLevel>()"></select>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label asp-for="PreferredDate" class="form-label">تاریخ ترجیحی</label>
                                    <input asp-for="PreferredDate" type="date" class="form-control" />
                                </div>
                            </div>
                        </div>
                        <div class="toggle-row">
                            <div>
                                <div style="font-weight:var(--font-semibold);font-size:var(--text-sm);">مالک ملک هستید؟</div>
                                <div style="font-size:var(--text-xs);color:var(--color-text-tertiary);">این اطلاعات به کارشناسان کمک می‌کند</div>
                            </div>
                            <label class="toggle-switch" style="cursor:pointer;">
                                <input asp-for="IsHomeOwner" type="checkbox" checked />
                                <div class="toggle-track"></div>
                                <div class="toggle-knob"></div>
                            </label>
                        </div>
                    </div>

                    @* Step 4 *@
                    <div class="step-panel" data-panel="4">
                        <div class="step-panel__title">💰 بودجه و تصاویر</div>
                        <p class="step-panel__sub">بودجه تقریبی خود را تعیین کنید و در صورت نیاز تصویر اضافه کنید.</p>
                        <div class="row g-4" style="margin-bottom:var(--space-6);">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label asp-for="BudgetMin" class="form-label">حداقل بودجه (تومان)</label>
                                    <input asp-for="BudgetMin" type="number" class="form-control" placeholder="۱۰۰,۰۰۰" step="10000" id="budgetMinInput" />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label asp-for="BudgetMax" class="form-label">حداکثر بودجه (تومان)</label>
                                    <input asp-for="BudgetMax" type="number" class="form-control" placeholder="۵۰۰,۰۰۰" step="10000" id="budgetMaxInput" />
                                </div>
                            </div>
                        </div>
                        <div style="margin-bottom:var(--space-6);">
                            <div style="display:flex;justify-content:space-between;margin-bottom:var(--space-3);">
                                <span style="font-size:var(--text-xs);color:var(--color-text-tertiary);">۰</span>
                                <span id="budgetDisplay" style="font-size:var(--text-sm);font-weight:var(--font-semibold);color:var(--primary-700);">بودجه خود را مشخص کنید</span>
                                <span style="font-size:var(--text-xs);color:var(--color-text-tertiary);">+۱۰M</span>
                            </div>
                            <input type="range" class="budget-slider" min="0" max="10000000" step="100000" value="0" id="budgetSlider" />
                        </div>
                        <div class="form-group">
                            <label class="form-label">تصاویر (اختیاری، حداکثر ۵)</label>
                            <div class="upload-zone" onclick="document.getElementById('imageInput').click()">
                                <div style="font-size:2.5rem;margin-bottom:var(--space-3);">📸</div>
                                <div style="font-weight:var(--font-semibold);margin-bottom:var(--space-1);">برای آپلود کلیک کنید</div>
                                <div style="font-size:var(--text-xs);color:var(--color-text-tertiary);">تصویر از محل یا مشکل — JPG, PNG</div>
                            </div>
                            <input asp-for="Images" type="file" id="imageInput" multiple accept="image/*" style="display:none;" />
                            <div id="imgPreviewGrid" class="img-preview-grid"></div>
                        </div>
                    </div>

                    @* Footer navigation *@
                    <div class="wizard-footer">
                        <button type="button" id="btnPrev" class="btn btn-secondary" style="display:none;">← مرحله قبل</button>
                        <div style="flex:1;"></div>
                        <a asp-controller="Home" asp-action="Index" class="btn btn-ghost">انصراف</a>
                        <button type="button" id="btnNext" class="btn btn-primary">مرحله بعد ←</button>
                        <button type="submit" id="btnSubmit" class="btn btn-primary" style="display:none;">✓ ثبت درخواست</button>
                    </div>
                </form>
                <div style="text-align:center;margin-top:var(--space-4);">
                    <span id="stepInfo" style="font-size:var(--text-xs);color:var(--color-text-tertiary);">مرحله ۱ از ۴</span>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
    <script>
    (function(){
        var cur=1, tot=4;
        var persianNums=['۱','۲','۳','۴'];
        function render(){
            document.querySelectorAll('.step-panel').forEach(function(p){ p.classList.toggle('active',+p.dataset.panel===cur); });
            document.querySelectorAll('.step-node').forEach(function(n,i){
                n.classList.toggle('active',i+1===cur);
                n.classList.toggle('done',i+1<cur);
                n.querySelector('.step-num').style.display=i+1<=cur?'':'none';
                n.querySelector('.step-check').style.display=i+1<cur?'':'none';
            });
            document.querySelectorAll('.step-connector').forEach(function(c,i){
                c.classList.toggle('done',i+1<cur);
            });
            document.getElementById('btnPrev').style.display=cur===1?'none':'';
            document.getElementById('btnNext').style.display=cur===tot?'none':'';
            document.getElementById('btnSubmit').style.display=cur===tot?'':'none';
            document.getElementById('stepInfo').textContent='مرحله '+persianNums[cur-1]+' از '+persianNums[tot-1];
            window.scrollTo({top:0,behavior:'smooth'});
        }
        document.getElementById('btnNext').addEventListener('click',function(){ if(cur<tot){cur++;render();} });
        document.getElementById('btnPrev').addEventListener('click',function(){ if(cur>1){cur--;render();} });

        // Budget slider
        var sl=document.getElementById('budgetSlider'), disp=document.getElementById('budgetDisplay'), maxInp=document.getElementById('budgetMaxInput');
        sl.addEventListener('input',function(){ maxInp.value=sl.value; disp.textContent=sl.value>0?'تا '+parseInt(sl.value).toLocaleString()+' تومان':'بودجه خود را مشخص کنید'; });
        maxInp&&maxInp.addEventListener('input',function(){ sl.value=Math.min(maxInp.value||0,10000000); sl.dispatchEvent(new Event('input')); });

        // Image previews
        var imgInput=document.getElementById('imageInput'), grid=document.getElementById('imgPreviewGrid'), files=[];
        imgInput.addEventListener('change',function(){ files=Array.from(this.files).slice(0,5); renderPreviews(); });
        function renderPreviews(){
            grid.innerHTML='';
            files.forEach(function(f,i){
                var r=new FileReader(); r.onload=function(e){
                    var d=document.createElement('div'); d.className='img-thumb';
                    d.innerHTML='<img src="'+e.target.result+'"><button type="button" class="img-thumb__rm" onclick="rmImg('+i+')">✕</button>';
                    grid.appendChild(d);
                }; r.readAsDataURL(f);
            });
        }
        window.rmImg=function(i){ files.splice(i,1); renderPreviews(); var dt=new DataTransfer(); files.forEach(function(f){dt.items.add(f);}); imgInput.files=dt.files; };
        render();
    })();
    </script>
}
