@using HomeServices.Domain.Enums
@{
    ViewData["Title"] = "داشبورد کارشناس";
    var profile          = (ExpertProfileDto)ViewBag.Profile;
    var openProposals    = (int)ViewBag.OpenProposalsCount;
    var acceptedProposals= (int)ViewBag.AcceptedProposalsCount;
    var activeOrders     = (int)ViewBag.ActiveOrdersCount;
    var completedOrders  = (int)ViewBag.CompletedOrdersCount;
    var pendingPayout    = (decimal)ViewBag.PendingPayout;
    var totalEarnings    = (decimal)(ViewBag.TotalEarnings ?? 0);
    var jobs             = (IReadOnlyList<OrderDto>)ViewBag.ActiveOrders;
    var recentProposals  = ViewBag.RecentProposals as IReadOnlyList<ProposalDto> ?? Array.Empty<ProposalDto>();
    var totalProposals   = openProposals + acceptedProposals;
    var winRate          = totalProposals > 0 ? (int)(acceptedProposals * 100.0 / totalProposals) : 0;
    var avgResponse      = profile.ResponseTimeMinutes ?? 45;
}
@section Styles {
<style>
.edash { padding:var(--space-8) 0 var(--space-20); }
.edash-welcome {
    background:linear-gradient(135deg,var(--primary-700) 0%,var(--primary-500) 100%);
    border-radius:var(--radius-3xl); padding:var(--space-10);
    color:white; margin-bottom:var(--space-8);
    position:relative; overflow:hidden;
    display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:var(--space-5);
}
.edash-welcome::before { content:'⚡'; position:absolute; right:-20px; top:-30px; font-size:12rem; opacity:.06; pointer-events:none; }
.edash-welcome__name { font-size:clamp(1.5rem,3vw,2.25rem); font-weight:var(--font-black); letter-spacing:-.03em; color:white; margin-bottom:var(--space-2); }
.edash-welcome__sub { font-size:var(--text-sm); opacity:.8; }
.edash-welcome__actions { display:flex; gap:var(--space-3); flex-wrap:wrap; }
/* Stats */
.estats-grid { display:grid; grid-template-columns:repeat(4,1fr); gap:var(--space-4); margin-bottom:var(--space-8); }
@@media(max-width:1024px) { .estats-grid { grid-template-columns:repeat(2,1fr); } }
.stat-tile { background:white; border:1px solid var(--color-border-subtle); border-radius:var(--radius-2xl); padding:var(--space-6); transition:all .25s; text-decoration:none; display:block; position:relative; overflow:hidden; }
.stat-tile::after { content:''; position:absolute; bottom:0; right:0; left:0; height:3px; background:var(--tile-color,var(--primary-400)); opacity:0; transition:opacity .25s; }
.stat-tile:hover { box-shadow:var(--shadow-lg); transform:translateY(-4px); }
.stat-tile:hover::after { opacity:1; }
.stat-tile__icon { width:44px; height:44px; border-radius:var(--radius-xl); display:flex; align-items:center; justify-content:center; font-size:1.25rem; margin-bottom:var(--space-4); }
.stat-tile__val { font-size:var(--text-4xl); font-weight:var(--font-black); letter-spacing:-.04em; line-height:1; margin-bottom:var(--space-1); }
.stat-tile__lbl { font-size:var(--text-sm); font-weight:var(--font-medium); color:var(--color-text-secondary); }
.stat-tile__sub { font-size:var(--text-xs); color:var(--color-text-tertiary); margin-top:var(--space-1); }
/* Dashboard card */
.dash-card { background:white; border:1px solid var(--color-border-subtle); border-radius:var(--radius-2xl); padding:var(--space-7); margin-bottom:var(--space-5); }
.dash-card__header { display:flex; align-items:center; justify-content:space-between; margin-bottom:var(--space-5); }
.dash-card__title { font-size:var(--text-base); font-weight:var(--font-bold); }
/* Earnings card */
.earnings-card {
    background:linear-gradient(135deg,var(--warning-600) 0%,var(--accent-500) 100%);
    border-radius:var(--radius-2xl); padding:var(--space-7);
    color:white; margin-bottom:var(--space-5); position:relative; overflow:hidden;
}
.earnings-card::before { content:'💰'; position:absolute; bottom:-20px; left:-10px; font-size:8rem; opacity:.1; pointer-events:none; }
.earnings-card__inner { position:relative; z-index:1; display:grid; grid-template-columns:1fr 1fr; gap:var(--space-6); }
.earnings-val { font-size:clamp(1.5rem,3vw,2.5rem); font-weight:var(--font-black); letter-spacing:-.04em; line-height:1.1; }
.earnings-lbl { font-size:var(--text-xs); opacity:.8; margin-top:var(--space-1); }
/* Bar chart */
.bar-chart { display:flex; align-items:flex-end; gap:var(--space-2); height:120px; }
.bar-col { flex:1; display:flex; flex-direction:column; align-items:center; gap:var(--space-1); height:100%; }
.bar-col__fill { width:100%; border-radius:var(--radius-md) var(--radius-md) 0 0; min-height:4px; }
.bar-col__label { font-size:9px; color:var(--color-text-tertiary); }
/* Metric pill */
.metric-pill { display:flex; align-items:center; justify-content:space-between; padding:var(--space-4); background:var(--gray-50); border-radius:var(--radius-xl); margin-bottom:var(--space-3); }
.metric-pill:last-child { margin-bottom:0; }
.metric-pill__label { font-size:var(--text-sm); color:var(--color-text-secondary); }
.metric-pill__val { font-size:var(--text-xl); font-weight:var(--font-extrabold); color:var(--gray-900); }
/* Job row */
.job-row { display:flex; align-items:center; gap:var(--space-4); padding:var(--space-4) 0; border-bottom:1px solid var(--color-border-subtle); }
.job-row:last-child { border-bottom:none; }
.job-row__body { flex:1; min-width:0; }
.job-row__title { font-size:var(--text-sm); font-weight:var(--font-semibold); white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
.job-row__meta { font-size:var(--text-xs); color:var(--color-text-tertiary); margin-top:2px; }
/* Circular progress */
.circle-prog { position:relative; width:100px; height:100px; flex-shrink:0; }
.circle-prog svg { transform:rotate(-90deg); }
.circle-prog__val { position:absolute; inset:0; display:flex; align-items:center; justify-content:center; font-size:var(--text-xl); font-weight:var(--font-black); color:var(--primary-700); }
</style>
}

<div class="edash">
    <div class="hs-container">

        @* Welcome *@
        <div class="edash-welcome" data-reveal="up">
            <div>
                <div style="font-size:var(--text-xs);text-transform:uppercase;letter-spacing:.1em;opacity:.7;margin-bottom:var(--space-2);">داشبورد کارشناس</div>
                <div class="edash-welcome__name">سلام، @profile.BusinessName 🎯</div>
                <div class="edash-welcome__sub">عملکرد و درآمد خود را از اینجا پیگیری کنید.</div>
            </div>
            <div class="edash-welcome__actions">
                <a asp-action="OpenRequests" class="btn btn-xl" style="background:white;color:var(--primary-700);font-weight:var(--font-bold);">🔍 درخواست‌های باز</a>
                <a asp-action="Profile"      class="btn btn-xl" style="background:rgba(255,255,255,.15);color:white;border:1.5px solid rgba(255,255,255,.35);">⚙ پروفایل</a>
            </div>
        </div>

        @if (!profile.IsApproved)
        {
            <div class="alert alert--warning" style="margin-bottom:var(--space-6);" data-reveal="up">
                <span class="alert__icon">⏳</span>
                <div class="alert__content">
                    <div class="alert__title">پروفایل در انتظار تأیید مدیر است</div>
                    تا قبل از تأیید، درخواست‌ها را می‌بینید اما نمی‌توانید سفارش دریافت کنید.
                </div>
            </div>
        }

        @* Stats *@
        <div class="estats-grid" data-stagger>
            <a asp-action="MyProposals" class="stat-tile" style="--tile-color:var(--warning-400);" data-reveal="up">
                <div class="stat-tile__icon" style="background:var(--warning-100);">💬</div>
                <div class="stat-tile__val" data-counter="@openProposals">@openProposals</div>
                <div class="stat-tile__lbl">پیشنهاد در انتظار</div>
                <div class="stat-tile__sub">نیاز به پاسخ</div>
            </a>
            <div class="stat-tile" style="--tile-color:var(--success-400);" data-reveal="up">
                <div class="stat-tile__icon" style="background:var(--success-100);">✅</div>
                <div class="stat-tile__val" data-counter="@acceptedProposals">@acceptedProposals</div>
                <div class="stat-tile__lbl">پیشنهاد پذیرفته</div>
                <div class="stat-tile__sub">نرخ برد: @winRate٪</div>
            </div>
            <a asp-action="MyJobs" class="stat-tile" style="--tile-color:var(--info-400);" data-reveal="up">
                <div class="stat-tile__icon" style="background:var(--info-100);">🔨</div>
                <div class="stat-tile__val" data-counter="@activeOrders">@activeOrders</div>
                <div class="stat-tile__lbl">سفارش فعال</div>
                <div class="stat-tile__sub">در حال اجرا</div>
            </a>
            <div class="stat-tile" style="--tile-color:var(--primary-400);" data-reveal="up">
                <div class="stat-tile__icon" style="background:var(--primary-100);">🏆</div>
                <div class="stat-tile__val" data-counter="@completedOrders">@completedOrders</div>
                <div class="stat-tile__lbl">تکمیل‌شده</div>
                <div class="stat-tile__sub">موفقیت‌آمیز</div>
            </div>
        </div>

        <div class="row g-5" style="--bs-gutter-x:1.5rem">
            <div class="col-lg-8">

                @* Earnings *@
                <div class="earnings-card" data-reveal="up">
                    <div style="font-size:var(--text-xs);text-transform:uppercase;letter-spacing:.08em;opacity:.8;margin-bottom:var(--space-5);">💰 درآمد و مالی</div>
                    <div class="earnings-card__inner">
                        <div>
                            <div class="earnings-val" data-counter="@((int)totalEarnings)">@totalEarnings.ToString("N0")</div>
                            <div class="earnings-lbl">درآمد کل (تومان)</div>
                        </div>
                        <div>
                            <div class="earnings-val">@pendingPayout.ToString("N0")</div>
                            <div class="earnings-lbl">در انتظار واریز (تومان)</div>
                        </div>
                    </div>
                </div>

                @* 6-month chart *@
                <div class="dash-card" data-reveal="up">
                    <div class="dash-card__header"><span class="dash-card__title">📊 روند ۶ ماه اخیر</span></div>
                    @{
                        var months  = new[]{"فر","ارد","خرد","تیر","مرد","شهر"};
                        var heights = new[]{40,55,48,70,80,100};
                    }
                    <div class="bar-chart" id="earningsChart">
                        @for (int i=0;i<6;i++)
                        {
                            <div class="bar-col">
                                <div class="bar-col__fill" data-target-height="@heights[i]"
                                     style="height:0;background:@(i==5?"linear-gradient(180deg,var(--primary-500),var(--accent-500))":"var(--primary-100)");border-radius:var(--radius-md) var(--radius-md) 0 0;"></div>
                                <div class="bar-col__label">@months[i]</div>
                            </div>
                        }
                    </div>
                </div>

                @* Active Jobs *@
                <div class="dash-card" data-reveal="up">
                    <div class="dash-card__header">
                        <span class="dash-card__title">🔨 سفارش‌های فعال</span>
                        <a asp-action="MyJobs" class="btn btn-secondary btn-sm">همه ←</a>
                    </div>
                    @if (!jobs.Any())
                    {
                        <div class="empty-state" style="padding:var(--space-10);">
                            <div class="empty-state__icon">📦</div>
                            <div class="empty-state__title">سفارش فعالی ندارید</div>
                            <a asp-action="OpenRequests" class="btn btn-primary">مشاهده درخواست‌های باز</a>
                        </div>
                    }
                    else
                    {
                        @foreach (var order in jobs)
                        {
                            <div class="job-row">
                                <div style="width:40px;height:40px;border-radius:var(--radius-xl);background:var(--primary-100);display:flex;align-items:center;justify-content:center;flex-shrink:0;">🔨</div>
                                <div class="job-row__body">
                                    <a asp-controller="Orders" asp-action="Details" asp-route-id="@order.Id" class="job-row__title" style="text-decoration:none;color:var(--gray-900);">@order.RequestTitle</a>
                                    <div class="job-row__meta">@order.OrderNumber · @order.TotalAmount.ToString("N0") ت</div>
                                </div>
                                <div style="display:flex;align-items:center;gap:var(--space-2);">
                                    <span class="badge badge--@(order.Status.ToString().ToLower())">@order.Status.ToDisplay()</span>
                                    <a asp-controller="Orders" asp-action="Details" asp-route-id="@order.Id" class="btn btn-primary btn-sm">مشاهده</a>
                                </div>
                            </div>
                        }
                    }
                </div>

                @* Recent Proposals Table *@
                @if (recentProposals.Any())
                {
                    <div class="dash-card" data-reveal="up">
                        <div class="dash-card__header">
                            <span class="dash-card__title">💬 پیشنهادهای اخیر</span>
                            <a asp-action="MyProposals" class="btn btn-secondary btn-sm">همه ←</a>
                        </div>
                        <div class="hs-table-wrap">
                            <table class="hs-table">
                                <thead>
                                    <tr><th>درخواست</th><th>قیمت</th><th>وضعیت</th><th>تاریخ</th><th></th></tr>
                                </thead>
                                <tbody>
                                    @foreach (var p in recentProposals.Take(5))
                                    {
                                        <tr>
                                            <td style="max-width:200px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">
                                                <a asp-controller="ServiceRequests" asp-action="Details" asp-route-id="@p.RequestId" style="text-decoration:none;font-weight:var(--font-semibold);">
                                                    @(p.RequestTitle?.Length>30?p.RequestTitle.Substring(0,30)+"…":p.RequestTitle)
                                                </a>
                                            </td>
                                            <td><span style="font-weight:var(--font-semibold);color:var(--primary-700);">@p.Price.ToString("N0") ت</span></td>
                                            <td><span class="badge badge--@(p.Status.ToString().ToLower())">@p.Status.ToDisplay()</span></td>
                                            <td style="color:var(--color-text-tertiary);font-size:var(--text-xs);">@p.CreatedAt.ToPersianDate()</td>
                                            <td><a asp-controller="ServiceRequests" asp-action="Details" asp-route-id="@p.RequestId" class="btn btn-secondary btn-sm">جزئیات</a></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                }
            </div>

            <div class="col-lg-4">
                @* Profile card *@
                <div class="dash-card" data-reveal="left">
                    <div style="text-align:center;margin-bottom:var(--space-5);">
                        <div style="width:72px;height:72px;border-radius:50%;background:var(--gradient-primary);color:white;display:flex;align-items:center;justify-content:center;font-size:2rem;font-weight:var(--font-black);margin:0 auto var(--space-3);">
                            @(profile.BusinessName.FirstOrDefault())
                        </div>
                        <div style="font-size:var(--text-lg);font-weight:var(--font-bold);">@profile.BusinessName</div>
                        @if (profile.RatingAverage > 0)
                        {
                            <div style="display:flex;justify-content:center;gap:2px;margin:var(--space-2) 0;">
                                @for (int i=1;i<=5;i++) { <span style="color:@(i<=Math.Round(profile.RatingAverage)?"var(--warning-500)":"var(--gray-200)");">★</span> }
                            </div>
                            <div style="font-size:var(--text-sm);color:var(--color-text-secondary);">@profile.RatingAverage.ToString("0.0") از @profile.ReviewCount نظر</div>
                        }
                    </div>
                    <div style="display:flex;flex-direction:column;gap:var(--space-2);font-size:var(--text-sm);margin-bottom:var(--space-5);">
                        <div style="display:flex;justify-content:space-between;"><span style="color:var(--color-text-secondary);">📍 شهر</span><span style="font-weight:var(--font-semibold);">@(profile.City ?? "—")</span></div>
                        <div style="display:flex;justify-content:space-between;"><span style="color:var(--color-text-secondary);">✅ پروژه</span><span style="font-weight:var(--font-semibold);">@profile.JobsCompleted</span></div>
                        <div style="display:flex;justify-content:space-between;"><span style="color:var(--color-text-secondary);">⏱ پاسخ</span><span style="font-weight:var(--font-semibold);">@avgResponse دقیقه</span></div>
                    </div>
                    <a asp-action="Profile" class="btn btn-secondary btn-block">ویرایش پروفایل</a>
                </div>

                @* Metrics *@
                <div class="dash-card" data-reveal="left">
                    <div class="dash-card__header"><span class="dash-card__title">⚡ عملکرد</span></div>
                    <div class="metric-pill">
                        <span class="metric-pill__label">نرخ برد پیشنهادها</span>
                        <span class="metric-pill__val" style="color:var(--success-600);">@winRate٪</span>
                    </div>
                    <div class="metric-pill">
                        <span class="metric-pill__label">نرخ تکمیل</span>
                        <span class="metric-pill__val" style="color:var(--primary-700);">@(completedOrders>0?"98٪":"—")</span>
                    </div>
                    <div class="metric-pill">
                        <span class="metric-pill__label">زمان پاسخ</span>
                        <span class="metric-pill__val" style="color:@(avgResponse<60?"var(--success-600)":"var(--warning-600)");">@avgResponse دقیقه</span>
                    </div>

                    @* Circular success rate *@
                    @{
                        var rate    = completedOrders > 0 ? 98 : 0;
                        var radius  = 38;
                        var circum  = (int)(2 * Math.PI * radius);
                        var dash    = (int)(circum * rate / 100.0);
                    }
                    <div style="display:flex;align-items:center;justify-content:center;gap:var(--space-4);margin-top:var(--space-5);padding-top:var(--space-5);border-top:1px solid var(--color-border-subtle);">
                        <div class="circle-prog">
                            <svg width="100" height="100" viewBox="0 0 100 100">
                                <circle cx="50" cy="50" r="@radius" fill="none" stroke="var(--gray-100)" stroke-width="8"/>
                                <circle cx="50" cy="50" r="@radius" fill="none" stroke="var(--primary-500)" stroke-width="8"
                                        stroke-dasharray="@dash @(circum-dash)" stroke-linecap="round"/>
                            </svg>
                            <div class="circle-prog__val">@rate٪</div>
                        </div>
                        <div>
                            <div style="font-weight:var(--font-bold);font-size:var(--text-sm);">نرخ موفقیت</div>
                            <div style="font-size:var(--text-xs);color:var(--color-text-tertiary);">از @profile.JobsCompleted پروژه</div>
                        </div>
                    </div>
                </div>

                @* Tip *@
                <div style="background:linear-gradient(135deg,var(--primary-50),var(--accent-50));border:1px solid var(--color-border-subtle);border-radius:var(--radius-2xl);padding:var(--space-6);" data-reveal="left">
                    <div style="font-size:1.75rem;margin-bottom:var(--space-3);">💡</div>
                    <div style="font-size:var(--text-sm);font-weight:var(--font-bold);margin-bottom:var(--space-2);">نکته برای کارشناسان</div>
                    <p style="font-size:var(--text-sm);color:var(--color-text-secondary);line-height:1.6;margin:0 0 var(--space-4);">پاسخ سریع و پیشنهاد رقابتی، شانس پذیرش را تا ۳ برابر افزایش می‌دهد.</p>
                    <a asp-action="OpenRequests" class="btn btn-primary btn-sm btn-block">مشاهده درخواست‌ها ←</a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
(function(){
    var cols = document.querySelectorAll('#earningsChart .bar-col__fill');
    setTimeout(function(){
        cols.forEach(function(el){
            el.style.transition = 'height 1s var(--ease-out)';
            el.style.height = el.dataset.targetHeight + '%';
        });
    }, 400);
})();
</script>
}
