@using HomeServices.Domain.Enums
@model IReadOnlyList<ProposalDto>
@{
    ViewData["Title"] = "پیشنهادهای من";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h1 class="fw-800 mb-0">پیشنهادهای من</h1>
            <p class="text-muted mb-0">@Model.Count پیشنهاد ارسال‌شده</p>
        </div>
        <a asp-action="OpenRequests" class="btn btn-brand">+ ارسال پیشنهاد جدید</a>
    </div>

    @if (!Model.Any())
    {
        <div class="empty-state dashboard-card">
            <div class="icon">💬</div>
            <h5 class="fw-800">هنوز پیشنهادی ثبت نکرده‌اید</h5>
            <p class="text-muted">درخواست‌های باز را مرور کنید و اولین پیشنهاد خود را ارسال کنید.</p>
            <a asp-action="OpenRequests" class="btn btn-brand">مشاهده درخواست‌ها</a>
        </div>
    }
    else
    {
        <div class="vstack gap-3">
            @foreach (var p in Model)
            {
                <div class="dashboard-card">
                    <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap">
                        <div class="flex-grow-1">
                            <div class="d-flex align-items-center gap-2 mb-1 flex-wrap">
                                <a asp-controller="ServiceRequests" asp-action="Details" asp-route-id="@p.RequestId" class="fw-800 fs-5">@p.RequestTitle</a>
                                <span class="badge-soft @p.Status.ProposalStatusClass()">@p.Status.ToDisplay()</span>
                            </div>
                            <div class="d-flex gap-3 flex-wrap small text-muted">
                                <span class="text-secondary-brand fw-700">💰 @p.Price.ToString("N0") تومان</span>
                                @if (p.EstimatedDurationHours.HasValue) { <span>⏱️ @p.EstimatedDurationHours ساعت</span> }
                                @if (p.AvailableStartDate.HasValue) { <span>📅 @p.AvailableStartDate.Value.ToPersianDate()</span> }
                                <span>🕒 @p.CreatedAt.ToPersianDate()</span>
                            </div>
                            @if (!string.IsNullOrEmpty(p.Message))
                            {
                                <p class="text-muted small mb-0 mt-2 fst-italic">"@p.Message"</p>
                            }
                        </div>
                        <div class="d-flex flex-column gap-1">
                            @if (p.Status == ProposalStatus.Accepted)
                            {
                                <a asp-action="MyJobs" class="btn btn-sm btn-brand">سفارش‌های من</a>
                            }
                            else if (p.Status == ProposalStatus.Pending)
                            {
                                <form asp-action="WithdrawProposal" asp-route-id="@p.Id" method="post"
                                      onsubmit="return confirm('این پیشنهاد برگشت داده شود؟');">
                                    <button type="submit" class="btn btn-sm btn-outline-brand">برگشت پیشنهاد</button>
                                </form>
                            }
                            <a asp-controller="ServiceRequests" asp-action="Details" asp-route-id="@p.RequestId" class="btn btn-sm btn-link">جزئیات درخواست</a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
