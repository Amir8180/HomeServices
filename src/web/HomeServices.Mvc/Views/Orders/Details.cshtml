@model OrderDto
@using System.Security.Claims
@{
    ViewData["Title"] = $"سفارش {Model.OrderNumber}";
    var uid        = User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
    var isCustomer = Model.CustomerId.ToString() == uid;
    var isDone     = Model.Status == OrderStatus.Completed;

    var stages = new[]{
        new{St=OrderStatus.PendingPayment, Lbl="پرداخت",     Icon="credit-card"},
        new{St=OrderStatus.WaitingPaymentVerification, Lbl="تأیید پرداخت", Icon="check-circle"},
        new{St=OrderStatus.Paid,           Lbl="پرداخت شد",  Icon="check-circle"},
        new{St=OrderStatus.Scheduled,      Lbl="زمان‌بندی",  Icon="calendar"},
        new{St=OrderStatus.InProgress,     Lbl="در انجام",   Icon="tool"},
        new{St=OrderStatus.CompletionReview, Lbl="بررسی اتمام", Icon="clipboard"},
        new{St=OrderStatus.Completed,      Lbl="تکمیل",      Icon="check-all"},
    };
    var curIdx = Array.FindIndex(stages, s => s.St == Model.Status);
    if (curIdx < 0) curIdx = 0;
    // برای سفارش تکمیل‌شده، خود مرحلهٔ پایانی هم سبز (done) است؛ دیگر مرحلهٔ «فعلی»‌ای وجود ندارد.
    var isCompleted = Model.Status == OrderStatus.Completed;

    // Inline SVG helper (same patterns as Layout)
    Func<string, Microsoft.AspNetCore.Html.HtmlString> Svg = (paths) => new Microsoft.AspNetCore.Html.HtmlString(
        $"<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\" style=\"width:1em;height:1em;display:inline-block;vertical-align:-0.15em;flex-shrink:0;\">{paths}</svg>"
    );
    var icCheck      = "<polyline points=\"20 6 9 17 4 12\"/>";
    var icCheckCircle= "<path d=\"M22 11.08V12a10 10 0 11-5.93-9.14\"/><polyline points=\"22 4 12 14.01 9 11.01\"/>";
    var icCalendar   = "<rect x=\"3\" y=\"4\" width=\"18\" height=\"18\" rx=\"2\" ry=\"2\"/><line x1=\"16\" y1=\"2\" x2=\"16\" y2=\"6\"/><line x1=\"8\" y1=\"2\" x2=\"8\" y2=\"6\"/><line x1=\"3\" y1=\"10\" x2=\"21\" y2=\"10\"/>";
    var icCreditCard = "<rect x=\"1\" y=\"4\" width=\"22\" height=\"16\" rx=\"2\" ry=\"2\"/><line x1=\"1\" y1=\"10\" x2=\"23\" y2=\"10\"/>";
    var icTool       = "<path d=\"M14.7 6.3a1 1 0 000 1.4l1.6 1.6a1 1 0 001.4 0l3.77-3.77a6 6 0 01-7.94 7.94l-6.91 6.91a2.12 2.12 0 01-3-3l6.91-6.91a6 6 0 017.94-7.94l-3.76 3.76z\"/>";
    var icUser       = "<path d=\"M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2\"/><circle cx=\"12\" cy=\"7\" r=\"4\"/>";
    var icBox        = "<path d=\"M21 16V8a2 2 0 00-1-1.73l-7-4a2 2 0 00-2 0l-7 4A2 2 0 003 8v8a2 2 0 001 1.73l7 4a2 2 0 002 0l7-4A2 2 0 0021 16z\"/><polyline points=\"3.27 6.96 12 12.01 20.73 6.96\"/><line x1=\"12\" y1=\"22.08\" x2=\"12\" y2=\"12\"/>";
    var icDollar     = "<line x1=\"12\" y1=\"1\" x2=\"12\" y2=\"23\"/><path d=\"M17 5H9.5a3.5 3.5 0 100 7h5a3.5 3.5 0 110 7H6\"/>";
    var icClock      = "<circle cx=\"12\" cy=\"12\" r=\"10\"/><polyline points=\"12 6 12 12 16 14\"/>";
    var icClipboard  = "<path d=\"M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2\"/><rect x=\"9\" y=\"3\" width=\"6\" height=\"4\" rx=\"1\"/>";
    var icNote       = "<path d=\"M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z\"/><polyline points=\"14 2 14 8 20 8\"/><line x1=\"16\" y1=\"13\" x2=\"8\" y2=\"13\"/><line x1=\"16\" y1=\"17\" x2=\"8\" y2=\"17\"/><polyline points=\"10 9 9 9 8 9\"/>";
    var icStar       = "<polygon points=\"12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2\"/>";
    var icPrinter    = "<polyline points=\"6 9 6 2 18 2 18 9\"/><path d=\"M6 18H4a2 2 0 01-2-2v-5a2 2 0 012-2h16a2 2 0 012 2v5a2 2 0 01-2 2h-2\"/><rect x=\"6\" y=\"14\" width=\"12\" height=\"8\"/>";
    var icHelpCircle = "<circle cx=\"12\" cy=\"12\" r=\"10\"/><path d=\"M9.09 9a3 3 0 015.83 1c0 2-3 3-3 3M12 17h.01\"/>";
    var icRocket     = "<path d=\"M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 00-2.91-.09z\"/><path d=\"M12 15l-3-3a22 22 0 012-3.95A12.88 12.88 0 0122 2c0 2.72-.78 7.5-6 11a22.35 22.35 0 01-4 2z\"/><path d=\"M9 12H4s.55-3.03 2-4c1.62-1.08 5 0 5 0M12 15v5s3.03-.55 4-2c1.08-1.62 0-5 0-5\"/>";

    // ستاره‌های امتیاز ثبت‌شده (تعداد پر = امتیاز)
    Func<int, string> Stars = (rating) => new string('★', Math.Clamp(rating, 0, 5)) + new string('☆', Math.Max(0, 5 - rating));
}
@section Styles {
<style>
.order-page { padding:var(--space-8) 0 var(--space-20); }
/* Header banner */
.order-banner {
    background:linear-gradient(135deg,var(--primary-700) 0%,var(--accent-600) 100%);
    border-radius:var(--radius-3xl); color:white;
    padding:var(--space-8) var(--space-10); margin-bottom:var(--space-8);
    position:relative; overflow:hidden;
}
.order-banner::before { content:''; position:absolute; top:-20px; left:-10px; width:120px; height:120px; background:rgba(255,255,255,.05); border-radius:50%; pointer-events:none; }
.order-banner__inner { position:relative; z-index:1; display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:var(--space-5); }
.order-banner__number { font-size:clamp(1.25rem,2vw,1.75rem); font-weight:var(--font-black); color:white; letter-spacing:-.03em; }
.order-banner__title { opacity:.9; font-size:var(--text-base); margin-top:var(--space-1); }
.order-banner__amount { font-size:clamp(1.75rem,3vw,2.75rem); font-weight:var(--font-black); line-height:1; }
/* Status tracker */
.status-track { display:flex; align-items:flex-start; padding:var(--space-6) var(--space-8); position:relative; }
.status-track::before { content:''; position:absolute; top:28px; right:calc(var(--space-8) + 20px); left:calc(var(--space-8) + 20px); height:2px; background:var(--gray-200); z-index:0; }
.status-stage { flex:1; display:flex; flex-direction:column; align-items:center; gap:var(--space-2); position:relative; z-index:1; }
.status-dot { width:40px; height:40px; border-radius:50%; background:white; border:2.5px solid var(--gray-200); display:flex; align-items:center; justify-content:center; font-size:1rem; transition:all .3s; }
.status-stage.done   .status-dot { background:var(--success-500); border-color:var(--success-500); color:white; }
.status-stage.active .status-dot { background:white; border-color:var(--primary-500); box-shadow:0 0 0 6px rgba(139,115,85,.12); animation:statusPulse 2s infinite; }
.status-dot-label { font-size:var(--text-xs); font-weight:var(--font-semibold); color:var(--color-text-tertiary); text-align:center; }
.status-stage.done   .status-dot-label { color:var(--success-600); }
.status-stage.active .status-dot-label { color:var(--primary-700); }
@@keyframes statusPulse { 0%,100%{box-shadow:0 0 0 0 rgba(139,115,85,.3);} 50%{box-shadow:0 0 0 10px rgba(139,115,85,0);} }
/* Info grid */
.info-tiles { display:grid; grid-template-columns:repeat(auto-fit,minmax(160px,1fr)); gap:var(--space-4); }
.info-tile { background:var(--gray-50); border-radius:var(--radius-xl); padding:var(--space-4); border-right:3px solid var(--primary-400); }
.info-tile__icon { font-size:1.5rem; margin-bottom:var(--space-2); }
.info-tile__label { font-size:var(--text-xs); font-weight:var(--font-semibold); text-transform:uppercase; letter-spacing:.05em; color:var(--color-text-tertiary); margin-bottom:var(--space-1); }
.info-tile__value { font-size:var(--text-lg); font-weight:var(--font-bold); color:var(--gray-900); }
/* Timeline */
.evt-timeline { position:relative; padding-right:var(--space-8); }
.evt-timeline::before { content:''; position:absolute; right:12px; top:8px; bottom:0; width:2px; background:var(--gray-200); }
.evt-item { position:relative; padding-bottom:var(--space-5); }
.evt-item:last-child { padding-bottom:0; }
.evt-dot { position:absolute; right:0; top:4px; width:26px; height:26px; border-radius:50%; display:flex; align-items:center; justify-content:center; font-size:.7rem; font-weight:var(--font-bold); color:white; border:2px solid white; box-shadow:var(--shadow-sm); transform:translateX(50%); z-index:1; }
.evt-content { background:var(--gray-50); border-radius:var(--radius-xl); padding:var(--space-4); }
.evt-content__title { font-size:var(--text-sm); font-weight:var(--font-semibold); margin-bottom:2px; }
.evt-content__sub { font-size:var(--text-xs); color:var(--color-text-tertiary); }
/* Sidebar action card */
.action-card { background:white; border:1px solid var(--color-border-subtle); border-radius:var(--radius-2xl); padding:var(--space-7); position:sticky; top:88px; }
.financial-row { display:flex; justify-content:space-between; font-size:var(--text-sm); padding:var(--space-2) 0; border-bottom:1px solid var(--color-border-subtle); }
.financial-row:last-child { border-bottom:none; font-weight:var(--font-bold); }
.dash-card { background:white; border:1px solid var(--color-border-subtle); border-radius:var(--radius-2xl); padding:var(--space-7); margin-bottom:var(--space-5); }
.dash-card__title { font-size:var(--text-base); font-weight:var(--font-bold); margin-bottom:var(--space-5); }
</style>
}

<div class="order-page">
    <div class="hs-container">
        <nav style="font-size:var(--text-sm);color:var(--color-text-tertiary);margin-bottom:var(--space-6);">
            <a asp-controller="Home" asp-action="Index" style="color:inherit;text-decoration:none;">خانه</a> /
            <a asp-controller="@(isCustomer?"Customer":"Expert")" asp-action="@(isCustomer?"MyOrders":"MyJobs")" style="color:inherit;text-decoration:none;">@(isCustomer?"سفارش‌های من":"کارهای من")</a> /
            <span>@Model.OrderNumber</span>
        </nav>

        @* Banner *@
        <div class="order-banner" data-reveal="up">
            <div class="order-banner__inner">
                <div>
                    <div style="display:flex;align-items:center;gap:var(--space-3);margin-bottom:var(--space-2);">
                        <div class="order-banner__number">@Model.OrderNumber</div>
                        <span class="badge" style="background:rgba(255,255,255,.2);color:white;font-size:var(--text-xs);">@Model.Status.ToDisplay()</span>
                    </div>
                    <div class="order-banner__title">@Model.RequestTitle</div>
                    <div style="display:flex;gap:var(--space-4);margin-top:var(--space-3);font-size:var(--text-sm);opacity:.85;">
                        <span>@Html.Raw(Svg(icClock)) @Model.CreatedAt.ToPersianDate()</span>
                        @if (Model.ScheduledDate.HasValue) { <span>@Html.Raw(Svg(icCalendar)) @Model.ScheduledDate.Value.ToPersianDate()</span> }
                    </div>
                </div>
                <div style="text-align:left;">
                    <div class="order-banner__amount">@Model.TotalAmount.ToString("N0")</div>
                    <div style="opacity:.8;font-size:var(--text-sm);">تومان</div>
                </div>
            </div>
        </div>

        @* Status tracker *@
        <div class="dash-card" style="padding:var(--space-5) 0;" data-reveal="up">
            <div class="dash-card__title" style="padding:0 var(--space-7) var(--space-4);">@Html.Raw(Svg(icRocket)) وضعیت سفارش</div>
            <div class="status-track">
                @for (int i = 0; i < stages.Length; i++)
                {
                    var s    = stages[i];
                    var done = i < curIdx || isCompleted;
                    var act  = i == curIdx && !isCompleted;
                    <div class="status-stage @(done?"done":act?"active":"")">
                        <div class="status-dot">
                            @if (done) { @Html.Raw(Svg(icCheck)) }
                            else if (s.Icon == "credit-card")  { @Html.Raw(Svg(icCreditCard)) }
                            else if (s.Icon == "check-circle") { @Html.Raw(Svg(icCheckCircle)) }
                            else if (s.Icon == "calendar")     { @Html.Raw(Svg(icCalendar)) }
                            else if (s.Icon == "tool")         { @Html.Raw(Svg(icTool)) }
                            else                               { @Html.Raw(Svg(icCheck)) }
                        </div>
                        <div class="status-dot-label">@s.Lbl</div>
                        @if (act) { <div style="font-size:10px;color:var(--primary-600);font-weight:var(--font-bold);">فعلی</div> }
                        else if (done && i == curIdx) { <div style="font-size:10px;color:var(--success-600);font-weight:var(--font-bold);">پایان</div> }
                    </div>
                }
            </div>
        </div>

        <div class="row g-5" style="--bs-gutter-x:1.5rem;align-items:flex-start;">
            <div class="col-lg-8">

                @* Info tiles *@
                <div class="dash-card" data-reveal="up">
                    <div class="dash-card__title">اطلاعات سفارش</div>
                    <div class="info-tiles">
                        <div class="info-tile">
                            <div class="info-tile__icon">@Html.Raw(Svg(icDollar))</div>
                            <div class="info-tile__label">مبلغ کل</div>
                            <div class="info-tile__value">@Model.TotalAmount.ToString("N0") ت</div>
                        </div>
                        <div class="info-tile" style="border-right-color:var(--success-400);">
                            <div class="info-tile__icon">@Html.Raw(Svg(icCalendar))</div>
                            <div class="info-tile__label">تاریخ ثبت</div>
                            <div class="info-tile__value" style="font-size:var(--text-sm);">@Model.CreatedAt.ToPersianDate()</div>
                        </div>
                        @if (Model.ScheduledDate.HasValue)
                        {
                            <div class="info-tile" style="border-right-color:var(--warning-400);">
                                <div class="info-tile__icon">@Html.Raw(Svg(icClock))</div>
                                <div class="info-tile__label">زمان‌بندی</div>
                                <div class="info-tile__value" style="font-size:var(--text-sm);">@Model.ScheduledDate.Value.ToPersianDate()</div>
                            </div>
                        }
                        @if (Model.CompletedDate.HasValue)
                        {
                            <div class="info-tile" style="border-right-color:var(--success-500);">
                                <div class="info-tile__icon">@Html.Raw(Svg(icCheckCircle))</div>
                                <div class="info-tile__label">تاریخ تکمیل</div>
                                <div class="info-tile__value" style="font-size:var(--text-sm);">@Model.CompletedDate.Value.ToPersianDate()</div>
                            </div>
                        }
                    </div>
                    @if (!string.IsNullOrEmpty(Model.Notes))
                    {
                        <div style="margin-top:var(--space-5);padding-top:var(--space-5);border-top:1px solid var(--color-border-subtle);">
                            <div style="font-size:var(--text-xs);font-weight:var(--font-semibold);text-transform:uppercase;letter-spacing:.05em;color:var(--color-text-tertiary);margin-bottom:var(--space-2);">یادداشت</div>
                            <p style="margin:0;font-size:var(--text-sm);color:var(--color-text-secondary);line-height:1.6;">@Model.Notes</p>
                        </div>
                    }
                </div>

                @* Expert *@
                @if (!string.IsNullOrEmpty(Model.ExpertBusinessName))
                {
                    <div class="dash-card" data-reveal="up">
                        <div class="dash-card__title">کارشناس</div>
                        <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:var(--space-4);">
                            <div style="display:flex;align-items:center;gap:var(--space-4);">
                                <div style="width:60px;height:60px;border-radius:50%;background:var(--gradient-primary);color:white;display:flex;align-items:center;justify-content:center;font-size:1.5rem;font-weight:var(--font-bold);flex-shrink:0;">
                                    @(Model.ExpertBusinessName.FirstOrDefault())
                                </div>
                                <div>
                                    <div style="font-size:var(--text-lg);font-weight:var(--font-bold);">@Model.ExpertBusinessName</div>
                                </div>
                            </div>
                            @if (Model.ExpertId != Guid.Empty)
                            {
                                <a asp-controller="Experts" asp-action="Details" asp-route-id="@Model.ExpertId" class="btn btn-secondary btn-sm">مشاهده پروفایل</a>
                            }
                        </div>
                    </div>
                }

                @* Work completion report panel *@
                @{
                    var completionReport = ViewBag.CompletionReport as HomeServices.Application.Dtos.WorkCompletionReportDto;
                }
                @if (completionReport != null)
                {
                    <div class="dash-card" data-reveal="up" style="border-right:4px solid @(completionReport.Status == CompletionReviewStatus.Approved ? "var(--success-500)" : completionReport.Status == CompletionReviewStatus.Rejected ? "var(--danger-500)" : "var(--warning-500)");">
                        <div class="dash-card__title">@Html.Raw(Svg(icClipboard)) وضعیت اتمام کار — @completionReport.Status.ToDisplay()</div>
                        <div style="display:grid;grid-template-columns:1fr 1fr;gap:var(--space-4);margin-bottom:var(--space-4);">
                            <div style="background:var(--gray-50);border-radius:var(--radius-xl);padding:var(--space-4);">
                                <div style="font-size:var(--text-xs);color:var(--color-text-tertiary);margin-bottom:var(--space-1);">@Html.Raw(Svg(icTool)) کارشناس</div>
                                <div style="font-weight:var(--font-bold);color:@(completionReport.ExpertConfirmed ? "var(--success-600)" : "var(--color-text-tertiary)");">
                                    @(completionReport.ExpertConfirmed ? "اتمام کار را تأیید کرده است" : "هنوز اعلامی ثبت نکرده است")
                                </div>
                                @if (!string.IsNullOrEmpty(completionReport.ExpertNote))
                                {
                                    <div style="font-size:var(--text-sm);color:var(--color-text-secondary);margin-top:var(--space-2);line-height:1.7;">@completionReport.ExpertNote</div>
                                }
                            </div>
                            <div style="background:var(--gray-50);border-radius:var(--radius-xl);padding:var(--space-4);">
                                <div style="font-size:var(--text-xs);color:var(--color-text-tertiary);margin-bottom:var(--space-1);">@Html.Raw(Svg(icUser)) مشتری</div>
                                <div style="font-weight:var(--font-bold);color:@(completionReport.CustomerConfirmed ? "var(--success-600)" : "var(--color-text-tertiary)");">
                                    @(completionReport.CustomerConfirmed ? "اتمام کار را تأیید کرده است" : "هنوز اعلامی ثبت نکرده است")
                                </div>
                                @if (!string.IsNullOrEmpty(completionReport.CustomerNote))
                                {
                                    <div style="font-size:var(--text-sm);color:var(--color-text-secondary);margin-top:var(--space-2);line-height:1.7;">@completionReport.CustomerNote</div>
                                }
                            </div>
                        </div>
                        @if (completionReport.Attachments.Count > 0)
                        {
                            <div style="margin-bottom:var(--space-4);">
                                <div style="font-size:var(--text-xs);font-weight:var(--font-semibold);color:var(--color-text-tertiary);margin-bottom:var(--space-2);">مستندات (@completionReport.Attachments.Count فایل):</div>
                                <div style="display:flex;flex-wrap:wrap;gap:var(--space-2);">
                                    @foreach (var att in completionReport.Attachments)
                                    {
                                        <a href="@att.FileUrl" target="_blank" title="ارسال‌کننده: @att.Uploader.ToDisplay()">
                                            @if (att.MediaType == MediaType.Video)
                                            {
                                                <span style="display:inline-flex;align-items:center;gap:4px;background:var(--gray-100);border-radius:var(--radius-md);padding:var(--space-2) var(--space-3);font-size:var(--text-xs);">ویدیو</span>
                                            }
                                            else
                                            {
                                                <img src="@(att.ThumbnailUrl ?? att.FileUrl)" style="width:64px;height:64px;object-fit:cover;border-radius:var(--radius-md);border:1px solid var(--color-border-subtle);" alt="مستند" />
                                            }
                                        </a>
                                    }
                                </div>
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(completionReport.SupportNote))
                        {
                            <div style="background:@(completionReport.Status == CompletionReviewStatus.Approved ? "rgba(16,185,129,.08)" : "rgba(239,68,68,.08)");border:1px solid @(completionReport.Status == CompletionReviewStatus.Approved ? "var(--success-400)" : "var(--danger-400)");border-radius:var(--radius-xl);padding:var(--space-4);font-size:var(--text-sm);line-height:1.8;">
                                <strong>پیام پشتیبانی (میانجی):</strong> @completionReport.SupportNote
                                @if (completionReport.Status == CompletionReviewStatus.Rejected)
                                {
                                    <div style="margin-top:var(--space-2);font-size:var(--text-xs);color:var(--color-text-tertiary);">لطفاً موارد ذکرشده را برطرف کرده و مجدداً اعلام اتمام کار را انجام دهید.</div>
                                }
                            </div>
                        }
                    </div>
                }

                @* Timeline *@
                <div class="dash-card" data-reveal="up">
                    <div class="dash-card__title">تاریخچه سفارش</div>
                    <div class="evt-timeline">
                        @if (Model.CompletedDate.HasValue)
                        {
                            <div class="evt-item">
                                <div class="evt-dot" style="background:var(--success-500);">@Html.Raw(Svg(icCheckCircle))</div>
                                <div class="evt-content">
                                    <div class="evt-content__title">سفارش تکمیل شد</div>
                                    <div class="evt-content__sub">@Model.CompletedDate.Value.ToPersianDate()</div>
                                </div>
                            </div>
                        }
                        @if (Model.Status == OrderStatus.InProgress || Model.Status == OrderStatus.Completed)
                        {
                            <div class="evt-item">
                                <div class="evt-dot" style="background:var(--info-500);">@Html.Raw(Svg(icTool))</div>
                                <div class="evt-content">
                                    <div class="evt-content__title">کار شروع شد</div>
                                    <div class="evt-content__sub">@Model.ScheduledDate?.ToPersianDate()</div>
                                </div>
                            </div>
                        }
                        @if (Model.Status != OrderStatus.PendingPayment)
                        {
                            <div class="evt-item">
                                <div class="evt-dot" style="background:var(--success-500);">@Html.Raw(Svg(icCheck))</div>
                                <div class="evt-content">
                                    <div class="evt-content__title">پرداخت تأیید شد</div>
                                    <div class="evt-content__sub">@Model.CreatedAt.ToPersianDate()</div>
                                </div>
                            </div>
                        }
                        <div class="evt-item">
                            <div class="evt-dot" style="background:var(--primary-500);">@Html.Raw(Svg(icBox))</div>
                            <div class="evt-content">
                                <div class="evt-content__title">سفارش ایجاد شد</div>
                                <div class="evt-content__sub">@Model.CreatedAt.ToPersianDate()</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            @* Sidebar *@
            <div class="col-lg-4">
                <div class="action-card" data-reveal="left">
                    <div style="font-size:var(--text-sm);font-weight:var(--font-bold);margin-bottom:var(--space-4);">عملیات</div>
                    <div style="display:flex;flex-direction:column;gap:var(--space-2);">
                        @if (isCustomer && Model.Status == OrderStatus.PendingPayment)
                        {
                            <a asp-controller="Orders" asp-action="Pay" asp-route-id="@Model.Id" class="btn btn-primary btn-block">@Html.Raw(Svg(icCreditCard)) پرداخت کارت به کارت</a>
                            <div style="text-align:center;font-size:var(--text-xs);color:var(--color-text-tertiary);">انتقال کارت به کارت — بدون درگاه بانکی</div>
                        }
                        @if (isCustomer && Model.Status == OrderStatus.WaitingPaymentVerification)
                        {
                            <div style="background:rgba(251,191,36,.1);border:1px solid var(--warning-400);border-radius:var(--radius-xl);padding:var(--space-4);font-size:var(--text-sm);line-height:1.8;">
                                @Html.Raw(Svg(icClock)) گزارش پرداخت شما ثبت شده و در انتظار تأیید پشتیبانی است. پس از تأیید، کارشناس کار را آغاز خواهد کرد.
                            </div>
                        }
                        @if (!isCustomer && User.IsInRole("Expert") && (Model.Status == OrderStatus.InProgress || Model.Status == OrderStatus.Scheduled || Model.Status == OrderStatus.Paid))
                        {
                            <a asp-controller="Expert" asp-action="MarkComplete" asp-route-id="@Model.Id" class="btn btn-primary btn-block">@Html.Raw(Svg(icCheckCircle)) اعلام اتمام کار</a>
                            <div style="text-align:center;font-size:var(--text-xs);color:var(--color-text-tertiary);">همراه با توضیحات و مستندات (تصویر یا ویدیو)</div>
                        }
                        @if (isCustomer && (Model.Status == OrderStatus.CompletionReview || Model.Status == OrderStatus.InProgress))
                        {
                            var rep = ViewBag.CompletionReport as HomeServices.Application.Dtos.WorkCompletionReportDto;
                            if (rep == null || !rep.CustomerConfirmed)
                            {
                                <a asp-controller="Orders" asp-action="ConfirmCompletion" asp-route-orderId="@Model.Id" class="btn btn-primary btn-block">@Html.Raw(Svg(icCheckCircle)) اعلام وضعیت اتمام کار</a>
                                <div style="text-align:center;font-size:var(--text-xs);color:var(--color-text-tertiary);">تأیید اتمام یا اعلام عدم رضایت، همراه با توضیحات و مستندات</div>
                            }
                        }
                        @{
                            var existingReview = ViewBag.ExistingReview as HomeServices.Application.Dtos.ReviewDto;
                        }
                        @if (isDone && isCustomer && existingReview == null)
                        {
                            <a asp-controller="Reviews" asp-action="Create" asp-route-orderId="@Model.Id" class="btn btn-secondary btn-block">@Html.Raw(Svg(icStar)) ثبت نظر و امتیاز</a>
                        }
                        else if (isDone && isCustomer && existingReview != null)
                        {
                            <div style="background:rgba(16,185,129,.08);border:1px solid var(--success-400);border-radius:var(--radius-xl);padding:var(--space-4);font-size:var(--text-sm);line-height:1.8;">
                                @Html.Raw(Svg(icCheckCircle)) نظر شما برای این سفارش ثبت شده است
                                <span style="color:var(--warning-500);letter-spacing:2px;">@Stars(existingReview.Rating)</span>
                                <div style="font-size:var(--text-xs);color:var(--color-text-tertiary);margin-top:var(--space-1);">
                                    وضعیت انتشار: @(existingReview.Status == ReviewStatus.Approved ? "تأیید و منتشر شده" : existingReview.Status == ReviewStatus.Rejected ? "رد شده توسط مدیر" : "در انتظار تأیید مدیر")
                                </div>
                            </div>
                        }
                        <a asp-controller="ServiceRequests" asp-action="Details" asp-route-id="@Model.RequestId" class="btn btn-secondary btn-block">@Html.Raw(Svg(icClipboard)) مشاهده درخواست</a>
                        <button type="button" class="btn btn-ghost btn-block" onclick="window.print()">@Html.Raw(Svg(icPrinter)) چاپ سفارش</button>
                    </div>

                    <div style="height:1px;background:var(--color-border-subtle);margin:var(--space-5) 0;"></div>
                    <div style="font-size:var(--text-xs);font-weight:var(--font-semibold);text-transform:uppercase;letter-spacing:.06em;color:var(--color-text-tertiary);margin-bottom:var(--space-3);">جزئیات مالی</div>
                    <div class="financial-row"><span>مبلغ پایه</span><span>@Model.TotalAmount.ToString("N0") ت</span></div>
                    <div class="financial-row"><span>مالیات</span><span>۰ ت</span></div>
                    <div class="financial-row" style="font-size:var(--text-base);padding-top:var(--space-3);">
                        <span>جمع کل</span><span style="color:var(--primary-700);">@Model.TotalAmount.ToString("N0") ت</span>
                    </div>

                    <div style="height:1px;background:var(--color-border-subtle);margin:var(--space-5) 0;"></div>
                    <div style="font-size:var(--text-xs);font-weight:var(--font-semibold);text-transform:uppercase;letter-spacing:.06em;color:var(--color-text-tertiary);margin-bottom:var(--space-3);">مشخصات سفارش</div>
                    <div class="financial-row"><span style="color:var(--color-text-secondary);">شماره</span><span>@Model.OrderNumber</span></div>
                    <div class="financial-row"><span style="color:var(--color-text-secondary);">شناسه</span><span>#@Model.Id</span></div>
                    <div class="financial-row"><span style="color:var(--color-text-secondary);">تاریخ ثبت</span><span style="font-size:var(--text-xs);">@Model.CreatedAt.ToPersianDate()</span></div>
                </div>

                <div style="background:var(--gray-50);border:1px solid var(--color-border-subtle);border-radius:var(--radius-2xl);padding:var(--space-6);text-align:center;margin-top:var(--space-4);" data-reveal="left">
                    <div style="margin-bottom:var(--space-3);color:var(--primary-600);font-size:2rem;">@Html.Raw(Svg(icHelpCircle))</div>
                    <div style="font-weight:var(--font-bold);margin-bottom:var(--space-2);">نیاز به کمک دارید؟</div>
                    <p style="font-size:var(--text-sm);color:var(--color-text-secondary);margin-bottom:var(--space-4);">موردی در این سفارش برای پشتیبانی ثبت کنید؛ در سریع‌ترین زمان پاسخ می‌دهیم.</p>
                    <a asp-controller="Support" asp-action="Create" asp-route-orderId="@Model.Id" class="btn btn-secondary btn-block btn-sm">ثبت تیکت پشتیبانی</a>
                    <a asp-controller="Support" asp-action="MyTickets" class="btn btn-outline-brand btn-block btn-sm" style="margin-top:var(--space-2);">پیگیری تیکت‌های من</a>
                </div>
            </div>
        </div>
    </div>
</div>
