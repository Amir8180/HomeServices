@model IReadOnlyList<ProposalDto>
@using HomeServices.Application.Dtos
@{
    ViewData["Title"] = "مقایسه پیشنهادها";
    var request   = ViewBag.Request as ServiceRequestDto;
    var experts   = ViewBag.Experts as IDictionary<Guid, ExpertProfileDto?> ?? new Dictionary<Guid, ExpertProfileDto?>();
    var canChoose = request != null && !request.AcceptedProposalId.HasValue;

    var bestPrice  = Model.Any() ? Model.Min(p => p.Price) : 0m;
    var bestRating = experts.Values.Where(e=>e!=null).Any() ? experts.Values.Where(e=>e!=null).Max(e=>e!.RatingAverage) : 0;

    ProposalDto? recommended = null;
    if (Model.Any())
    {
        recommended = Model.Where(p => p.Status == ProposalStatus.Pending)
            .OrderBy(p => {
                var e = experts.ContainsKey(p.ExpertId) ? experts[p.ExpertId] : null;
                return (double)p.Price * 0.4 + (e != null ? (5 - e.RatingAverage) * 100000 : 500000) * 0.6;
            }).FirstOrDefault();
    }
}
@section Styles {
<style>
.compare-page { padding:var(--space-10) 0 var(--space-20); }
.compare-hero { background:linear-gradient(135deg,var(--primary-50) 0%,white 60%,var(--accent-50) 100%); padding:var(--space-10) 0; border-bottom:1px solid var(--color-border-subtle); margin-bottom:var(--space-8); }
/* Stats ribbon */
.stats-ribbon { display:grid; grid-template-columns:repeat(auto-fit,minmax(120px,1fr)); gap:var(--space-4); background:white; border:1px solid var(--color-border-subtle); border-radius:var(--radius-2xl); padding:var(--space-6); margin-bottom:var(--space-6); }
.ribbon-stat { text-align:center; }
.ribbon-stat__val { font-size:var(--text-2xl); font-weight:var(--font-extrabold); color:var(--primary-700); line-height:1; margin-bottom:var(--space-1); }
.ribbon-stat__lbl { font-size:var(--text-xs); color:var(--color-text-tertiary); }
/* Recommendation card */
.recommend-card {
    background:linear-gradient(135deg,var(--primary-50) 0%,var(--accent-50) 100%);
    border:2px solid var(--warning-300); border-radius:var(--radius-2xl);
    padding:var(--space-7); margin-bottom:var(--space-6); position:relative; overflow:hidden;
}
.recommend-card::before { content:'⭐'; position:absolute; top:-10px; right:-10px; font-size:5rem; opacity:.08; }
.winner-tag { display:inline-flex; align-items:center; gap:var(--space-2); padding:var(--space-1-5) var(--space-4); background:linear-gradient(135deg,var(--warning-500),var(--primary-600)); color:white; border-radius:var(--radius-full); font-size:var(--text-xs); font-weight:var(--font-bold); margin-bottom:var(--space-4); }
/* Proposal card */
.proposal-card { background:white; border:1.5px solid var(--color-border-subtle); border-radius:var(--radius-2xl); padding:var(--space-6); height:100%; display:flex; flex-direction:column; transition:all .25s; }
.proposal-card:hover { box-shadow:var(--shadow-lg); border-color:var(--primary-200); transform:translateY(-4px); }
.proposal-card.accepted { border-color:var(--success-400); background:var(--success-50); }
/* View toggle */
.view-toggle-pill { display:inline-flex; background:var(--gray-100); border-radius:var(--radius-full); padding:3px; }
.view-toggle-btn { padding:var(--space-1-5) var(--space-4); border-radius:var(--radius-full); border:none; background:none; font-size:var(--text-sm); font-weight:var(--font-semibold); color:var(--color-text-secondary); cursor:pointer; transition:all .2s; }
.view-toggle-btn.active { background:white; color:var(--primary-700); box-shadow:var(--shadow-sm); }
/* Table best value cell */
.best-cell { background:var(--success-500); color:white; padding:var(--space-1) var(--space-2); border-radius:var(--radius-md); font-weight:var(--font-bold); font-size:var(--text-xs); }
</style>
}

<div class="compare-hero">
    <div class="hs-container">
        <nav style="font-size:var(--text-sm);color:var(--color-text-tertiary);margin-bottom:var(--space-4);">
            <a asp-controller="Home" asp-action="Index" style="color:inherit;text-decoration:none;">خانه</a> /
            <a asp-controller="ServiceRequests" asp-action="Details" asp-route-id="@request?.Id" style="color:inherit;text-decoration:none;">@request?.Title</a> /
            <span>مقایسه پیشنهادها</span>
        </nav>
        <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:var(--space-4);">
            <div data-reveal="up">
                <h1 style="font-size:clamp(1.75rem,3vw,2.5rem);font-weight:var(--font-black);letter-spacing:-.03em;margin-bottom:var(--space-2);">مقایسه پیشنهادها</h1>
                <p style="color:var(--color-text-secondary);font-size:var(--text-base);margin:0;">@request?.Title</p>
            </div>
            @if (!canChoose)
            {
                <span class="badge badge--success" style="font-size:var(--text-sm);padding:var(--space-2) var(--space-4);">✅ پیشنهاد انتخاب شده است</span>
            }
            else if (Model.Any())
            {
                <div class="view-toggle-pill" data-reveal="up">
                    <button class="view-toggle-btn active" id="btnCards" onclick="switchView('cards')">▦ کارت‌ها</button>
                    <button class="view-toggle-btn"        id="btnTable" onclick="switchView('table')">☰ جدول</button>
                </div>
            }
        </div>
    </div>
</div>

<div class="compare-page">
    <div class="hs-container">
        @if (!Model.Any())
        {
            <div class="empty-state">
                <div class="empty-state__icon">⏳</div>
                <div class="empty-state__title">هنوز پیشنهادی دریافت نشده</div>
                <p class="empty-state__desc">به محض ارسال پیشنهاد توسط کارشناسان اینجا نمایش داده می‌شود.</p>
                <a asp-controller="ServiceRequests" asp-action="Details" asp-route-id="@request?.Id" class="btn btn-primary">بازگشت به درخواست</a>
            </div>
        }
        else
        {
            @* Stats ribbon *@
            <div class="stats-ribbon" data-stagger>
                <div class="ribbon-stat" data-reveal="up">
                    <div class="ribbon-stat__val" data-counter="@Model.Count">@Model.Count</div>
                    <div class="ribbon-stat__lbl">پیشنهاد دریافتی</div>
                </div>
                <div class="ribbon-stat" data-reveal="up">
                    <div class="ribbon-stat__val">@bestPrice.ToString("N0")</div>
                    <div class="ribbon-stat__lbl">کمترین قیمت (ت)</div>
                </div>
                <div class="ribbon-stat" data-reveal="up">
                    <div class="ribbon-stat__val">@Model.Max(p=>p.Price).ToString("N0")</div>
                    <div class="ribbon-stat__lbl">بیشترین قیمت (ت)</div>
                </div>
                <div class="ribbon-stat" data-reveal="up">
                    <div class="ribbon-stat__val">@((int)Model.Average(p=>p.Price)).ToString("N0")</div>
                    <div class="ribbon-stat__lbl">میانگین قیمت (ت)</div>
                </div>
            </div>

            @* Recommendation *@
            @if (recommended != null && canChoose)
            {
                var re = experts.ContainsKey(recommended.ExpertId) ? experts[recommended.ExpertId] : null;
                <div class="recommend-card" data-reveal="up">
                    <div class="winner-tag">🏆 پیشنهاد برتر هوشمند</div>
                    <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:var(--space-5);">
                        <div style="display:flex;align-items:center;gap:var(--space-4);">
                            <div style="width:64px;height:64px;border-radius:50%;background:var(--gradient-primary);color:white;display:flex;align-items:center;justify-content:center;font-size:1.75rem;font-weight:var(--font-bold);flex-shrink:0;">
                                @(recommended.ExpertBusinessName?.FirstOrDefault() ?? 'P')
                            </div>
                            <div>
                                <div style="font-size:var(--text-lg);font-weight:var(--font-bold);margin-bottom:var(--space-1);">@(recommended.ExpertBusinessName ?? "کارشناس")</div>
                                @if (re != null)
                                {
                                    <div style="display:flex;gap:2px;margin-bottom:var(--space-1);">
                                        @for (int i=1;i<=5;i++) { <span style="color:@(i<=Math.Round(re.RatingAverage)?"var(--warning-500)":"var(--gray-300)");">★</span> }
                                        <span style="font-size:var(--text-sm);font-weight:var(--font-semibold);margin-right:var(--space-1);">@re.RatingAverage.ToString("0.0")</span>
                                    </div>
                                    <div style="font-size:var(--text-xs);color:var(--color-text-secondary);">@re.JobsCompleted کار · @re.City</div>
                                }
                            </div>
                        </div>
                        <div style="text-align:left;">
                            <div style="font-size:var(--text-3xl);font-weight:var(--font-black);color:var(--primary-700);line-height:1;">@recommended.Price.ToString("N0")</div>
                            <div style="font-size:var(--text-xs);color:var(--color-text-tertiary);margin-bottom:var(--space-3);">تومان</div>
                            <form asp-action="Accept" asp-route-proposalId="@recommended.Id" asp-route-requestId="@recommended.RequestId" method="post"
                                  data-confirm="این پیشنهاد را انتخاب می‌کنید؟" data-confirm-ok="انتخاب">
                                <button type="submit" class="btn btn-primary btn-lg">✓ انتخاب این پیشنهاد</button>
                            </form>
                        </div>
                    </div>
                    @if (!string.IsNullOrEmpty(recommended.Message))
                    {
                        <div style="margin-top:var(--space-5);padding:var(--space-4);background:rgba(255,255,255,.7);border-radius:var(--radius-xl);">
                            <div style="font-size:var(--text-xs);font-weight:var(--font-bold);margin-bottom:var(--space-1);">پیام کارشناس:</div>
                            <p style="font-size:var(--text-sm);color:var(--color-text-secondary);margin:0;line-height:1.6;">@recommended.Message</p>
                        </div>
                    }
                </div>
            }

            @* Cards View *@
            <div id="viewCards" data-stagger>
                <div class="row g-4 row-cols-1 row-cols-md-2 row-cols-xl-3">
                    @foreach (var p in Model)
                    {
                        var ex       = experts.ContainsKey(p.ExpertId) ? experts[p.ExpertId] : null;
                        var accepted = p.Status == ProposalStatus.Accepted;
                        var isBestP  = p.Price == bestPrice;
                        var isBestR  = ex != null && ex.RatingAverage == bestRating;
                        <div class="col" data-reveal="up">
                            <div class="proposal-card @(accepted?"accepted":"")">
                                <div style="display:flex;flex-wrap:wrap;gap:var(--space-1);margin-bottom:var(--space-4);">
                                    @if (accepted)   { <span class="badge badge--success">✅ انتخاب شده</span> }
                                    @if (p.Status == ProposalStatus.Rejected) { <span class="badge badge--error">رد شده</span> }
                                    @if (isBestP)    { <span class="badge badge--success">💰 بهترین قیمت</span> }
                                    @if (isBestR)    { <span class="badge badge--warning">⭐ بالاترین امتیاز</span> }
                                </div>
                                <div style="display:flex;align-items:center;gap:var(--space-3);margin-bottom:var(--space-4);">
                                    <div style="width:52px;height:52px;border-radius:50%;background:var(--gradient-primary);color:white;display:flex;align-items:center;justify-content:center;font-size:1.25rem;font-weight:var(--font-bold);flex-shrink:0;">
                                        @(p.ExpertBusinessName?.FirstOrDefault() ?? 'P')
                                    </div>
                                    <div>
                                        <a asp-controller="Experts" asp-action="Details" asp-route-id="@ex?.Id" style="font-weight:var(--font-bold);text-decoration:none;color:var(--gray-900);display:block;">
                                            @(p.ExpertBusinessName ?? "کارشناس")
                                        </a>
                                        @if (ex != null)
                                        {
                                            <div style="display:flex;gap:1px;margin:2px 0;">
                                                @for(int i=1;i<=5;i++){<span style="color:@(i<=Math.Round(ex.RatingAverage)?"var(--warning-500)":"var(--gray-200)");">★</span>}
                                                <span style="font-size:var(--text-xs);font-weight:var(--font-semibold);margin-right:4px;">@ex.RatingAverage.ToString("0.0")</span>
                                            </div>
                                            <div style="font-size:var(--text-xs);color:var(--color-text-tertiary);">@ex.JobsCompleted کار · @ex.City</div>
                                        }
                                    </div>
                                </div>
                                <div style="display:flex;flex-direction:column;gap:var(--space-2);font-size:var(--text-sm);margin-bottom:var(--space-4);">
                                    <div style="display:flex;justify-content:space-between;">
                                        <span style="color:var(--color-text-secondary);">💰 قیمت</span>
                                        <span style="font-weight:var(--font-bold);color:@(isBestP?"var(--success-600)":"var(--primary-700)");">@p.Price.ToString("N0") ت</span>
                                    </div>
                                    @if (p.EstimatedDurationHours.HasValue)
                                    {
                                        <div style="display:flex;justify-content:space-between;">
                                            <span style="color:var(--color-text-secondary);">⏱ مدت</span>
                                            <span style="font-weight:var(--font-semibold);">@p.EstimatedDurationHours ساعت</span>
                                        </div>
                                    }
                                    @if (p.AvailableStartDate.HasValue)
                                    {
                                        <div style="display:flex;justify-content:space-between;">
                                            <span style="color:var(--color-text-secondary);">📅 شروع</span>
                                            <span style="font-weight:var(--font-semibold);">@p.AvailableStartDate.Value.ToPersianDate()</span>
                                        </div>
                                    }
                                    @if (ex?.ResponseTimeMinutes != null)
                                    {
                                        <div style="display:flex;justify-content:space-between;">
                                            <span style="color:var(--color-text-secondary);">⚡ پاسخ</span>
                                            <span style="font-weight:var(--font-semibold);">@ex.ResponseTimeMinutes دقیقه</span>
                                        </div>
                                    }
                                </div>
                                @if (!string.IsNullOrEmpty(p.Message))
                                {
                                    <div style="background:var(--gray-50);border-radius:var(--radius-lg);padding:var(--space-3);font-size:var(--text-xs);line-height:1.6;color:var(--color-text-secondary);margin-bottom:var(--space-4);">
                                        <strong>پیام:</strong> @p.Message
                                    </div>
                                }
                                <div style="margin-top:auto;">
                                    @if (canChoose && p.Status == ProposalStatus.Pending)
                                    {
                                        <form asp-action="Accept" asp-route-proposalId="@p.Id" asp-route-requestId="@p.RequestId" method="post"
                                              data-confirm="این پیشنهاد را انتخاب می‌کنید؟ پس از انتخاب سفارش ایجاد می‌شود."
                                              data-confirm-ok="انتخاب" style="margin-bottom:var(--space-2);">
                                            <button type="submit" class="btn btn-primary btn-block">✓ انتخاب</button>
                                        </form>
                                        <a asp-controller="Experts" asp-action="Details" asp-route-id="@ex?.Id" class="btn btn-secondary btn-block">مشاهده پروفایل</a>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>

            @* Table View *@
            <div id="viewTable" style="display:none;">
                <div class="hs-table-wrap">
                    <table class="hs-table">
                        <thead>
                            <tr>
                                <th>کارشناس</th><th>امتیاز</th><th>قیمت</th>
                                <th>مدت</th><th>شروع کار</th><th>پاسخ</th><th>تجربه</th><th>عملیات</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var p in Model.OrderBy(p=>p.Price))
                            {
                                var ex      = experts.ContainsKey(p.ExpertId) ? experts[p.ExpertId] : null;
                                var isBestP = p.Price == bestPrice;
                                <tr>
                                    <td>
                                        <div style="display:flex;align-items:center;gap:var(--space-3);">
                                            <div style="width:36px;height:36px;border-radius:50%;background:var(--gradient-primary);color:white;display:flex;align-items:center;justify-content:center;font-size:.875rem;font-weight:var(--font-bold);flex-shrink:0;">@(p.ExpertBusinessName?.FirstOrDefault()??(char)0)</div>
                                            <div>
                                                <a asp-controller="Experts" asp-action="Details" asp-route-id="@ex?.Id" style="font-weight:var(--font-semibold);text-decoration:none;color:var(--gray-900);">@(p.ExpertBusinessName??"کارشناس")</a>
                                                @if (p.Status == ProposalStatus.Accepted) { <div><span class="badge badge--success" style="font-size:10px;">✓ انتخاب شده</span></div> }
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        @if (ex != null)
                                        {
                                            <div style="display:flex;gap:1px;">@for(int i=1;i<=5;i++){<span style="font-size:.85rem;color:@(i<=Math.Round(ex.RatingAverage)?"var(--warning-500)":"var(--gray-200)");">★</span>}</div>
                                            <div style="font-size:var(--text-xs);font-weight:var(--font-semibold);">@ex.RatingAverage.ToString("0.0")</div>
                                        }
                                        else { <span style="color:var(--color-text-tertiary);">—</span> }
                                    </td>
                                    <td>
                                        @if (isBestP) { <span class="best-cell">@p.Price.ToString("N0")</span> }
                                        else { <span style="font-weight:var(--font-semibold);color:var(--primary-700);">@p.Price.ToString("N0")</span> }
                                    </td>
                                    <td>@(p.EstimatedDurationHours.HasValue?p.EstimatedDurationHours+" ساعت":"—")</td>
                                    <td style="font-size:var(--text-xs);">@(p.AvailableStartDate.HasValue?p.AvailableStartDate.Value.ToPersianDate():"—")</td>
                                    <td>@(ex?.ResponseTimeMinutes!=null?ex.ResponseTimeMinutes+" دقیقه":"—")</td>
                                    <td>@(ex!=null?ex.JobsCompleted+" کار":"—")</td>
                                    <td>
                                        @if (canChoose && p.Status == ProposalStatus.Pending)
                                        {
                                            <form asp-action="Accept" asp-route-proposalId="@p.Id" asp-route-requestId="@p.RequestId" method="post"
                                                  data-confirm="انتخاب این پیشنهاد؟" data-confirm-ok="انتخاب">
                                                <button type="submit" class="btn btn-primary btn-sm">انتخاب</button>
                                            </form>
                                        }
                                        else if (p.Status == ProposalStatus.Accepted)
                                        {
                                            <span style="color:var(--success-600);font-size:var(--text-xs);font-weight:var(--font-semibold);">✓ انتخاب شده</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
<script>
function switchView(v){
    document.getElementById('viewCards').style.display=v==='cards'?'':'none';
    document.getElementById('viewTable').style.display=v==='table'?'':'none';
    document.getElementById('btnCards').classList.toggle('active',v==='cards');
    document.getElementById('btnTable').classList.toggle('active',v==='table');
    localStorage.setItem('cmp-view',v);
}
(function(){var s=localStorage.getItem('cmp-view');if(s==='table')switchView('table');})();
</script>
}
