@model ProfileViewModel
@{
    ViewData["Title"] = "پروفایل من";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-7">
            <div class="dashboard-card">
                <div class="d-flex align-items-center gap-3 mb-4">
                    <span class="pro-avatar" style="width:64px;height:64px;font-size:1.8rem;">@(Model.FullName?.FirstOrDefault() ?? 'U')</span>
                    <div>
                        <h3 class="fw-800 mb-0">@Model.FullName</h3>
                        <span class="text-muted">@Model.Email</span>
                    </div>
                </div>

                <form asp-action="Profile" method="post">
                    <div asp-validation-summary="All" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="FullName" class="form-label">نام و نام خانوادگی</label>
                        <input asp-for="FullName" class="form-control" />
                        <span asp-validation-for="FullName" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label">ایمیل</label>
                        <input asp-for="Email" class="form-control" readonly />
                        <small class="text-muted">ایمیل قابل تغییر نیست.</small>
                    </div>

                    <div class="mb-3">
                        <label asp-for="PhoneNumber" class="form-label">شماره موبایل</label>
                        <input asp-for="PhoneNumber" class="form-control" />
                        <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="AvatarUrl" class="form-label">آدرس تصویر پروفایل (اختیاری)</label>
                        <input asp-for="AvatarUrl" class="form-control" placeholder="/uploads/..." />
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-brand">ذخیره تغییرات</button>
                        <a asp-action="ChangePassword" class="btn btn-outline-brand">تغییر رمز عبور</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
