@model RegisterViewModel
@using HomeServices.Shared.Enums
@{ ViewData["Title"] = "ثبت‌نام"; }
@section Styles {
<style>
.auth-page { min-height:100vh; display:grid; grid-template-columns:1fr 1fr; padding-top:0; }
@@media(max-width:768px) { .auth-page { grid-template-columns:1fr; } }
.auth-panel { display:flex; align-items:center; justify-content:center; padding:var(--space-10) var(--space-8); min-height:100vh; overflow-y:auto; }
.auth-form-wrap { width:100%; max-width:480px; }
.auth-brand { display:flex; align-items:center; gap:var(--space-2-5); margin-bottom:var(--space-8); }
.auth-brand__icon { width:40px; height:40px; background:var(--gradient-primary); border-radius:var(--radius-xl); display:flex; align-items:center; justify-content:center; font-size:1.25rem; box-shadow:var(--shadow-brand); }
.auth-brand__name { font-size:var(--text-xl); font-weight:var(--font-bold); }
.auth-title { font-size:var(--text-3xl); font-weight:var(--font-black); letter-spacing:-.04em; margin-bottom:var(--space-2); }
.auth-sub { font-size:var(--text-base); color:var(--color-text-secondary); margin-bottom:var(--space-7); }
.auth-visual { background:linear-gradient(135deg,var(--primary-600) 0%,var(--accent-500) 100%); display:flex; align-items:center; justify-content:center; position:relative; overflow:hidden; }
@@media(max-width:768px) { .auth-visual { display:none; } }
.auth-visual__content { text-align:center; color:white; padding:var(--space-10); position:relative; z-index:1; max-width:420px; }
.auth-visual__icon { font-size:4rem; margin-bottom:var(--space-5); display:block; animation:float 4s ease-in-out infinite; }
.auth-visual__title { font-size:var(--text-3xl); font-weight:var(--font-black); color:white; letter-spacing:-.03em; margin-bottom:var(--space-3); }
.auth-visual__sub { font-size:var(--text-sm); opacity:.85; line-height:1.7; margin-bottom:var(--space-6); }
.auth-trust { display:flex; flex-direction:column; gap:var(--space-3); }
.auth-trust-item { display:flex; align-items:center; gap:var(--space-3); background:rgba(255,255,255,.12); border-radius:var(--radius-xl); padding:var(--space-3) var(--space-4); font-size:var(--text-sm); }
.auth-visual::before { content:''; position:absolute; inset:-50%; background:radial-gradient(ellipse,rgba(255,255,255,.08) 0%,transparent 60%); animation:float 12s ease-in-out infinite; }
/* Account type selector */
.user-type-grid { display:grid; grid-template-columns:1fr 1fr; gap:var(--space-3); margin-bottom:var(--space-5); }
.user-type-option {
    display:flex; flex-direction:column; gap:var(--space-2);
    padding:var(--space-4); border:2px solid var(--color-border);
    border-radius:var(--radius-xl); cursor:pointer;
    transition:all .2s; background:white;
}
.user-type-option:hover { border-color:var(--primary-300); background:var(--primary-50); }
.user-type-option.selected { border-color:var(--primary-500); background:var(--primary-50); }
.user-type-option__icon { font-size:1.75rem; }
.user-type-option__title { font-size:var(--text-sm); font-weight:var(--font-bold); color:var(--gray-900); }
.user-type-option__desc { font-size:var(--text-xs); color:var(--color-text-tertiary); }
</style>
}

<div class="auth-page">
    <div class="auth-panel">
        <div class="auth-form-wrap animate-fade-in-up">
            <a class="auth-brand" asp-controller="Home" asp-action="Index">
                <div class="auth-brand__icon">🏠</div>
                <span class="auth-brand__name">خدمات منزل</span>
            </a>
            <h1 class="auth-title">ایجاد حساب رایگان</h1>
            <p class="auth-sub">در چند ثانیه ثبت‌نام کنید.</p>

            <form asp-action="Register" method="post" data-loading="bar">
                <input type="hidden" asp-for="ReturnUrl" />
                <div asp-validation-summary="ModelOnly" class="alert alert--error" style="margin-bottom:var(--space-5);"></div>

                @* Account type *@
                <div style="margin-bottom:var(--space-5);">
                    <div style="font-size:var(--text-xs);font-weight:var(--font-bold);text-transform:uppercase;letter-spacing:.06em;color:var(--color-text-tertiary);margin-bottom:var(--space-3);">نوع حساب</div>
                    <div class="user-type-grid">
                        <label class="user-type-option" id="opt-customer">
                            <input asp-for="UserType" type="radio" value="@UserType.Customer" style="display:none;" checked />
                            <span class="user-type-option__icon">👤</span>
                            <span class="user-type-option__title">مشتری</span>
                            <span class="user-type-option__desc">درخواست خدمات</span>
                        </label>
                        <label class="user-type-option" id="opt-expert">
                            <input asp-for="UserType" type="radio" value="@UserType.Expert" style="display:none;" />
                            <span class="user-type-option__icon">🔧</span>
                            <span class="user-type-option__title">کارشناس</span>
                            <span class="user-type-option__desc">ارائه خدمات</span>
                        </label>
                    </div>
                </div>

                <div class="form-group" style="margin-bottom:var(--space-4);">
                    <label asp-for="FullName" class="form-label form-label--required">نام و نام خانوادگی</label>
                    <input asp-for="FullName" class="form-control" placeholder="مثلاً علی احمدی" />
                    <span asp-validation-for="FullName" class="form-error"></span>
                </div>

                <div class="form-group" style="margin-bottom:var(--space-4);">
                    <label asp-for="Email" class="form-label form-label--required">ایمیل</label>
                    <input asp-for="Email" class="form-control" placeholder="email@example.com" autocomplete="username" />
                    <span asp-validation-for="Email" class="form-error"></span>
                </div>

                <div class="form-group" style="margin-bottom:var(--space-4);">
                    <label asp-for="PhoneNumber" class="form-label">شماره موبایل</label>
                    <input asp-for="PhoneNumber" class="form-control" placeholder="09121234567" />
                    <span asp-validation-for="PhoneNumber" class="form-error"></span>
                </div>

                <div style="display:grid;grid-template-columns:1fr 1fr;gap:var(--space-3);margin-bottom:var(--space-6);">
                    <div class="form-group">
                        <label asp-for="Password" class="form-label form-label--required">رمز عبور</label>
                        <input asp-for="Password" class="form-control" autocomplete="new-password" />
                        <span asp-validation-for="Password" class="form-error"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="ConfirmPassword" class="form-label form-label--required">تکرار رمز</label>
                        <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                        <span asp-validation-for="ConfirmPassword" class="form-error"></span>
                    </div>
                </div>

                <button type="submit" class="btn btn-primary btn-block btn-lg hover-lift">
                    ایجاد حساب رایگان ←
                </button>
            </form>

            <div style="text-align:center;margin-top:var(--space-5);">
                <span style="font-size:var(--text-sm);color:var(--color-text-secondary);">از قبل حساب دارید؟ </span>
                <a asp-action="Login" style="font-size:var(--text-sm);font-weight:var(--font-semibold);color:var(--primary-600);text-decoration:none;">وارد شوید ←</a>
            </div>
        </div>
    </div>

    <div class="auth-visual">
        <div class="auth-visual__content">
            <span class="auth-visual__icon">✨</span>
            <h2 class="auth-visual__title">شروع رایگان، همیشه</h2>
            <p class="auth-visual__sub">به جمع هزاران کاربر راضی ما بپیوندید. بدون کارمزد اولیه، بدون تعهد.</p>
            <div class="auth-trust">
                <div class="auth-trust-item"><span>✓</span> ثبت‌نام سریع و رایگان</div>
                <div class="auth-trust-item"><span>✓</span> دریافت پیشنهاد ظرف چند ساعت</div>
                <div class="auth-trust-item"><span>✓</span> پرداخت فقط پس از رضایت</div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
    <script>
    document.querySelectorAll('.user-type-option').forEach(opt => {
        opt.addEventListener('click', () => {
            document.querySelectorAll('.user-type-option').forEach(o => o.classList.remove('selected'));
            opt.classList.add('selected');
        });
    });
    document.getElementById('opt-customer')?.classList.add('selected');
    </script>
}
