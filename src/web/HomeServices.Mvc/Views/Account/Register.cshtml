@model RegisterViewModel
@using HomeServices.Shared.Enums
@{
    ViewData["Title"] = "ثبت‌نام";
}

<div class="auth-card">
    <div class="text-center mb-4">
        <span class="brand-icon" style="width:60px;height:60px;font-size:1.8rem;">📝</span>
        <h2 class="fw-800 mt-3 mb-1">ساخت حساب جدید</h2>
        <p class="text-muted mb-0">در چند ثانیه ثبت‌نام کنید.</p>
    </div>

    <form asp-action="Register" method="post">
        <input type="hidden" asp-for="ReturnUrl" />
        <div asp-validation-summary="All" class="text-danger mb-3"></div>

        <div class="mb-3">
            <label asp-for="FullName" class="form-label">نام و نام خانوادگی</label>
            <input asp-for="FullName" class="form-control" placeholder="مثلاً علی احمدی" />
            <span asp-validation-for="FullName" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Email" class="form-label">ایمیل</label>
            <input asp-for="Email" class="form-control" placeholder="email@example.com" autocomplete="username" />
            <span asp-validation-for="Email" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label asp-for="PhoneNumber" class="form-label">شماره موبایل</label>
            <input asp-for="PhoneNumber" class="form-control" placeholder="09121234567" />
            <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
        </div>

        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="Password" class="form-label">رمز عبور</label>
                <input asp-for="Password" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="ConfirmPassword" class="form-label">تکرار رمز عبور</label>
                <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
            </div>
        </div>

        <div class="mt-4 mb-3">
            <label class="form-label d-block">نوع حساب</label>
            <div class="row g-2">
                <div class="col-6">
                    <label class="border rounded-3 p-3 d-flex gap-2 cursor-pointer h-100 mb-0 user-type-option">
                        <input asp-for="UserType" type="radio" value="@UserType.Customer" class="form-check-input mt-0" checked />
                        <span>👤 مشتری<br /><small class="text-muted">درخواست خدمات</small></span>
                    </label>
                </div>
                <div class="col-6">
                    <label class="border rounded-3 p-3 d-flex gap-2 cursor-pointer h-100 mb-0 user-type-option">
                        <input asp-for="UserType" type="radio" value="@UserType.Expert" class="form-check-input mt-0" />
                        <span>🔧 کارشناس<br /><small class="text-muted">ارائه خدمات</small></span>
                    </label>
                </div>
            </div>
        </div>

        <button type="submit" class="btn btn-brand w-100 py-2 mt-2">ثبت‌نام</button>
    </form>

    <hr class="my-4" />
    <p class="text-center mb-0">
        از قبل حساب دارید؟ <a asp-action="Login">وارد شوید</a>
    </p>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        document.querySelectorAll('.user-type-option input').forEach(r => {
            r.addEventListener('change', () => {
                document.querySelectorAll('.user-type-option').forEach(o => o.style.borderColor = '#E5E7EB');
                r.closest('.user-type-option').style.borderColor = '#FC5647';
            });
        });
        document.querySelector('.user-type-option input:checked')?.closest('.user-type-option').style.setProperty('border-color', '#FC5647');
    </script>
}
