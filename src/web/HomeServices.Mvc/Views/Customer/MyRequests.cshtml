@model IReadOnlyList<ServiceRequestDto>
@{
    ViewData["Title"] = "درخواست‌های من";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-800 mb-0">درخواست‌های من</h1>
            <p class="text-muted mb-0">@Model.Count درخواست</p>
        </div>
        <a asp-controller="ServiceRequests" asp-action="Create" class="btn btn-brand">+ ثبت درخواست جدید</a>
    </div>

    @if (!Model.Any())
    {
        <div class="empty-state dashboard-card">
            <div class="icon"></div>
            <h5 class="fw-800">هنوز درخواستی ثبت نکرده‌اید</h5>
            <p class="text-muted">اولین درخواست خود را ثبت کنید.</p>
            <a asp-controller="ServiceRequests" asp-action="Create" class="btn btn-brand">ثبت درخواست</a>
        </div>
    }
    else
    {
        <div class="vstack gap-3">
            @foreach (var r in Model)
            {
                <div class="dashboard-card">
                    <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap">
                        <div class="flex-grow-1">
                            <div class="d-flex align-items-center gap-2 mb-1 flex-wrap">
                                <a asp-controller="ServiceRequests" asp-action="Details" asp-route-id="@r.Id" class="fw-800 fs-5">@r.Title</a>
                                <span class="badge-soft @r.Status.StatusClass()">@r.Status.ToDisplay()</span>
                                <span class="badge-soft badge-info-soft">@r.Urgency.ToDisplay()</span>
                            </div>
                            <p class="text-muted small mb-1">@(r.Description.Length > 100 ? r.Description.Substring(0, 100) + "..." : r.Description)</p>
                            <div class="d-flex gap-3 flex-wrap small text-muted">
                                @if (!string.IsNullOrEmpty(r.CategoryName)) { <span>🏷️ @r.CategoryName</span> }
                                <span>💬 @r.ProposalCount پیشنهاد</span>
                                <span>🕒 @r.CreatedAt.ToPersianDate()</span>
                            </div>
                        </div>
                        <div class="d-flex flex-column gap-1">
                            <a asp-controller="ServiceRequests" asp-action="Details" asp-route-id="@r.Id" class="btn btn-sm btn-outline-brand">جزئیات</a>
                            @if ((r.Status == RequestStatus.Open || r.Status == RequestStatus.Quoted) && r.ProposalCount > 0)
                            {
                                <a asp-controller="Proposals" asp-action="Compare" asp-route-requestId="@r.Id" class="btn btn-sm btn-brand">پیشنهادها (@r.ProposalCount)</a>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
