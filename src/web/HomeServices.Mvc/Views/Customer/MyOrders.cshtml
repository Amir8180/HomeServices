@model IReadOnlyList<OrderDto>
@{
    ViewData["Title"] = "سفارش‌های من";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-800 mb-0">سفارش‌های من</h1>
            <p class="text-muted mb-0">@Model.Count سفارش</p>
        </div>
        <a asp-controller="ServiceRequests" asp-action="Create" class="btn btn-brand">+ درخواست جدید</a>
    </div>

    @if (!Model.Any())
    {
        <div class="empty-state dashboard-card">
            <div class="icon">📦</div>
            <h5 class="fw-800">هنوز سفارشی ندارید</h5>
            <p class="text-muted">با ثبت درخواست و انتخاب پیشنهاد، سفارش ایجاد می‌شود.</p>
        </div>
    }
    else
    {
        <div class="table-responsive dashboard-card">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>شماره سفارش</th>
                        <th>درخواست</th>
                        <th>کارشناس</th>
                        <th>مبلغ</th>
                        <th>وضعیت</th>
                        <th>تاریخ</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var o in Model)
                    {
                        <tr>
                            <td><span class="fw-600">@o.OrderNumber</span></td>
                            <td><span class="small">@(o.RequestTitle?.Length > 30 ? o.RequestTitle.Substring(0, 30) + "..." : o.RequestTitle)</span></td>
                            <td>@(o.ExpertBusinessName ?? "-")</td>
                            <td><span class="price-tag small">@o.TotalAmount.ToString("N0") ت</span></td>
                            <td><span class="badge-soft @o.Status.StatusClass()">@o.Status.ToDisplay()</span></td>
                            <td><span class="small text-muted">@o.CreatedAt.ToPersianDate()</span></td>
                            <td><a asp-controller="Orders" asp-action="Details" asp-route-id="@o.Id" class="btn btn-sm btn-outline-brand">مشاهده</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
