@model CreateReviewViewModel
@{
    ViewData["Title"] = "ثبت نظر";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="dashboard-card">
                <div class="text-center mb-4">
                    <h2 class="fw-800 mb-1">⭐ ثبت نظر و امتیاز</h2>
                    <p class="text-muted mb-0">تجربه خود را با کارشناس ارزیابی کنید تا دیگران هم بهره‌مند شوند.</p>
                </div>

                <form asp-action="Create" method="post">
                    <input type="hidden" asp-for="OrderId" />
                    <div asp-validation-summary="All" class="text-danger mb-3"></div>

                    <div class="text-center mb-4">
                        <label asp-for="Rating" class="form-label fw-800">امتیاز کلی</label>
                        <div class="rating-stars fs-1" id="starRating">
                            @for (int i = 1; i <= 5; i++)
                            {
                                <span class="star" data-value="@i" style="cursor:pointer;">☆</span>
                            }
                        </div>
                        <input asp-for="Rating" type="hidden" id="Rating" value="0" />
                    </div>

                    <h6 class="fw-800 mb-3">ارزیابی جزئی (اختیاری)</h6>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="Professionalism" class="form-label">حرفه‌ای بودن (۱-۵)</label>
                            <input asp-for="Professionalism" type="number" min="1" max="5" class="form-control" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Punctuality" class="form-label">وقت‌شناسی (۱-۵)</label>
                            <input asp-for="Punctuality" type="number" min="1" max="5" class="form-control" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Quality" class="form-label">کیفیت کار (۱-۵)</label>
                            <input asp-for="Quality" type="number" min="1" max="5" class="form-control" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Responsiveness" class="form-label">پاسخگویی (۱-۵)</label>
                            <input asp-for="Responsiveness" type="number" min="1" max="5" class="form-control" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Value" class="form-label">ارزش قیمت (۱-۵)</label>
                            <input asp-for="Value" type="number" min="1" max="5" class="form-control" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="ServiceDate" class="form-label">تاریخ انجام کار</label>
                            <input asp-for="ServiceDate" type="date" class="form-control" />
                        </div>
                    </div>

                    <div class="mt-3">
                        <label asp-for="Comment" class="form-label">توضیحات</label>
                        <textarea asp-for="Comment" class="form-control" rows="4" placeholder="تجربه خود را شرح دهید..."></textarea>
                    </div>

                    <div class="d-flex gap-2 mt-4">
                        <button type="submit" class="btn btn-brand btn-lg flex-grow-1">ثبت نظر</button>
                        <a asp-controller="Orders" asp-action="Details" asp-route-id="@Model.OrderId" class="btn btn-outline-brand btn-lg">انصراف</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        (function () {
            var stars = document.querySelectorAll('#starRating .star');
            var input = document.getElementById('Rating');
            function paint(n) {
                stars.forEach(function (s) {
                    s.textContent = parseInt(s.dataset.value) <= n ? '★' : '☆';
                });
            }
            stars.forEach(function (s) {
                s.addEventListener('mouseover', function () { paint(parseInt(s.dataset.value)); });
                s.addEventListener('click', function () { input.value = s.dataset.value; });
            });
            document.getElementById('starRating').addEventListener('mouseleave', function () { paint(parseInt(input.value) || 0); });
        })();
    </script>
}
