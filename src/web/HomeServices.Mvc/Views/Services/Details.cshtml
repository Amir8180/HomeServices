@model ServiceDto
@{
    ViewData["Title"] = Model.Title;
    var related = ViewBag.RelatedServices    as IReadOnlyList<ServiceDto> ?? Array.Empty<ServiceDto>();
    var popular = ViewBag.PopularInCategory  as IReadOnlyList<ServiceDto> ?? Array.Empty<ServiceDto>();
}
@section Styles {
<style>
.svc-detail { padding: var(--space-10) 0 var(--space-20); }
.svc-hero {
    background: linear-gradient(135deg, var(--primary-100) 0%, var(--primary-50) 100%);
    border-radius: var(--radius-3xl);
    height: 320px;
    display: flex; align-items: center; justify-content: center;
    position: relative; overflow: hidden; margin-bottom: var(--space-6);
}
.svc-hero__icon { font-size: 8rem; opacity: .25; }
.svc-hero__badge { position:absolute; top:1rem; right:1rem; }
.svc-hero__cat   { position:absolute; top:1rem; left:1rem; }
.feature-row { display:flex; align-items:flex-start; gap:var(--space-3); padding:var(--space-4) 0; border-bottom:1px solid var(--color-border-subtle); }
.feature-row:last-child { border-bottom:none; }
.feature-icon { width:36px; height:36px; border-radius:var(--radius-lg); background:var(--success-100); display:flex; align-items:center; justify-content:center; flex-shrink:0; color:var(--success-700); font-weight:var(--font-bold); }
/* Sticky booking card */
.booking-card {
    background: white; border:1px solid var(--color-border-subtle);
    border-radius: var(--radius-2xl); padding: var(--space-7);
    box-shadow: var(--shadow-xl);
    position: sticky; top: 88px;
}
.booking-card__price { font-size:var(--text-5xl); font-weight:var(--font-black); color:var(--primary-700); letter-spacing:-.04em; line-height:1; }
.booking-card__currency { font-size:var(--text-xl); color:var(--color-text-secondary); font-weight:var(--font-normal); }
.booking-meta { display:flex; flex-direction:column; gap:var(--space-3); margin:var(--space-5) 0; }
.booking-meta__row { display:flex; justify-content:space-between; align-items:center; font-size:var(--text-sm); }
.booking-meta__label { color:var(--color-text-secondary); }
.booking-meta__value { font-weight:var(--font-semibold); color:var(--color-text-primary); }
.trust-list { display:flex; flex-direction:column; gap:var(--space-2); margin-top:var(--space-5); }
.trust-item { display:flex; align-items:center; gap:var(--space-2); font-size:var(--text-xs); color:var(--color-text-secondary); }
.trust-item__dot { width:6px; height:6px; border-radius:50%; background:var(--success-500); flex-shrink:0; }
/* Accordion FAQ */
.faq-item { border-bottom:1px solid var(--color-border-subtle); }
.faq-trigger { width:100%; padding:var(--space-4) 0; display:flex; justify-content:space-between; align-items:center; background:none; border:none; cursor:pointer; font-size:var(--text-sm); font-weight:var(--font-semibold); color:var(--gray-900); font-family:inherit; text-align:right; }
.faq-trigger__arrow { transition:transform .25s; flex-shrink:0; color:var(--color-text-tertiary); }
.faq-item.open .faq-trigger__arrow { transform:rotate(180deg); }
.faq-content { max-height:0; overflow:hidden; transition:max-height .3s var(--ease-smooth); }
.faq-content__inner { padding:0 0 var(--space-4); font-size:var(--text-sm); color:var(--color-text-secondary); line-height:var(--leading-relaxed); }
</style>
}

<div class="svc-detail">
    <div class="hs-container">
        <nav style="font-size:var(--text-sm);color:var(--color-text-tertiary);margin-bottom:var(--space-6);">
            <a asp-controller="Home"     asp-action="Index"  style="color:inherit;text-decoration:none;">خانه</a> /
            <a asp-controller="Services" asp-action="Index"  style="color:inherit;text-decoration:none;">خدمات</a> /
            <span>@Model.Title</span>
        </nav>

        <div class="row g-8" style="--bs-gutter-x:2.5rem;align-items:flex-start;">

            @* ── Main column ── *@
            <div class="col-lg-8">
                <div class="svc-hero" data-reveal="scale">
                    <span class="svc-hero__icon">🛠️</span>
                    @if (Model.IsFixedPrice)
                    {
                        <span class="badge badge--success svc-hero__badge">✓ قیمت ثابت</span>
                    }
                    @if (!string.IsNullOrEmpty(Model.CategoryName))
                    {
                        <span class="badge badge--primary svc-hero__cat">@Model.CategoryName</span>
                    }
                </div>

                <div style="background:white;border:1px solid var(--color-border-subtle);border-radius:var(--radius-2xl);padding:var(--space-8);margin-bottom:var(--space-5);" data-reveal="up">
                    <h1 style="font-size:clamp(1.5rem,3vw,2.25rem);font-weight:var(--font-black);letter-spacing:-.03em;margin-bottom:var(--space-3);">@Model.Title</h1>
                    <div style="display:flex;flex-wrap:wrap;gap:var(--space-5);font-size:var(--text-sm);color:var(--color-text-secondary);margin-bottom:var(--space-5);">
                        @if (Model.EstimatedDurationMinutes.HasValue)
                        {
                            <span>@(Model.EstimatedDurationMinutes.Value/60) ساعت تخمینی</span>
                        }
                        <span>🏷️ @(Model.CategoryName ?? "خدمات عمومی")</span>
                        <span>💳 @(Model.IsFixedPrice ? "قیمت ثابت" : "قیمت توافقی")</span>
                    </div>
                    @if (!string.IsNullOrEmpty(Model.Description))
                    {
                        <p style="font-size:var(--text-base);color:var(--color-text-secondary);line-height:var(--leading-relaxed);margin:0;">@Model.Description</p>
                    }
                </div>

                @* What's included *@
                <div style="background:white;border:1px solid var(--color-border-subtle);border-radius:var(--radius-2xl);padding:var(--space-8);margin-bottom:var(--space-5);" data-reveal="up">
                    <h3 style="font-size:var(--text-xl);font-weight:var(--font-bold);margin-bottom:var(--space-5);">✨ این خدمت شامل چیست؟</h3>
                    @foreach (var f in new[]{("کارشناسان تأییدشده","کلیه متخصصان دارای مدارک و سوابق معتبر"),("ضمانت کیفیت","رضایت کامل یا بازگشت وجه"),("پشتیبانی ۲۴ ساعته","همواره در کنار شما هستیم"),("پرداخت آسان","کارت به کارت با تأیید پشتیبانی")})
                    {
                        <div class="feature-row">
                            <div class="feature-icon">✓</div>
                            <div>
                                <div style="font-weight:var(--font-semibold);font-size:var(--text-sm);margin-bottom:var(--space-0-5);">@f.Item1</div>
                                <div style="font-size:var(--text-xs);color:var(--color-text-secondary);">@f.Item2</div>
                            </div>
                        </div>
                    }
                </div>

                @* FAQ *@
                <div style="background:white;border:1px solid var(--color-border-subtle);border-radius:var(--radius-2xl);padding:var(--space-8);" data-reveal="up" data-accordion>
                    <h3 style="font-size:var(--text-xl);font-weight:var(--font-bold);margin-bottom:var(--space-2);">❓ سؤالات متداول</h3>
                    @foreach (var qa in new[]{
                        ("چقدر طول می‌کشد تا پیشنهاد بگیرم؟","معمولاً ظرف چند ساعت اولین پیشنهادها را دریافت می‌کنید."),
                        ("آیا قیمت قابل مذاکره است؟","بله، می‌توانید با کارشناس مستقیماً مذاکره کنید."),
                        ("اگر از کیفیت راضی نباشم چطور؟","ضمانت کیفیت داریم. با پشتیبانی تماس بگیرید تا مشکل حل شود.")
                    })
                    {
                        <div class="faq-item" data-accordion-item>
                            <button class="faq-trigger" data-accordion-trigger type="button">
                                <span>@qa.Item1</span>
                                <span class="faq-trigger__arrow">⌄</span>
                            </button>
                            <div class="faq-content" data-accordion-content>
                                <div class="faq-content__inner">@qa.Item2</div>
                            </div>
                        </div>
                    }
                </div>
            </div>

            @* ── Booking Sidebar ── *@
            <div class="col-lg-4" data-reveal="left">
                <div class="booking-card">
                    @if (Model.BasePrice.HasValue)
                    {
                        <div style="margin-bottom:var(--space-2);">
                            <div style="font-size:var(--text-xs);color:var(--color-text-tertiary);margin-bottom:var(--space-1);">شروع از</div>
                            <div style="display:flex;align-items:baseline;gap:var(--space-2);">
                                <span class="booking-card__price">@Model.BasePrice.Value.ToString("N0")</span>
                                <span class="booking-card__currency">تومان</span>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div style="font-size:var(--text-2xl);font-weight:var(--font-bold);color:var(--primary-700);margin-bottom:var(--space-2);">قیمت توافقی</div>
                        <div style="font-size:var(--text-xs);color:var(--color-text-tertiary);margin-bottom:var(--space-4);">پس از دریافت پیشنهادها تعیین می‌شود</div>
                    }

                    <a asp-controller="ServiceRequests" asp-action="Create" asp-route-serviceId="@Model.Id"
                       class="btn btn-primary btn-block btn-lg hover-lift" style="margin-top:var(--space-4);">
                        📝 ثبت درخواست رایگان
                    </a>
                    <div style="text-align:center;font-size:var(--text-xs);color:var(--color-text-tertiary);margin-top:var(--space-2);">بدون پرداخت اولیه</div>

                    <div class="booking-meta">
                        @if (Model.EstimatedDurationMinutes.HasValue)
                        {
                            <div class="booking-meta__row">
                                <span class="booking-meta__label">زمان تخمینی</span>
                                <span class="booking-meta__value">@(Model.EstimatedDurationMinutes.Value/60) ساعت</span>
                            </div>
                        }
                        <div class="booking-meta__row">
                            <span class="booking-meta__label">🏷️ دسته‌بندی</span>
                            <span class="booking-meta__value">@(Model.CategoryName ?? "عمومی")</span>
                        </div>
                        <div class="booking-meta__row">
                            <span class="booking-meta__label">💳 نوع قیمت</span>
                            <span class="booking-meta__value">@(Model.IsFixedPrice ? "ثابت" : "توافقی")</span>
                        </div>
                    </div>

                    <div style="height:1px;background:var(--color-border-subtle);margin:var(--space-5) 0;"></div>
                    <div class="trust-list">
                        @foreach (var t in new[]{"ضمانت کیفیت کار","پرداخت امن بانکی","پشتیبانی ۲۴/۷","کارشناسان تأییدشده"})
                        {
                            <div class="trust-item"><span class="trust-item__dot"></span>@t</div>
                        }
                    </div>
                </div>
            </div>
        </div>

        @* ── Related Services ── *@
        @if (popular.Any())
        {
            <div style="margin-top:var(--space-20);">
                <div style="display:flex;justify-content:space-between;align-items:flex-end;margin-bottom:var(--space-8);">
                    <h3 style="font-size:var(--text-2xl);font-weight:var(--font-bold);margin:0;" data-reveal="up">خدمات مرتبط</h3>
                    <a asp-controller="Services" asp-action="Index" asp-route-categoryId="@Model.CategoryId" class="btn btn-secondary" data-reveal="up">مشاهده همه ←</a>
                </div>
                <div class="row g-4 row-cols-1 row-cols-md-3" data-stagger>
                    @foreach (var svc in popular.Take(3))
                    {
                        <div class="col" data-reveal="up">
                            <div class="service-card hover-lift" style="cursor:pointer" onclick="window.location='@Url.Action("Details","Services",new{id=svc.Id})'">
                                <div class="service-card__image"><span class="service-card__image-icon">🛠️</span></div>
                                <div class="service-card__body">
                                    <div class="service-card__category">@(svc.CategoryName ?? "خدمات")</div>
                                    <a asp-action="Details" asp-route-id="@svc.Id" class="service-card__title">@svc.Title</a>
                                    <div class="service-card__footer">
                                        <div class="service-card__price">@(svc.BasePrice.HasValue ? svc.BasePrice.Value.ToString("N0")+" ت" : "توافقی")</div>
                                        <a asp-action="Details" asp-route-id="@svc.Id" class="btn btn-secondary btn-sm" onclick="event.stopPropagation()">مشاهده</a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
</div>
