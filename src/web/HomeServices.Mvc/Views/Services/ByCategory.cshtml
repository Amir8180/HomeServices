@model IReadOnlyList<ServiceDto>
@using HomeServices.Application.Dtos
@{
    ViewData["Title"] = (ViewBag.Category as CategoryDto)?.Name ?? "خدمات دسته‌بندی";
    var category = ViewBag.Category as CategoryDto;
}

<div class="container py-4">
    <nav aria-label="breadcrumb" class="small mb-3">
        <a asp-controller="Home" asp-action="Index">خانه</a> /
        <a asp-controller="Services" asp-action="Index">خدمات</a> /
        <span class="text-muted">@(category?.Name)</span>
    </nav>

    <h1 class="fw-800 mb-1">@(category?.Name ?? "خدمات")</h1>
    @if (category?.Description != null)
    {
        <p class="text-muted mb-4">@category.Description</p>
    }

    @if (!Model.Any())
    {
        <div class="empty-state dashboard-card">
            <div class="icon">🔍</div>
            <h5 class="fw-800">خدمتی در این دسته‌بندی یافت نشد</h5>
            <a asp-controller="ServiceRequests" asp-action="Create" asp-route-categoryId="@category?.Id" class="btn btn-brand mt-2">ثبت درخواست عمومی</a>
        </div>
    }
    else
    {
        <div class="row g-3 row-cols-1 row-cols-md-2 row-cols-lg-3">
            @foreach (var svc in Model)
            {
                <div class="col">
                    <div class="card-service">
                        <div class="card-thumb">🛠️</div>
                        <div class="card-body">
                            <a asp-action="Details" asp-route-id="@svc.Id" class="card-title-link">@svc.Title</a>
                            <p class="card-meta mt-1 mb-2">@svc.CategoryName</p>
                            <div class="d-flex justify-content-between align-items-center">
                                @if (svc.BasePrice.HasValue)
                                {
                                    <span class="price-tag">@svc.BasePrice.Value.ToString("N0") ت</span>
                                }
                                else
                                {
                                    <span class="card-meta">توافقی</span>
                                }
                                <a asp-controller="ServiceRequests" asp-action="Create" asp-route-serviceId="@svc.Id" class="btn btn-sm btn-outline-brand">درخواست</a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
