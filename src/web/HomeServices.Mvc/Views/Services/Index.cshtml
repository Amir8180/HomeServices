@model PagedResult<ServiceDto>
@using HomeServices.Shared.Common
@{
    ViewData["Title"] = "خدمات";
    var categories = ViewBag.Categories as IReadOnlyList<CategoryDto> ?? Array.Empty<CategoryDto>();
    var filter = ViewBag.CurrentFilter as ServiceFilterDto ?? new ServiceFilterDto();
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-end mb-4">
        <div>
            <h1 class="fw-800 mb-0">همه خدمات</h1>
            <p class="text-muted mb-0">@Model.TotalCount خدمت یافت شد</p>
        </div>
    </div>

    <div class="row g-4">
        @* Sidebar filters *@
        <div class="col-lg-3">
            <div class="dashboard-card">
                <h6 class="fw-800 mb-3">🔍 فیلترها</h6>
                <form method="get" asp-action="Index" class="vstack gap-3">
                    <div>
                        <label class="form-label small fw-600">جستجو</label>
                        <input type="text" name="search" value="@filter.SearchTerm" class="form-control form-control-sm" placeholder="نام خدمت..." />
                    </div>
                    <div>
                        <label class="form-label small fw-600">دسته‌بندی</label>
                        <select name="categoryId" class="form-select form-select-sm" asp-items="@(new SelectList(categories, "Id", "Name", filter.CategoryId))">
                            <option value="">همه</option>
                        </select>
                    </div>
                    <div class="row g-2">
                        <div class="col-6">
                            <label class="form-label small fw-600">حداقل قیمت</label>
                            <input type="number" name="minPrice" value="@filter.MinPrice" class="form-control form-control-sm" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-600">حداکثر قیمت</label>
                            <input type="number" name="maxPrice" value="@filter.MaxPrice" class="form-control form-control-sm" />
                        </div>
                    </div>
                    <div>
                        <label class="form-label small fw-600">مرتب‌سازی</label>
                        <select name="sortBy" class="form-select form-select-sm">
                            <option value="" selected="@(string.IsNullOrEmpty(filter.SortBy))">پیش‌فرض</option>
                            <option value="price" selected="@(filter.SortBy == "price")">ارزان‌ترین</option>
                            <option value="pricedesc" selected="@(filter.SortBy == "pricedesc")">گران‌ترین</option>
                            <option value="name" selected="@(filter.SortBy == "name")">الفبایی</option>
                        </select>
                    </div>
                    <button type="submit" class="btn btn-brand btn-sm">اعمال فیلتر</button>
                    <a asp-action="Index" class="btn btn-outline-brand btn-sm">پاک کردن</a>
                </form>
            </div>
        </div>

        @* Services grid *@
        <div class="col-lg-9">
            @if (!Model.Items.Any())
            {
                <div class="empty-state dashboard-card">
                    <div class="icon">🔍</div>
                    <h5 class="fw-800">خدمتی یافت نشد</h5>
                    <p class="text-muted">فیلترها را تغییر دهید یا همه خدمات را ببینید.</p>
                </div>
            }
            else
            {
                <div class="row g-3 row-cols-1 row-cols-md-2 row-cols-xl-3">
                    @foreach (var svc in Model.Items)
                    {
                        <div class="col">
                            <div class="card-service">
                                <div class="card-thumb">🛠️</div>
                                <div class="card-body">
                                    <a asp-action="Details" asp-route-id="@svc.Id" class="card-title-link">@svc.Title</a>
                                    <p class="card-meta mt-1 mb-2">
                                        <span class="badge-soft badge-brand">@(svc.CategoryName ?? "عمومی")</span>
                                    </p>
                                    <p class="small text-muted">@(string.IsNullOrEmpty(svc.Description) ? "" : (svc.Description.Length > 80 ? svc.Description.Substring(0, 80) + "..." : svc.Description))</p>
                                    <div class="d-flex justify-content-between align-items-center mt-2">
                                        @if (svc.BasePrice.HasValue)
                                        {
                                            <span class="price-tag">@svc.BasePrice.Value.ToString("N0") ت</span>
                                        }
                                        else
                                        {
                                            <span class="card-meta">توافقی</span>
                                        }
                                        <a asp-controller="ServiceRequests" asp-action="Create" asp-route-serviceId="@svc.Id" class="btn btn-sm btn-outline-brand">درخواست</a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                @* Pagination *@
                @if (Model.TotalPages > 1)
                {
                    <nav class="mt-4">
                        <ul class="pagination justify-content-center">
                            <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                                <a class="page-link" asp-action="Index" asp-route-page="@(Model.PageNumber-1)" asp-route-search="@filter.SearchTerm" asp-route-categoryId="@filter.CategoryId">→ قبلی</a>
                            </li>
                            @for (int i = 1; i <= Model.TotalPages; i++)
                            {
                                <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                                    <a class="page-link" asp-action="Index" asp-route-page="@i" asp-route-search="@filter.SearchTerm" asp-route-categoryId="@filter.CategoryId">@i</a>
                                </li>
                            }
                            <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                                <a class="page-link" asp-action="Index" asp-route-page="@(Model.PageNumber+1)" asp-route-search="@filter.SearchTerm" asp-route-categoryId="@filter.CategoryId">بعدی ←</a>
                            </li>
                        </ul>
                    </nav>
                }
            }
        </div>
    </div>
</div>
