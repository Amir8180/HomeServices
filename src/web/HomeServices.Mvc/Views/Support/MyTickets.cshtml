@using HomeServices.Domain.Enums
@using HomeServices.Application.Dtos
@model IReadOnlyList<SupportTicketDto>
@using HomeServices.Mvc.Extensions
@{
    ViewData["Title"] = "تیکت‌های پشتیبانی";
    Func<string, Microsoft.AspNetCore.Html.HtmlString> Svg = (paths) => new Microsoft.AspNetCore.Html.HtmlString(
        $"<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\" style=\"width:1em;height:1em;display:inline-block;vertical-align:-0.15em;flex-shrink:0;\">{paths}</svg>"
    );
    var icTicket = "<path d=\"M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z\"/><line x1=\"3\" y1=\"13\" x2=\"21\" y2=\"13\"/>";
    var icPlus   = "<circle cx=\"12\" cy=\"12\" r=\"10\"/><line x1=\"12\" y1=\"8\" x2=\"12\" y2=\"16\"/><line x1=\"8\" y1=\"12\" x2=\"16\" y2=\"12\"/>";
    var icClock  = "<circle cx=\"12\" cy=\"12\" r=\"10\"/><polyline points=\"12 6 12 12 16 14\"/>";
    var icMsg    = "<path d=\"M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z\"/>";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h1 class="fw-800 mb-0">@Html.Raw(Svg(icTicket)) تیکت‌های پشتیبانی</h1>
            <p class="text-muted mb-0">@Model.Count تیکت</p>
        </div>
        <a asp-action="Create" class="btn btn-brand">+ ثبت تیکت جدید</a>
    </div>

    @if (!Model.Any())
    {
        <div class="empty-state dashboard-card">
            <div class="icon">@Html.Raw(Svg(icTicket))</div>
            <h5 class="fw-800">هنوز تیکتی ثبت نکرده‌اید</h5>
            <p class="text-muted">اگر موردی نیاز به بررسی تیم پشتیبانی دارد، آن را برای ما ثبت کنید.</p>
            <a asp-action="Create" class="btn btn-brand">ثبت تیکت جدید</a>
        </div>
    }
    else
    {
        <div class="vstack gap-3">
            @foreach (var t in Model)
            {
                <div class="dashboard-card">
                    <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap">
                        <div class="flex-grow-1">
                            <div class="d-flex align-items-center gap-2 mb-1 flex-wrap">
                                <a asp-action="Details" asp-route-id="@t.Id" class="fw-800 fs-5 text-decoration-none">@t.Subject</a>
                                <span class="badge-soft @t.Status.TicketStatusClass()">@t.Status.ToDisplay()</span>
                                <span class="badge-soft @t.Priority.PriorityClass()">اولویت: @t.Priority.ToDisplay()</span>
                            </div>
                            <div class="d-flex gap-3 flex-wrap small text-muted">
                                <span class="fw-700">@t.TicketNumber</span>
                                <span>@t.Category.ToDisplay()</span>
                                @if (!string.IsNullOrEmpty(t.OrderNumber))
                                {
                                    <a asp-controller="Orders" asp-action="Details" asp-route-id="@t.OrderId" class="text-decoration-none">سفارش @t.OrderNumber</a>
                                }
                                <span>@Html.Raw(Svg(icClock)) آخرین فعالیت: @t.LastActivityAt.ToPersianDate()</span>
                                <span>@Html.Raw(Svg(icMsg)) @t.MessageCount پیام</span>
                            </div>
                        </div>
                        <a asp-action="Details" asp-route-id="@t.Id" class="btn btn-sm btn-outline-brand">مشاهده گفت‌وگو</a>
                    </div>
                </div>
            }
        </div>
    }
</div>
