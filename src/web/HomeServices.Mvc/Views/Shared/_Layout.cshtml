@using System.Security.Claims
@using HomeServices.Shared.Enums
@using Microsoft.AspNetCore.Html
@inject HomeServices.Application.Interfaces.ISiteSettingService SiteSettings
@{
    var settings    = await SiteSettings.GetAllAsDictionaryAsync(Context.RequestAborted);
    var siteName    = settings.TryGetValue("Site.Name",    out var sn) && !string.IsNullOrWhiteSpace(sn) ? sn : "خدمات منزل";
    var tagline     = settings.TryGetValue("Site.Tagline", out var tl) ? tl : "متخصصان معتبر برای خانه شما";
    var phone       = settings.TryGetValue("Contact.Phone",  out var ph) ? ph : "";
    var email       = settings.TryGetValue("Contact.Email",  out var em) ? em : "";
    var instagram   = settings.TryGetValue("Social.Instagram", out var ig) ? ig : "#";
    var telegram    = settings.TryGetValue("Social.Telegram",  out var tg) ? tg : "#";

    var user            = Context.User;
    var isAuthenticated = user?.Identity?.IsAuthenticated ?? false;
    var fullName        = user?.FindFirst(ClaimTypes.Name)?.Value ?? "";
    var avatarLetter    = fullName.Length > 0 ? fullName[0].ToString() : "U";
    var isCustomer      = user?.IsInRole("Customer") ?? false;
    var isExpert        = user?.IsInRole("Expert")   ?? false;
    var isAdmin         = user?.IsInRole("Admin")    ?? false;

    var currentPath = Context.Request.Path.Value ?? "/";

    // ── Inline SVG icon library ──────────────────────────────
    // Only icons actually used in this layout

    // Icon path definitions
    var icHome        = "<path d=\"M3 9.5L12 3l9 6.5V20a1 1 0 01-1 1H4a1 1 0 01-1-1V9.5z\"/><path d=\"M9 21V12h6v9\"/>";
    var icUsers       = "<path d=\"M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2\"/><circle cx=\"9\" cy=\"7\" r=\"4\"/><path d=\"M23 21v-2a4 4 0 00-3-3.87M16 3.13a4 4 0 010 7.75\"/>";
    var icWrench      = "<path d=\"M14.7 6.3a1 1 0 000 1.4l1.6 1.6a1 1 0 001.4 0l3.77-3.77a6 6 0 01-7.94 7.94l-6.91 6.91a2.12 2.12 0 01-3-3l6.91-6.91a6 6 0 017.94-7.94l-3.76 3.76z\"/>";
    var icQuestion    = "<circle cx=\"12\" cy=\"12\" r=\"10\"/><path d=\"M9.09 9a3 3 0 015.83 1c0 2-3 3-3 3M12 17h.01\"/>";
    var icSettings    = "<circle cx=\"12\" cy=\"12\" r=\"3\"/><path d=\"M19.4 15a1.65 1.65 0 00.33 1.82l.06.06a2 2 0 010 2.83 2 2 0 01-2.83 0l-.06-.06a1.65 1.65 0 00-1.82-.33 1.65 1.65 0 00-1 1.51V21a2 2 0 01-4 0v-.09A1.65 1.65 0 009 19.4a1.65 1.65 0 00-1.82.33l-.06.06a2 2 0 01-2.83-2.83l.06-.06A1.65 1.65 0 004.68 15a1.65 1.65 0 00-1.51-1H3a2 2 0 010-4h.09A1.65 1.65 0 004.6 9a1.65 1.65 0 00-.33-1.82l-.06-.06a2 2 0 012.83-2.83l.06.06A1.65 1.65 0 009 4.68a1.65 1.65 0 001-1.51V3a2 2 0 014 0v.09a1.65 1.65 0 001 1.51 1.65 1.65 0 001.82-.33l.06-.06a2 2 0 012.83 2.83l-.06.06A1.65 1.65 0 0019.4 9a1.65 1.65 0 001.51 1H21a2 2 0 010 4h-.09a1.65 1.65 0 00-1.51 1z\"/>";
    var icDashboard   = "<rect x=\"3\" y=\"3\" width=\"7\" height=\"7\" rx=\"1\"/><rect x=\"3\" y=\"13\" width=\"7\" height=\"8\" rx=\"1\"/><rect x=\"13\" y=\"3\" width=\"8\" height=\"4\" rx=\"1\"/><rect x=\"13\" y=\"10\" width=\"8\" height=\"11\" rx=\"1\"/>";
    var icClipboard   = "<path d=\"M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2\"/><rect x=\"9\" y=\"3\" width=\"6\" height=\"4\" rx=\"1\"/><path d=\"M9 12h6M9 16h4\"/>";
    var icPackage     = "<path d=\"M21 16V8a2 2 0 00-1-1.73l-7-4a2 2 0 00-2 0l-7 4A2 2 0 003 8v8a2 2 0 001 1.73l7 4a2 2 0 002 0l7-4A2 2 0 0021 16z\"/><polyline points=\"3.27 6.96 12 12.01 20.73 6.96\"/><line x1=\"12\" y1=\"22.08\" x2=\"12\" y2=\"12\"/>";
    var icSearch      = "<circle cx=\"11\" cy=\"11\" r=\"8\"/><path d=\"M21 21l-4.35-4.35\"/>";
    var icMessage     = "<path d=\"M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z\"/>";
    var icHammer      = "<path d=\"M15 12l-8.5 8.5a2.12 2.12 0 01-3-3L12 9\"/><path d=\"M17.64 15L22 10.64\"/><path d=\"M20.91 11.7L16.3 7.09a2 2 0 00-2.83 0L11 9.5l4.5 4.5 5.41-2.3z\"/>";
    var icStar        = "<polygon points=\"12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2\"/>";
    var icUser        = "<path d=\"M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2\"/><circle cx=\"12\" cy=\"7\" r=\"4\"/>";
    var icLogOut      = "<path d=\"M9 21H5a2 2 0 01-2-2V5a2 2 0 012-2h4\"/><polyline points=\"16 17 21 12 16 7\"/><line x1=\"21\" y1=\"12\" x2=\"9\" y2=\"12\"/>";
    var icKey         = "<path d=\"M21 2l-2 2m-7.61 7.61a5.5 5.5 0 11-7.778 7.778 5.5 5.5 0 017.777-7.777zm0 0L15.5 7.5m0 0l3 3L22 7l-3-3m-3.5 3.5L19 4\"/>";
    var icSparkle     = "<path d=\"M12 3v1m0 16v1M4.22 4.22l.7.7m12.16 12.16l.7.7M3 12h1m16 0h1M4.22 19.78l.7-.7M18.36 5.64l.7-.7\"/><circle cx=\"12\" cy=\"12\" r=\"4\"/>";
    var icInstagram   = "<rect x=\"2\" y=\"2\" width=\"20\" height=\"20\" rx=\"5\" ry=\"5\"/><path d=\"M16 11.37A4 4 0 1112.63 8 4 4 0 0116 11.37z\"/><line x1=\"17.5\" y1=\"6.5\" x2=\"17.51\" y2=\"6.5\"/>";
    var icSend        = "<line x1=\"22\" y1=\"2\" x2=\"11\" y2=\"13\"/><polygon points=\"22 2 15 22 11 13 2 9 22 2\"/>";
    var icPhone       = "<path d=\"M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07A19.5 19.5 0 013.07 9.81a19.79 19.79 0 01-3.07-8.66A2 2 0 012 1h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L6.09 8.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z\"/>";

    // Helper: render SVG inline
    Func<string, HtmlString> Svg = (paths) => new HtmlString(
        $"<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\" style=\"width:1em;height:1em;display:inline-block;vertical-align:-0.15em;flex-shrink:0;\">{paths}</svg>"
    );
}
<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="@tagline" />
    <title>@ViewData["Title"] - @siteName</title>
    <link href="https://cdn.jsdelivr.net/gh/rastikerdar/vazirmatn@v33.003/Vazirmatn-font-face.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.rtl.min.css" />
    <link rel="stylesheet" href="~/css/design-system.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components.css"    asp-append-version="true" />
    <link rel="stylesheet" href="~/css/animations.css"    asp-append-version="true" />
    <link rel="stylesheet" href="~/css/icons.css"         asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css"          asp-append-version="true" />
    <link rel="stylesheet" href="~/HomeServices.Mvc.styles.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>

@* =========================================================
   NAVIGATION
   ========================================================= *@
<nav class="hs-nav" role="navigation" aria-label="ناوبری اصلی">
    <div class="hs-container">
        <div class="hs-nav__inner">

            <a class="hs-nav__logo" asp-controller="Home" asp-action="Index" aria-label="@siteName">
                <div class="hs-nav__logo-icon">@Html.Raw(Svg(icHome))</div>
                <span class="hs-nav__logo-text">@siteName</span>
            </a>

            <ul class="hs-nav__links" role="list">
                <li><a class="hs-nav__link @(currentPath == "/" ? "active" : "")"
                       asp-controller="Home" asp-action="Index">خانه</a></li>
                <li><a class="hs-nav__link @(currentPath.StartsWith("/Services") ? "active" : "")"
                       asp-controller="Services" asp-action="Index">خدمات</a></li>
                <li><a class="hs-nav__link @(currentPath.StartsWith("/Experts") ? "active" : "")"
                       asp-controller="Experts" asp-action="Index">کارشناسان</a></li>
                <li><a class="hs-nav__link @(currentPath.Contains("HowItWorks") ? "active" : "")"
                       asp-controller="Home" asp-action="HowItWorks">نحوه کار</a></li>
                @if (isAdmin)
                {
                    <li><a class="hs-nav__link"
                           asp-area="Admin" asp-controller="Dashboard" asp-action="Index">پنل مدیریت</a></li>
                }
            </ul>

            <div class="hs-nav__actions">
                @if (isAuthenticated)
                {
                    @if (isCustomer)
                    {
                        <a class="btn btn-ghost btn-sm" style="display:none;" id="nav-dashboard-link"
                           asp-controller="Customer" asp-action="Dashboard">داشبورد</a>
                    }
                    else if (isExpert)
                    {
                        <a class="btn btn-ghost btn-sm" style="display:none;" id="nav-dashboard-link"
                           asp-controller="Expert" asp-action="Dashboard">داشبورد</a>
                    }

                    <div class="hs-dropdown">
                        <button class="hs-nav__user-btn" data-dd-toggle aria-haspopup="true" aria-expanded="false">
                            <span class="hs-nav__avatar">@avatarLetter</span>
                            <span class="d-none d-md-inline">@fullName</span>
                            <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true" style="flex-shrink:0">
                                <path d="M2 4l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                        </button>
                        <div class="hs-dropdown__menu">
                            @if (isCustomer)
                            {
                                <a class="hs-dropdown__item" asp-controller="Customer" asp-action="Dashboard">@Html.Raw(Svg(icDashboard)) داشبورد</a>
                                <a class="hs-dropdown__item" asp-controller="Customer" asp-action="MyRequests">@Html.Raw(Svg(icClipboard)) درخواست‌های من</a>
                                <a class="hs-dropdown__item" asp-controller="Customer" asp-action="MyOrders">@Html.Raw(Svg(icPackage)) سفارش‌های من</a>
                            }
                            else if (isExpert)
                            {
                                <a class="hs-dropdown__item" asp-controller="Expert" asp-action="Dashboard">@Html.Raw(Svg(icDashboard)) داشبورد</a>
                                <a class="hs-dropdown__item" asp-controller="Expert" asp-action="OpenRequests">@Html.Raw(Svg(icSearch)) درخواست‌های باز</a>
                                <a class="hs-dropdown__item" asp-controller="Expert" asp-action="MyProposals">@Html.Raw(Svg(icMessage)) پیشنهادهای من</a>
                                <a class="hs-dropdown__item" asp-controller="Expert" asp-action="MyJobs">@Html.Raw(Svg(icHammer)) کارهای من</a>
                                <a class="hs-dropdown__item" asp-controller="Expert" asp-action="MyReviews">@Html.Raw(Svg(icStar)) نظرات</a>
                            }
                            <div class="hs-dropdown__divider"></div>
                            <a class="hs-dropdown__item" asp-controller="Account" asp-action="Profile">@Html.Raw(Svg(icUser)) پروفایل من</a>
                            <div class="hs-dropdown__divider"></div>
                            <form asp-controller="Account" asp-action="Logout" method="post" style="margin:0">
                                <button type="submit" class="hs-dropdown__item hs-dropdown__item--danger" style="width:100%">
                                    @Html.Raw(Svg(icLogOut)) خروج از حساب
                                </button>
                            </form>
                        </div>
                    </div>
                }
                else
                {
                    <a class="btn btn-secondary btn-sm" asp-controller="Account" asp-action="Login">ورود</a>
                    <a class="btn btn-primary btn-sm" asp-controller="Account" asp-action="Register">ثبت‌نام رایگان</a>
                }

                <button class="hs-nav__menu-btn" aria-label="منو" aria-expanded="false" aria-controls="mobile-drawer">
                    <span></span><span></span><span></span>
                </button>
            </div>

        </div>
    </div>
</nav>

@* =========================================================
   MOBILE DRAWER
   ========================================================= *@
<div class="hs-nav__drawer" id="mobile-drawer" role="dialog" aria-label="منوی موبایل">
    <a class="hs-nav__drawer-link" asp-controller="Home"     asp-action="Index">@Html.Raw(Svg(icHome)) خانه</a>
    <a class="hs-nav__drawer-link" asp-controller="Services" asp-action="Index">@Html.Raw(Svg(icWrench)) خدمات</a>
    <a class="hs-nav__drawer-link" asp-controller="Experts"  asp-action="Index">@Html.Raw(Svg(icUsers)) کارشناسان</a>
    <a class="hs-nav__drawer-link" asp-controller="Home"     asp-action="HowItWorks">@Html.Raw(Svg(icQuestion)) نحوه کار</a>
    @if (isAdmin)
    {
        <a class="hs-nav__drawer-link" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">@Html.Raw(Svg(icSettings)) پنل مدیریت</a>
    }
    <div style="height:1px;background:var(--color-border-subtle);margin:0.5rem 0;"></div>
    @if (isAuthenticated)
    {
        @if (isCustomer)
        {
            <a class="hs-nav__drawer-link" asp-controller="Customer" asp-action="Dashboard">@Html.Raw(Svg(icDashboard)) داشبورد</a>
            <a class="hs-nav__drawer-link" asp-controller="Customer" asp-action="MyRequests">@Html.Raw(Svg(icClipboard)) درخواست‌های من</a>
            <a class="hs-nav__drawer-link" asp-controller="Customer" asp-action="MyOrders">@Html.Raw(Svg(icPackage)) سفارش‌های من</a>
        }
        else if (isExpert)
        {
            <a class="hs-nav__drawer-link" asp-controller="Expert" asp-action="Dashboard">@Html.Raw(Svg(icDashboard)) داشبورد</a>
            <a class="hs-nav__drawer-link" asp-controller="Expert" asp-action="OpenRequests">@Html.Raw(Svg(icSearch)) درخواست‌های باز</a>
            <a class="hs-nav__drawer-link" asp-controller="Expert" asp-action="MyProposals">@Html.Raw(Svg(icMessage)) پیشنهادهای من</a>
            <a class="hs-nav__drawer-link" asp-controller="Expert" asp-action="MyJobs">@Html.Raw(Svg(icHammer)) کارهای من</a>
        }
        <a class="hs-nav__drawer-link" asp-controller="Account" asp-action="Profile">@Html.Raw(Svg(icUser)) پروفایل من</a>
        <div style="height:1px;background:var(--color-border-subtle);margin:0.5rem 0;"></div>
        <form asp-controller="Account" asp-action="Logout" method="post" style="margin:0">
            <button type="submit" class="hs-nav__drawer-link"
                    style="width:100%;background:none;border:none;cursor:pointer;color:var(--error-600);font-family:inherit;font-size:1rem;">
                @Html.Raw(Svg(icLogOut)) خروج از حساب
            </button>
        </form>
    }
    else
    {
        <a class="hs-nav__drawer-link" asp-controller="Account" asp-action="Login">@Html.Raw(Svg(icKey)) ورود</a>
        <a class="hs-nav__drawer-link" asp-controller="Account" asp-action="Register">@Html.Raw(Svg(icSparkle)) ثبت‌نام رایگان</a>
    }
    @if (isCustomer || !isAuthenticated)
    {
        <div style="margin-top:auto;padding-top:1.5rem;">
            <a class="btn btn-primary btn-block" asp-controller="ServiceRequests" asp-action="Create">
                ثبت درخواست خدمت
            </a>
        </div>
    }
</div>

@* =========================================================
   SERVER TOAST BRIDGE
   ========================================================= *@
@if (TempData["Success"] != null)
{
    <div data-toast="success" data-message="@TempData["Success"]" style="display:none"></div>
}
@if (TempData["Error"] != null)
{
    <div data-toast="error" data-message="@TempData["Error"]" style="display:none"></div>
}
@if (TempData["Warning"] != null)
{
    <div data-toast="warning" data-message="@TempData["Warning"]" style="display:none"></div>
}
@if (TempData["Info"] != null)
{
    <div data-toast="info" data-message="@TempData["Info"]" style="display:none"></div>
}

@* =========================================================
   MAIN CONTENT
   ========================================================= *@
<main id="main-content" role="main" class="hs-page">
    @RenderBody()
</main>

@* =========================================================
   FOOTER
   ========================================================= *@
<footer class="hs-footer" role="contentinfo">
    <div class="hs-container">
        <div class="hs-footer__grid">

            <div>
                <div style="display:flex;align-items:center;gap:0.625rem;margin-bottom:1rem;">
                    <div class="hs-nav__logo-icon">@Html.Raw(Svg(icHome))</div>
                    <span style="font-size:1.125rem;font-weight:700;color:white;">@siteName</span>
                </div>
                <p class="hs-footer__brand-desc">@tagline</p>
                <div class="hs-footer__social" style="margin-top:1.5rem;">
                    @if (!string.IsNullOrEmpty(instagram) && instagram != "#")
                    {
                        <a href="@instagram" target="_blank" rel="noopener" class="hs-footer__social-link" aria-label="اینستاگرام">@Html.Raw(Svg(icInstagram))</a>
                    }
                    @if (!string.IsNullOrEmpty(telegram) && telegram != "#")
                    {
                        <a href="@telegram" target="_blank" rel="noopener" class="hs-footer__social-link" aria-label="تلگرام">@Html.Raw(Svg(icSend))</a>
                    }
                    @if (!string.IsNullOrEmpty(phone))
                    {
                        <a href="tel:@phone" class="hs-footer__social-link" aria-label="تماس">@Html.Raw(Svg(icPhone))</a>
                    }
                </div>
            </div>

            <div>
                <div class="hs-footer__col-title">خدمات</div>
                <ul class="hs-footer__links">
                    <li><a class="hs-footer__link" asp-controller="Services" asp-action="Index">همه خدمات</a></li>
                    <li><a class="hs-footer__link" asp-controller="Experts"  asp-action="Index">کارشناسان</a></li>
                    <li><a class="hs-footer__link" asp-controller="Home"     asp-action="HowItWorks">نحوه کار</a></li>
                    <li><a class="hs-footer__link" asp-controller="ServiceRequests" asp-action="Create">ثبت درخواست</a></li>
                </ul>
            </div>

            <div>
                <div class="hs-footer__col-title">حساب کاربری</div>
                <ul class="hs-footer__links">
                    @if (isAuthenticated)
                    {
                        @if (isCustomer)
                        {
                            <li><a class="hs-footer__link" asp-controller="Customer" asp-action="Dashboard">داشبورد</a></li>
                            <li><a class="hs-footer__link" asp-controller="Customer" asp-action="MyRequests">درخواست‌هایم</a></li>
                            <li><a class="hs-footer__link" asp-controller="Customer" asp-action="MyOrders">سفارش‌هایم</a></li>
                        }
                        else if (isExpert)
                        {
                            <li><a class="hs-footer__link" asp-controller="Expert" asp-action="Dashboard">داشبورد</a></li>
                            <li><a class="hs-footer__link" asp-controller="Expert" asp-action="OpenRequests">درخواست‌های باز</a></li>
                            <li><a class="hs-footer__link" asp-controller="Expert" asp-action="MyJobs">کارهایم</a></li>
                        }
                        <li><a class="hs-footer__link" asp-controller="Account" asp-action="Profile">پروفایل من</a></li>
                    }
                    else
                    {
                        <li><a class="hs-footer__link" asp-controller="Account" asp-action="Login">ورود</a></li>
                        <li><a class="hs-footer__link" asp-controller="Account" asp-action="Register">ثبت‌نام</a></li>
                    }
                </ul>
            </div>

            <div>
                <div class="hs-footer__col-title">تماس با ما</div>
                <ul class="hs-footer__links">
                    @if (!string.IsNullOrEmpty(phone))
                    {
                        <li><a class="hs-footer__link" href="tel:@phone">@phone</a></li>
                    }
                    @if (!string.IsNullOrEmpty(email))
                    {
                        <li><a class="hs-footer__link" href="mailto:@email">@email</a></li>
                    }
                    <li><a class="hs-footer__link" href="@instagram" target="_blank" rel="noopener">اینستاگرام</a></li>
                    <li><a class="hs-footer__link" href="@telegram"  target="_blank" rel="noopener">تلگرام</a></li>
                </ul>
            </div>

        </div>

        <div class="hs-footer__bottom">
            <div class="hs-footer__copyright">&copy; @DateTime.Now.Year @siteName — تمامی حقوق محفوظ است.</div>
            <div style="display:flex;gap:1.5rem;">
                <a class="hs-footer__link" href="#">حریم خصوصی</a>
                <a class="hs-footer__link" href="#">شرایط استفاده</a>
            </div>
        </div>
    </div>
</footer>

@* =========================================================
   SCRIPTS
   ========================================================= *@
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/app.js" asp-append-version="true"></script>

@* Show desktop dashboard link only on md+ via JS (avoids duplicate nav items on desktop) *@
<script>
    if (window.innerWidth >= 992) {
        var lnk = document.getElementById('nav-dashboard-link');
        if (lnk) lnk.style.display = '';
    }
</script>

@await RenderSectionAsync("Scripts", required: false)

</body>
</html>
