@model ExpertProfileDto
@using HomeServices.Application.Dtos
@{
    ViewData["Title"] = Model.BusinessName;
    var reviews = ViewBag.Reviews as IReadOnlyList<ReviewDto> ?? Array.Empty<ReviewDto>();
    var portfolio = ViewBag.Portfolio as IReadOnlyList<dynamic> ?? Array.Empty<dynamic>();
    
    // Calculate rating distribution
    var totalReviews = reviews.Count();
    var rating5 = totalReviews > 0 ? (int)Math.Round((double)reviews.Count(r => r.Rating == 5) / totalReviews * 100) : 0;
    var rating4 = totalReviews > 0 ? (int)Math.Round((double)reviews.Count(r => r.Rating == 4) / totalReviews * 100) : 0;
    var rating3 = totalReviews > 0 ? (int)Math.Round((double)reviews.Count(r => r.Rating == 3) / totalReviews * 100) : 0;
    var rating2 = totalReviews > 0 ? (int)Math.Round((double)reviews.Count(r => r.Rating == 2) / totalReviews * 100) : 0;
    var rating1 = totalReviews > 0 ? (int)Math.Round((double)reviews.Count(r => r.Rating == 1) / totalReviews * 100) : 0;
}

<div class="container py-4">
    <nav aria-label="breadcrumb" class="small mb-3">
        <a asp-controller="Home" asp-action="Index" class="text-decoration-none">خانه</a> 
        <span class="text-muted mx-1">/</span>
        <a asp-controller="Experts" asp-action="Index" class="text-decoration-none">کارشناسان</a> 
        <span class="text-muted mx-1">/</span>
        <span class="text-muted">@Model.BusinessName</span>
    </nav>

    @* Expert Profile Header *@
    <div class="dashboard-card mb-4" style="background: linear-gradient(135deg, var(--cream) 0%, var(--beige) 100%);">
        <div class="row g-4 align-items-center">
            <div class="col-md-auto text-center">
                <div class="position-relative d-inline-block">
                    <span class="pro-avatar" style="width:110px;height:110px;font-size:3rem;box-shadow:var(--shadow-lg);">
                        @(Model.BusinessName?.FirstOrDefault() ?? 'P')
                    </span>
                    @if (Model.IsVerified)
                    {
                        <span class="badge-soft badge-success-soft" style="position:absolute;bottom:-8px;left:50%;transform:translateX(-50%);font-size:0.75rem;white-space:nowrap;">
                            ✓ تأیید شده
                        </span>
                    }
                </div>
            </div>
            <div class="col-md">
                <div class="d-flex align-items-start justify-content-between flex-wrap gap-2 mb-2">
                    <div>
                        <h1 class="fw-800 mb-1" style="font-size:2rem;">@Model.BusinessName</h1>
                        <div class="d-flex align-items-center gap-2 flex-wrap mb-2">
                            @if (Model.IsVerified)
                            {
                                <span class="badge-soft badge-success-soft small">✓ تأیید هویت</span>
                            }
                            @if (Model.IsApproved)
                            {
                                <span class="badge-soft badge-info-soft small">✔ تأیید مدیریت</span>
                            }
                            @if (Model.JobsCompleted >= 50)
                            {
                                <span class="badge-soft badge-gold small">🏆 کارشناس برتر</span>
                            }
                            @if (Model.ResponseTimeMinutes.HasValue && Model.ResponseTimeMinutes.Value < 30)
                            {
                                <span class="badge-soft badge-brand small">⚡ پاسخ‌گویی سریع</span>
                            }
                        </div>
                    </div>
                </div>
                
                <div class="d-flex align-items-center gap-2 mb-3">
                    <div class="rating-stars" style="font-size:1.3rem;">
                        @for (int i = 1; i <= 5; i++)
                        {
                            <span>@(i <= Math.Round(Model.RatingAverage) ? "★" : "☆")</span>
                        }
                    </div>
                    <span class="fw-700" style="font-size:1.1rem;">@Model.RatingAverage.ToString("0.0")</span>
                    <span class="text-muted">(@Model.ReviewCount نظر)</span>
                </div>
                
                <div class="row g-3">
                    <div class="col-auto">
                        <div class="d-flex align-items-center gap-2">
                            <span style="font-size:1.2rem;">📍</span>
                            <div>
                                <small class="text-muted d-block" style="font-size:0.75rem;">موقعیت</small>
                                <span class="fw-600">@Model.City</span>
                            </div>
                        </div>
                    </div>
                    <div class="col-auto">
                        <div class="d-flex align-items-center gap-2">
                            <span style="font-size:1.2rem;">✅</span>
                            <div>
                                <small class="text-muted d-block" style="font-size:0.75rem;">پروژه‌ها</small>
                                <span class="fw-600">@Model.JobsCompleted</span>
                            </div>
                        </div>
                    </div>
                    @if (Model.ResponseTimeMinutes.HasValue)
                    {
                        <div class="col-auto">
                            <div class="d-flex align-items-center gap-2">
                                <span style="font-size:1.2rem;">⏱️</span>
                                <div>
                                    <small class="text-muted d-block" style="font-size:0.75rem;">پاسخ‌گویی</small>
                                    <span class="fw-600">@Model.ResponseTimeMinutes دقیقه</span>
                                </div>
                            </div>
                        </div>
                    }
                    <div class="col-auto">
                        <div class="d-flex align-items-center gap-2">
                            <span style="font-size:1.2rem;">📅</span>
                            <div>
                                <small class="text-muted d-block" style="font-size:0.75rem;">عضویت</small>
                                <span class="fw-600">@Model.JoinedAt.ToPersianDate()</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-8">
            @* About Section *@
            @if (!string.IsNullOrEmpty(Model.Bio))
            {
                <div class="dashboard-card mb-4">
                    <h5 class="fw-800 mb-3">
                        <span style="font-size:1.3rem;margin-left:0.5rem;">👤</span>
                        درباره کارشناس
                    </h5>
                    <p class="mb-0" style="line-height:1.8;">@Model.Bio</p>
                </div>
            }

            @* Skills & Expertise *@
            <div class="dashboard-card mb-4">
                <h5 class="fw-800 mb-3">
                    <span style="font-size:1.3rem;margin-left:0.5rem;">⚡</span>
                    مهارت‌ها و تخصص‌ها
                </h5>
                @if (Model.CategoryNames.Any())
                {
                    <div class="row g-2">
                        @foreach (var category in Model.CategoryNames)
                        {
                            <div class="col-auto">
                                <div class="skill-badge" style="padding:0.75rem 1.25rem;background:var(--cream);border:2px solid var(--primary);border-radius:var(--radius);display:inline-flex;align-items:center;gap:0.5rem;">
                                    <span style="font-size:1.2rem;">✓</span>
                                    <span class="fw-600">@category</span>
                                    <div style="width:50px;height:4px;background:var(--beige);border-radius:2px;overflow:hidden;margin-right:0.5rem;">
                                        <div style="width:85%;height:100%;background:var(--primary);"></div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p class="text-muted small mb-0">اطلاعاتی ثبت نشده است.</p>
                }
            </div>

            @* Service Area Map *@
            @if (!string.IsNullOrEmpty(Model.ServiceArea))
            {
                <div class="dashboard-card mb-4">
                    <h5 class="fw-800 mb-3">
                        <span style="font-size:1.3rem;margin-left:0.5rem;">🗺️</span>
                        محدوده خدمات‌رسانی
                    </h5>
                    <div class="alert alert-soft bg-soft d-flex align-items-center gap-2 mb-0">
                        <span style="font-size:1.5rem;">📍</span>
                        <div>
                            <div class="fw-600 mb-1">@Model.ServiceArea</div>
                            <small class="text-muted">این کارشناس در مناطق مذکور فعالیت می‌کند</small>
                        </div>
                    </div>
                </div>
            }

            @* Portfolio/Work Samples *@
            <div class="dashboard-card mb-4">
                <h5 class="fw-800 mb-3">
                    <span style="font-size:1.3rem;margin-left:0.5rem;">🎨</span>
                    نمونه کارها
                    <span class="badge-soft badge-brand ms-2">@portfolio.Count</span>
                </h5>
                @if (portfolio.Any())
                {
                    <div class="row g-3">
                        @foreach (var item in portfolio)
                        {
                            <div class="col-md-4">
                                <div class="card-service" style="cursor:pointer;" data-bs-toggle="modal" data-bs-target="#portfolioModal">
                                    <div class="card-thumb" style="height:180px;background:linear-gradient(135deg, var(--beige) 0%, var(--cream) 100%);">
                                        <div style="font-size:3rem;opacity:0.4;">📸</div>
                                    </div>
                                    <div class="card-body">
                                        <div class="fw-600 small">نمونه کار</div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="text-center py-4">
                        <div style="font-size:3rem;opacity:0.3;margin-bottom:1rem;">📸</div>
                        <p class="text-muted mb-0">هنوز نمونه کاری ثبت نشده است</p>
                    </div>
                }
            </div>

            @* Reviews Section with Rating Distribution *@
            <div class="dashboard-card">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h5 class="fw-800 mb-0">
                        <span style="font-size:1.3rem;margin-left:0.5rem;">⭐</span>
                        نظرات و امتیازات
                        <span class="badge-soft badge-brand ms-2">@Model.ReviewCount</span>
                    </h5>
                    <div class="dropdown">
                        <button class="btn btn-sm btn-outline-brand dropdown-toggle" type="button" data-bs-toggle="dropdown">
                            فیلتر نظرات
                        </button>
                        <ul class="dropdown-menu">
                            <li><a class="dropdown-item" href="#">جدیدترین</a></li>
                            <li><a class="dropdown-item" href="#">بالاترین امتیاز</a></li>
                            <li><a class="dropdown-item" href="#">پایین‌ترین امتیاز</a></li>
                        </ul>
                    </div>
                </div>

                @if (reviews.Any())
                {
                    @* Rating Summary *@
                    <div class="row g-4 mb-4 pb-4 border-bottom">
                        <div class="col-md-4 text-center">
                            <div style="font-size:3.5rem;font-weight:800;background:linear-gradient(135deg,var(--primary) 0%,var(--terracotta) 100%);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;">
                                @Model.RatingAverage.ToString("0.0")
                            </div>
                            <div class="rating-stars" style="font-size:1.2rem;margin-bottom:0.5rem;">
                                @for (int i = 1; i <= 5; i++)
                                {
                                    <span>@(i <= Math.Round(Model.RatingAverage) ? "★" : "☆")</span>
                                }
                            </div>
                            <small class="text-muted">بر اساس @Model.ReviewCount نظر</small>
                        </div>
                        <div class="col-md-8">
                            <div class="vstack gap-2">
                                @for (int i = 5; i >= 1; i--)
                                {
                                    var percentage = i switch {
                                        5 => rating5,
                                        4 => rating4,
                                        3 => rating3,
                                        2 => rating2,
                                        _ => rating1
                                    };
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="text-muted small" style="width:60px;">@i ستاره</span>
                                        <div class="flex-grow-1" style="height:8px;background:var(--beige);border-radius:4px;overflow:hidden;">
                                            <div style="width:@percentage%;height:100%;background:var(--gold);transition:width 0.3s;"></div>
                                        </div>
                                        <span class="text-muted small" style="width:40px;text-align:left;">@percentage%</span>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>

                    @* Reviews List *@
                    <div class="vstack gap-4">
                        @foreach (var review in reviews)
                        {
                            <div class="review-item" style="padding:1.25rem;background:var(--cream);border-radius:var(--radius);">
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="pro-avatar" style="width:40px;height:40px;font-size:1rem;">
                                            @(review.CustomerName?.FirstOrDefault() ?? 'U')
                                        </span>
                                        <div>
                                            <div class="fw-700">@review.CustomerName</div>
                                            <small class="text-muted">@review.CreatedAt.ToPersianDate()</small>
                                        </div>
                                    </div>
                                    <div class="rating-stars">
                                        @for (int i = 1; i <= 5; i++)
                                        {
                                            <span class="@(i <= review.Rating ? "text-warning" : "text-muted")">★</span>
                                        }
                                    </div>
                                </div>
                                @if (!string.IsNullOrEmpty(review.Comment))
                                {
                                    <p class="mb-0" style="line-height:1.7;">@review.Comment</p>
                                }
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="text-center py-4">
                        <div style="font-size:3rem;opacity:0.3;margin-bottom:1rem;">💬</div>
                        <p class="text-muted mb-0">هنوز نظری ثبت نشده است</p>
                    </div>
                }
            </div>
        </div>

        @* Sidebar *@
        <div class="col-lg-4">
            @* CTA Card *@
            <div class="dashboard-card sticky-top mb-3" style="top:1rem;box-shadow:var(--shadow-lg);background:linear-gradient(135deg,var(--primary) 0%,var(--terracotta) 100%);color:white;">
                <div class="text-center">
                    <h5 class="fw-800 mb-2" style="color:white;">آماده همکاری با این کارشناس؟</h5>
                    <p class="mb-3" style="opacity:0.95;font-size:0.9rem;">درخواست خود را ثبت کنید تا پیشنهاد دریافت کنید</p>
                    <a asp-controller="ServiceRequests" asp-action="Create" class="btn w-100 py-3 mb-2" style="background:white;color:var(--primary);font-weight:700;">
                        📝 ثبت درخواست رایگان
                    </a>
                    <small style="opacity:0.9;">بدون هیچ هزینه‌ای</small>
                </div>
            </div>

            @* Quick Stats *@
            <div class="dashboard-card mb-3">
                <h6 class="fw-800 mb-3">📊 آمار عملکرد</h6>
                <div class="vstack gap-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="text-muted small">میزان رضایت</span>
                        <div class="d-flex align-items-center gap-2">
                            <div style="width:60px;height:6px;background:var(--beige);border-radius:3px;overflow:hidden;">
                                <div style="width:@(Model.RatingAverage * 20)%;height:100%;background:var(--primary);"></div>
                            </div>
                            <span class="fw-700">@((Model.RatingAverage * 20).ToString("0"))%</span>
                        </div>
                    </div>
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="text-muted small">پروژه تکمیل شده</span>
                        <span class="fw-700">@Model.JobsCompleted</span>
                    </div>
                    @if (Model.ResponseTimeMinutes.HasValue)
                    {
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="text-muted small">میانگین پاسخ</span>
                            <span class="fw-700">@Model.ResponseTimeMinutes دقیقه</span>
                        </div>
                    }
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="text-muted small">نرخ تکمیل</span>
                        <span class="fw-700 text-success">@(Model.JobsCompleted > 0 ? "98%" : "0%")</span>
                    </div>
                </div>
            </div>

            @* Business Hours *@
            @if (!string.IsNullOrEmpty(Model.BusinessHours))
            {
                <div class="dashboard-card mb-3">
                    <h6 class="fw-800 mb-3">🕐 ساعات کاری</h6>
                    <div class="small">@Model.BusinessHours</div>
                </div>
            }

            @* Trust Indicators *@
            <div class="dashboard-card">
                <h6 class="fw-800 mb-3">🛡️ نشانه‌های اعتماد</h6>
                <div class="vstack gap-2">
                    @if (Model.IsVerified)
                    {
                        <div class="d-flex align-items-center gap-2">
                            <span class="badge-soft badge-success-soft">✓</span>
                            <small>هویت تأیید شده</small>
                        </div>
                    }
                    @if (Model.IsApproved)
                    {
                        <div class="d-flex align-items-center gap-2">
                            <span class="badge-soft badge-info-soft">✓</span>
                            <small>تأیید شده توسط مدیریت</small>
                        </div>
                    }
                    @if (Model.JobsCompleted > 0)
                    {
                        <div class="d-flex align-items-center gap-2">
                            <span class="badge-soft badge-brand">✓</span>
                            <small>دارای سابقه کاری معتبر</small>
                        </div>
                    }
                    <div class="d-flex align-items-center gap-2">
                        <span class="badge-soft badge-gold">✓</span>
                        <small>پرداخت امن تضمین شده</small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
