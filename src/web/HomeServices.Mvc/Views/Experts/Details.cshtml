@model ExpertProfileDto
@using HomeServices.Application.Dtos
@using HomeServices.Mvc.Extensions
@{
    ViewData["Title"] = Model.BusinessName;
    var reviews   = ViewBag.Reviews   as IReadOnlyList<ReviewDto>  ?? Array.Empty<ReviewDto>();
    var portfolio = Model.PortfolioImages;
    int total     = reviews.Count;
    int pct(int n) => total > 0 ? (int)Math.Round(reviews.Count(r=>r.Rating==n)*100.0/total) : 0;
}
@section Styles {
<style>
.expert-detail { padding:var(--space-10) 0 var(--space-20); }
/* Profile cover */
.profile-cover {
    height:200px;
    background:linear-gradient(135deg,var(--primary-600) 0%,var(--accent-500) 100%);
    border-radius:var(--radius-3xl) var(--radius-3xl) 0 0;
    position:relative;
}
.profile-card {
    background:white; border:1px solid var(--color-border-subtle);
    border-radius:var(--radius-3xl); overflow:hidden;
    margin-bottom:var(--space-5); position:relative;
}
.profile-avatar-wrap {
    position:absolute; bottom:-48px; right:var(--space-8);
}
.profile-avatar {
    width:96px; height:96px; border-radius:50%;
    background:var(--gradient-primary); color:white;
    display:flex; align-items:center; justify-content:center;
    font-size:2.5rem; font-weight:var(--font-black);
    border:4px solid white; box-shadow:var(--shadow-lg);
}
.profile-body { padding:var(--space-6) var(--space-8) var(--space-8); padding-top:calc(var(--space-8)+48px); }
.profile-name { font-size:var(--text-3xl); font-weight:var(--font-black); letter-spacing:-.03em; margin-bottom:var(--space-2); }
.profile-meta { display:flex; flex-wrap:wrap; gap:var(--space-5); font-size:var(--text-sm); color:var(--color-text-secondary); margin-bottom:var(--space-5); }
.profile-stats { display:grid; grid-template-columns:repeat(4,1fr); gap:var(--space-4); }
@@media(max-width:640px) { .profile-stats { grid-template-columns:repeat(2,1fr); } }
.profile-stat { text-align:center; background:var(--gray-50); border-radius:var(--radius-xl); padding:var(--space-4); }
.profile-stat__val { font-size:var(--text-2xl); font-weight:var(--font-extrabold); color:var(--primary-700); line-height:1; margin-bottom:var(--space-1); }
.profile-stat__lbl { font-size:var(--text-xs); color:var(--color-text-tertiary); }
/* Section cards */
.detail-card { background:white; border:1px solid var(--color-border-subtle); border-radius:var(--radius-2xl); padding:var(--space-7); margin-bottom:var(--space-5); }
.detail-card__title { font-size:var(--text-xl); font-weight:var(--font-bold); margin-bottom:var(--space-5); display:flex; align-items:center; gap:var(--space-2); }
.detail-card__title svg { color:var(--primary-600); }
/* گالری نمونه‌کارها */
.portfolio-gallery { display:grid; grid-template-columns:repeat(auto-fill,minmax(160px,1fr)); gap:var(--space-4); }
.portfolio-gallery__item { margin:0; }
.portfolio-gallery__item img {
    width:100%; aspect-ratio:4/3; object-fit:cover; border-radius:var(--radius-xl);
    border:1.5px solid var(--color-border-subtle); cursor:zoom-in; transition:all .25s var(--ease-spring);
}
.portfolio-gallery__item img:hover { transform:translateY(-3px); box-shadow:var(--shadow-lg); border-color:var(--primary-300); }
.portfolio-gallery__item figcaption {
    margin-top:var(--space-2); font-size:var(--text-xs); color:var(--color-text-secondary);
    font-weight:var(--font-semibold); text-align:center;
}
/* Skills */
.skill-tag { display:inline-flex; align-items:center; gap:var(--space-2); padding:var(--space-2-5) var(--space-4); background:var(--primary-50); border:1.5px solid var(--primary-200); border-radius:var(--radius-full); font-size:var(--text-sm); font-weight:var(--font-semibold); color:var(--primary-700); }
/* Rating bar */
.rating-bar-row { display:flex; align-items:center; gap:var(--space-3); margin-bottom:var(--space-2); }
.rating-bar-label { width:48px; font-size:var(--text-xs); color:var(--color-text-secondary); text-align:left; flex-shrink:0; }
.rating-bar-track { flex:1; height:8px; background:var(--gray-100); border-radius:var(--radius-full); overflow:hidden; }
.rating-bar-fill { height:100%; background:linear-gradient(90deg,var(--warning-400),var(--warning-500)); border-radius:var(--radius-full); transition:width 1s var(--ease-out); }
.rating-bar-pct { width:36px; font-size:var(--text-xs); color:var(--color-text-tertiary); flex-shrink:0; }
/* Review item */
.review-item { background:var(--gray-50); border-radius:var(--radius-xl); padding:var(--space-5); margin-bottom:var(--space-4); }
.review-item:last-child { margin-bottom:0; }
/* CTA sidebar */
.cta-card {
    background:linear-gradient(135deg,var(--primary-600) 0%,var(--accent-500) 100%);
    border-radius:var(--radius-2xl); padding:var(--space-7);
    color:white;
    margin-bottom:var(--space-5);
}
.cta-card__title { font-size:var(--text-xl); font-weight:var(--font-bold); color:white; margin-bottom:var(--space-2); }
.cta-card__sub { font-size:var(--text-sm); opacity:.85; margin-bottom:var(--space-6); line-height:1.6; }
/* Quick stats sidebar */
.qs-card { background:white; border:1px solid var(--color-border-subtle); border-radius:var(--radius-2xl); padding:var(--space-6); margin-bottom:var(--space-5); }
.qs-row { display:flex; justify-content:space-between; align-items:center; padding:var(--space-2-5) 0; border-bottom:1px solid var(--color-border-subtle); font-size:var(--text-sm); }
.qs-row:last-child { border-bottom:none; }
.qs-label { color:var(--color-text-secondary); }
.qs-value { font-weight:var(--font-semibold); }
</style>
}

<div class="expert-detail">
    <div class="hs-container">
        <nav style="font-size:var(--text-sm);color:var(--color-text-tertiary);margin-bottom:var(--space-6);">
            <a asp-controller="Home"    asp-action="Index" style="color:inherit;text-decoration:none;">خانه</a> /
            <a asp-controller="Experts" asp-action="Index" style="color:inherit;text-decoration:none;">کارشناسان</a> /
            <span>@Model.BusinessName</span>
        </nav>

        @* Profile Header *@
        <div class="profile-card" data-reveal="up">
            <div class="profile-cover"></div>
            <div class="profile-avatar-wrap">
                <div class="profile-avatar">@(Model.BusinessName?.FirstOrDefault() ?? 'P')</div>
            </div>
            <div class="profile-body">
                <div style="display:flex;justify-content:space-between;align-items:flex-start;flex-wrap:wrap;gap:var(--space-4);margin-bottom:var(--space-3);">
                    <div>
                        <div class="profile-name">@Model.BusinessName</div>
                        <div style="display:flex;flex-wrap:wrap;gap:var(--space-2);">
                            @if (Model.IsVerified) { <span class="badge badge--success">تأیید هویت</span> }
                            @if (Model.IsApproved) { <span class="badge badge--info">تأیید مدیریت</span> }
                            @if (Model.JobsCompleted >= 50) { <span class="badge badge--warning">کارشناس برتر</span> }
                            @if (Model.ResponseTimeMinutes.HasValue && Model.ResponseTimeMinutes < 30) { <span class="badge badge--accent">پاسخ سریع</span> }
                        </div>
                    </div>
                    <div style="display:flex;align-items:center;gap:var(--space-2);">
                        @for (int i=1;i<=5;i++) { <span style="font-size:1.3rem;color:@(i<=Math.Round(Model.RatingAverage)?"var(--warning-500)":"var(--gray-200)")">★</span> }
                        <span style="font-size:var(--text-xl);font-weight:var(--font-bold);">@Model.RatingAverage.ToString("0.0")</span>
                        <span style="font-size:var(--text-sm);color:var(--color-text-tertiary);">(@Model.ReviewCount نظر)</span>
                    </div>
                </div>
                <div class="profile-meta">
                    <span>@Model.City</span>
                    @if (Model.ResponseTimeMinutes.HasValue) { <span>پاسخ در @Model.ResponseTimeMinutes دقیقه</span> }
                    <span>عضو از @Model.JoinedAt.ToPersianDate()</span>
                </div>
                <div class="profile-stats">
                    <div class="profile-stat"><div class="profile-stat__val" data-counter="@Model.JobsCompleted">@Model.JobsCompleted</div><div class="profile-stat__lbl">پروژه انجام‌شده</div></div>
                    <div class="profile-stat"><div class="profile-stat__val">@Model.RatingAverage.ToString("0.0")</div><div class="profile-stat__lbl">امتیاز میانگین</div></div>
                    <div class="profile-stat"><div class="profile-stat__val" data-counter="@Model.ReviewCount">@Model.ReviewCount</div><div class="profile-stat__lbl">نظر</div></div>
                    <div class="profile-stat"><div class="profile-stat__val">@(Model.ResponseTimeMinutes ?? 60)</div><div class="profile-stat__lbl">دقیقه پاسخ</div></div>
                </div>
            </div>
        </div>

        <div class="row g-6" style="--bs-gutter-x:2rem;align-items:flex-start;">
            <div class="col-lg-8">

                @if (!string.IsNullOrEmpty(Model.Bio))
                {
                    <div class="detail-card" data-reveal="up">
                        <div class="detail-card__title">درباره کارشناس</div>
                        <p style="font-size:var(--text-base);color:var(--color-text-secondary);line-height:var(--leading-relaxed);margin:0;">@Model.Bio</p>
                    </div>
                }

                @if (Model.CategoryNames.Any())
                {
                    <div class="detail-card" data-reveal="up">
                        <div class="detail-card__title">⚡ مهارت‌ها و تخصص‌ها</div>
                        <div style="display:flex;flex-wrap:wrap;gap:var(--space-2);">
                            @foreach (var cat in Model.CategoryNames)
                            {
                                <span class="skill-tag">✓ @cat</span>
                            }
                        </div>
                    </div>
                }

                @if (!string.IsNullOrEmpty(Model.ServiceArea))
                {
                    <div class="detail-card" data-reveal="up">
                        <div class="detail-card__title">@IconSvg.Pin محدوده خدمات‌رسانی</div>
                        <div style="display:flex;align-items:center;gap:var(--space-3);background:var(--gray-50);padding:var(--space-4);border-radius:var(--radius-xl);">
                            <span style="color:var(--primary-600);display:inline-flex;">@IconSvg.Pin</span>
                            <div>
                                <div style="font-weight:var(--font-semibold);">@Model.ServiceArea</div>
                                <div style="font-size:var(--text-xs);color:var(--color-text-tertiary);">مناطق پوشش‌دهی</div>
                            </div>
                        </div>
                    </div>
                }

                @* گالری نمونه‌کارها — برای همه کاربران قابل مشاهده *@
                @if (portfolio.Any())
                {
                    <div class="detail-card" data-reveal="up">
                        <div class="detail-card__title">@IconSvg.Briefcase نمونه‌کارها
                            <span class="badge badge--primary" style="margin-right:var(--space-2);">@portfolio.Count</span>
                        </div>
                        <div class="portfolio-gallery">
                            @foreach (var img in portfolio)
                            {
                                <figure class="portfolio-gallery__item">
                                    <img src="@(string.IsNullOrEmpty(img.ThumbnailUrl) ? img.ImageUrl : img.ThumbnailUrl)"
                                         alt="@(img.Title ?? "نمونه‌کار")" loading="lazy"
                                         onclick="window.open('@img.ImageUrl','_blank')" />
                                    @if (!string.IsNullOrEmpty(img.Title))
                                    {
                                        <figcaption>@img.Title</figcaption>
                                    }
                                </figure>
                            }
                        </div>
                    </div>
                }

                @* Reviews *@
                <div class="detail-card" data-reveal="up">
                    <div class="detail-card__title">@IconSvg.Star نظرات و امتیازات
                        <span class="badge badge--primary" style="margin-right:var(--space-2);">@Model.ReviewCount</span>
                    </div>
                    @if (reviews.Any())
                    {
                        <div style="display:grid;grid-template-columns:auto 1fr;gap:var(--space-8);align-items:start;margin-bottom:var(--space-8);padding-bottom:var(--space-8);border-bottom:1px solid var(--color-border-subtle);">
                            <div style="text-align:center;">
                                <div style="font-size:4rem;font-weight:var(--font-black);background:var(--gradient-primary);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;line-height:1;margin-bottom:var(--space-2);">@Model.RatingAverage.ToString("0.0")</div>
                                <div style="display:flex;justify-content:center;gap:2px;margin-bottom:var(--space-1);">
                                    @for (int i=1;i<=5;i++) { <span style="color:@(i<=Math.Round(Model.RatingAverage)?"var(--warning-500)":"var(--gray-200)");font-size:1.1rem;">★</span> }
                                </div>
                                <div style="font-size:var(--text-xs);color:var(--color-text-tertiary);">از @Model.ReviewCount نظر</div>
                            </div>
                            <div>
                                @foreach (var n in new[]{5,4,3,2,1})
                                {
                                    <div class="rating-bar-row">
                                        <div class="rating-bar-label">@n ستاره</div>
                                        <div class="rating-bar-track" data-progress="@pct(n)">
                                            <div class="rating-bar-fill progress-fill" style="width:0%"></div>
                                        </div>
                                        <div class="rating-bar-pct">@pct(n)٪</div>
                                    </div>
                                }
                            </div>
                        </div>
                        @foreach (var review in reviews)
                        {
                            <div class="review-item">
                                <div style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:var(--space-3);">
                                    <div style="display:flex;align-items:center;gap:var(--space-3);">
                                        <div style="width:40px;height:40px;border-radius:50%;background:var(--gradient-primary);color:white;display:flex;align-items:center;justify-content:center;font-weight:var(--font-bold);font-size:var(--text-sm);">
                                            @(review.CustomerName?.FirstOrDefault() ?? 'U')
                                        </div>
                                        <div>
                                            <div style="font-weight:var(--font-semibold);font-size:var(--text-sm);">@review.CustomerName</div>
                                            <div style="font-size:var(--text-xs);color:var(--color-text-tertiary);">@review.CreatedAt.ToPersianDate()</div>
                                        </div>
                                    </div>
                                    <div style="display:flex;gap:1px;">
                                        @for (int i=1;i<=5;i++) { <span style="color:@(i<=review.Rating?"var(--warning-500)":"var(--gray-200)");">★</span> }
                                    </div>
                                </div>
                                @if (!string.IsNullOrEmpty(review.Comment))
                                {
                                    <p style="font-size:var(--text-sm);color:var(--color-text-secondary);line-height:var(--leading-relaxed);margin:0;">@review.Comment</p>
                                }
                            </div>
                        }
                    }
                    else
                    {
                        <div class="empty-state" style="padding:var(--space-12) var(--space-8);">
                            <div class="empty-state__icon">@IconSvg.Message</div>
                            <div class="empty-state__title">هنوز نظری ثبت نشده</div>
                        </div>
                    }
                </div>
            </div>

            @* Sidebar *@
            <div class="col-lg-4">
                <div class="cta-card" data-reveal="left">
                    <div class="cta-card__title">آماده همکاری؟</div>
                    <p class="cta-card__sub">درخواست خود را ثبت کنید تا این کارشناس پیشنهاد ارسال کند.</p>
                    <a asp-controller="ServiceRequests" asp-action="Create"
                       class="btn btn-xl btn-block hover-lift"
                       style="background:white;color:var(--primary-700);font-weight:var(--font-bold);">
                        @IconSvg.FileText ثبت درخواست رایگان
                    </a>
                    <div style="text-align:center;font-size:var(--text-xs);opacity:.75;margin-top:var(--space-3);">بدون هیچ هزینه‌ای</div>
                </div>

                <div class="qs-card" data-reveal="left">
                    <div style="font-size:var(--text-sm);font-weight:var(--font-bold);margin-bottom:var(--space-4);">@IconSvg.TrendingUp آمار عملکرد</div>
                    <div class="qs-row"><span class="qs-label">میزان رضایت</span><span class="qs-value">@((Model.RatingAverage*20).ToString("0"))٪</span></div>
                    <div class="qs-row"><span class="qs-label">پروژه تکمیل‌شده</span><span class="qs-value">@Model.JobsCompleted</span></div>
                    @if (Model.ResponseTimeMinutes.HasValue)
                    {
                        <div class="qs-row"><span class="qs-label">زمان پاسخ</span><span class="qs-value">@Model.ResponseTimeMinutes دقیقه</span></div>
                    }
                    <div class="qs-row"><span class="qs-label">نرخ تکمیل</span><span class="qs-value" style="color:var(--success-600);">@(Model.JobsCompleted>0?"98٪":"—")</span></div>
                </div>

                @if (!string.IsNullOrEmpty(Model.BusinessHours))
                {
                    <div class="qs-card" data-reveal="left">
                        <div style="font-size:var(--text-sm);font-weight:var(--font-bold);margin-bottom:var(--space-3);">🕐 ساعات کاری</div>
                        <p style="font-size:var(--text-sm);color:var(--color-text-secondary);margin:0;">@Model.BusinessHours</p>
                    </div>
                }

                <div class="qs-card" data-reveal="left">
                    <div style="font-size:var(--text-sm);font-weight:var(--font-bold);margin-bottom:var(--space-4);">🛡️ نشانه‌های اعتماد</div>
                    @if (Model.IsVerified) { <div class="qs-row"><span class="qs-label">هویت تأییدشده</span><span class="badge badge--success">✓</span></div> }
                    @if (Model.IsApproved) { <div class="qs-row"><span class="qs-label">تأیید مدیریت</span><span class="badge badge--info">✓</span></div> }
                    <div class="qs-row"><span class="qs-label">پرداخت امن</span><span class="badge badge--success">✓</span></div>
                    <div class="qs-row"><span class="qs-label">ضمانت کیفیت</span><span class="badge badge--success">✓</span></div>
                </div>
            </div>
        </div>
    </div>
</div>
