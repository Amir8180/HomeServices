@model PagedResult<ExpertProfileDto>
@using HomeServices.Shared.Common
@{
    ViewData["Title"] = "کارشناسان";
    var categories = ViewBag.Categories as IReadOnlyList<CategoryDto> ?? Array.Empty<CategoryDto>();
    var filter = ViewBag.CurrentFilter as ExpertProfileFilterDto ?? new ExpertProfileFilterDto();
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-end mb-4">
        <div>
            <h1 class="fw-800 mb-0">کارشناسان خدمات</h1>
            <p class="text-muted mb-0">@Model.TotalCount کارشناس تأییدشده</p>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-3">
            <div class="dashboard-card">
                <h6 class="fw-800 mb-3">🔍 فیلترها</h6>
                <form method="get" class="vstack gap-3">
                    <div>
                        <label class="form-label small fw-600">جستجو</label>
                        <input type="text" name="search" value="@filter.SearchTerm" class="form-control form-control-sm" placeholder="نام کسب‌وکار..." />
                    </div>
                    <div>
                        <label class="form-label small fw-600">تخصص</label>
                        <select name="categoryId" class="form-select form-select-sm" asp-items="@(new SelectList(categories, "Id", "Name", filter.CategoryId))">
                            <option value="">همه</option>
                        </select>
                    </div>
                    <div>
                        <label class="form-label small fw-600">شهر</label>
                        <input type="text" name="city" value="@filter.City" class="form-control form-control-sm" />
                    </div>
                    <button type="submit" class="btn btn-brand btn-sm">اعمال فیلتر</button>
                    <a asp-action="Index" class="btn btn-outline-brand btn-sm">پاک کردن</a>
                </form>
            </div>
        </div>

        <div class="col-lg-9">
            @if (!Model.Items.Any())
            {
                <div class="empty-state dashboard-card">
                    <div class="icon">👷</div>
                    <h5 class="fw-800">کارشناسی یافت نشد</h5>
                </div>
            }
            else
            {
                <div class="row g-3 row-cols-1 row-cols-md-2">
                    @foreach (var e in Model.Items)
                    {
                        <div class="col">
                            <a asp-action="Details" asp-route-id="@e.Id" class="card-pro p-3 d-block h-100">
                                <div class="d-flex gap-3 align-items-center">
                                    <span class="pro-avatar" style="width:60px;height:60px;font-size:1.6rem;">@(e.BusinessName?.FirstOrDefault() ?? 'P')</span>
                                    <div class="flex-grow-1">
                                        <div class="fw-800 fs-5 text-dark">@e.BusinessName</div>
                                        <div class="d-flex gap-1 flex-wrap">
                                            @if (e.IsVerified)
                                            {
                                                <span class="badge-soft badge-success-soft small">✓ تأییدشده</span>
                                            }
                                            @if (e.IsApproved)
                                            {
                                                <span class="badge-soft badge-info-soft small">✔ تأیید مدیر</span>
                                            }
                                        </div>
                                        <div class="rating-stars small">
                                            @for (int i = 1; i <= 5; i++)
                                            {
                                                <span>@(i <= Math.Round(e.RatingAverage) ? "★" : "☆")</span>
                                            }
                                            <span class="text-muted">@e.RatingAverage.ToString("0.0") (@e.ReviewCount)</span>
                                        </div>
                                        <div class="small text-muted">@e.City · @e.JobsCompleted کار انجام شده</div>
                                    </div>
                                </div>
                                @if (e.CategoryNames.Any())
                                {
                                    <div class="mt-2">
                                        @foreach (var c in e.CategoryNames.Take(3))
                                        {
                                            <span class="badge-soft badge-brand small">@c</span>
                                        }
                                    </div>
                                }
                            </a>
                        </div>
                    }
                </div>

                @if (Model.TotalPages > 1)
                {
                    <nav class="mt-4">
                        <ul class="pagination justify-content-center">
                            <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                                <a class="page-link" asp-action="Index" asp-route-page="@(Model.PageNumber-1)">→ قبلی</a>
                            </li>
                            @for (int i = 1; i <= Model.TotalPages; i++)
                            {
                                <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                                    <a class="page-link" asp-action="Index" asp-route-page="@i">@i</a>
                                </li>
                            }
                            <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                                <a class="page-link" asp-action="Index" asp-route-page="@(Model.PageNumber+1)">بعدی ←</a>
                            </li>
                        </ul>
                    </nav>
                }
            }
        </div>
    </div>
</div>
