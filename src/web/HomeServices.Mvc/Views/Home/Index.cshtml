@model HomeViewModel
@using HomeServices.Mvc.Extensions
@{
    ViewData["Title"] = "خانه";
}

@section Styles {
<style>
/* ── Hero ──────────────────────────────────────────────── */
.hero {
    min-height: calc(100vh - 72px);
    display: grid;
    align-items: center;
    padding: var(--space-20) 0 var(--space-16);
    position: relative;
    overflow: hidden;
    background: linear-gradient(160deg,
        var(--primary-50) 0%,
        #ffffff 40%,
        var(--accent-50) 100%);
}
.hero::before {
    content: '';
    position: absolute;
    width: 600px; height: 600px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(184,148,86,.12) 0%, transparent 70%);
    top: -100px; left: -200px;
    pointer-events: none;
}
.hero::after {
    content: '';
    position: absolute;
    width: 500px; height: 500px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(252,86,71,.08) 0%, transparent 70%);
    bottom: -100px; right: -100px;
    pointer-events: none;
}
.hero__eyebrow {
    display: inline-flex; align-items: center; gap: var(--space-2);
    padding: var(--space-1-5) var(--space-4);
    background: var(--primary-100); color: var(--primary-700);
    border-radius: var(--radius-full);
    font-size: var(--text-xs); font-weight: var(--font-bold);
    text-transform: uppercase; letter-spacing: .08em;
    margin-bottom: var(--space-5);
}
.hero__title {
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    font-weight: var(--font-black);
    line-height: 1.08;
    letter-spacing: -.04em;
    color: var(--gray-900);
    margin-bottom: var(--space-6);
}
.hero__title .highlight {
    background: linear-gradient(135deg, var(--primary-600), var(--accent-500));
    -webkit-background-clip: text; -webkit-text-fill-color: transparent;
    background-clip: text;
}
.hero__sub {
    font-size: var(--text-xl);
    color: var(--color-text-secondary);
    line-height: var(--leading-relaxed);
    max-width: 520px;
    margin-bottom: var(--space-10);
}
.hero__actions { display: flex; gap: var(--space-3); flex-wrap: wrap; margin-bottom: var(--space-10); }
.hero__trust {
    display: flex; align-items: center; gap: var(--space-5); flex-wrap: wrap;
    font-size: var(--text-sm); color: var(--color-text-tertiary);
}
.hero__trust-item { display: flex; align-items: center; gap: var(--space-2); }
.hero__trust-dot {
    width: 6px; height: 6px; border-radius: 50%;
    background: var(--success-500);
}
/* Search card */
.hero-search {
    background: white;
    border-radius: var(--radius-2xl);
    padding: var(--space-8);
    box-shadow: 0 32px 64px -16px rgba(0,0,0,.14), 0 0 0 1px rgba(0,0,0,.04);
    position: relative; z-index: 1;
}
.hero-search__label {
    font-size: var(--text-xs); font-weight: var(--font-bold);
    text-transform: uppercase; letter-spacing: .06em;
    color: var(--color-text-tertiary); margin-bottom: var(--space-5);
}
.hero-search__field {
    width: 100%; padding: var(--space-4) var(--space-5);
    border: 1.5px solid var(--color-border);
    border-radius: var(--radius-xl);
    font-size: var(--text-base); font-family: inherit;
    outline: none; transition: border-color .2s, box-shadow .2s;
    color: var(--gray-900); background: var(--gray-50);
    margin-bottom: var(--space-3);
}
.hero-search__field:focus {
    border-color: var(--primary-500);
    box-shadow: 0 0 0 3px rgba(184,148,86,.12);
    background: white;
}
/* Category select — Bootstrap-style custom select */
.hero-search__select-wrap {
    position: relative;
    margin-bottom: var(--space-4);
}
.hero-search__select-wrap::after {
    content: '▾';
    position: absolute;
    left: var(--space-5);
    top: 50%;
    transform: translateY(-50%);
    pointer-events: none;
    color: var(--color-text-tertiary);
    font-size: 1rem;
}
.hero-search__field--select {
    appearance: none;
    -webkit-appearance: none;
    padding-left: var(--space-10) !important;
    cursor: pointer;
    background-image: none !important;
}
.hero-search__field--select:focus {
    background-color: white;
}
/* Marquee-style auto-scroll for quick access
   حرکت و حلقه بی‌پایان کاملاً توسط جاوااسکریپت (rAF) مدیریت می‌شود */
.marquee-track {
    display: flex; gap: var(--space-3);
    overflow: hidden;
    padding: var(--space-2) 0;
    mask-image: linear-gradient(to left, transparent, black 60px, black calc(100% - 60px), transparent);
    -webkit-mask-image: linear-gradient(to left, transparent, black 60px, black calc(100% - 60px), transparent);
    cursor: grab;
    user-select: none;
    -webkit-user-select: none;
    touch-action: pan-y;
}
.marquee-track.dragging {
    cursor: grabbing;
}
.marquee-track__inner {
    display: flex; gap: var(--space-3);
    width: max-content;
    will-change: transform;
}
.cat-pill {
    flex-shrink: 0; display: flex; flex-direction: column;
    align-items: center; gap: var(--space-1-5);
    padding: var(--space-4) var(--space-5);
    background: white; border: 1.5px solid var(--color-border);
    border-radius: var(--radius-xl); text-decoration: none;
    transition: all .2s; min-width: 80px;
}
.cat-pill:hover {
    border-color: var(--primary-400);
    box-shadow: var(--shadow-md);
    transform: translateY(-3px);
}
.cat-pill__icon { font-size: 1.75rem; }
.cat-pill__name { font-size: var(--text-xs); font-weight: var(--font-semibold); color: var(--gray-700); text-align: center; }
</style>
}

<style>
/* ── How it works ─────────────────────────────────────── */
.steps { background: var(--gray-900); color: white; padding: var(--space-24) 0; }
.step-card {
    position: relative; padding: var(--space-8);
    background: rgba(255,255,255,.04);
    border: 1px solid rgba(255,255,255,.08);
    border-radius: var(--radius-2xl);
    transition: all .3s;
}
.step-card:hover { background: rgba(255,255,255,.07); transform: translateY(-4px); }
.step-number {
    width: 52px; height: 52px;
    background: var(--gradient-primary);
    border-radius: var(--radius-xl);
    display: flex; align-items: center; justify-content: center;
    font-size: var(--text-xl); font-weight: var(--font-black);
    color: white; margin-bottom: var(--space-5);
    box-shadow: var(--shadow-brand);
}
.step-card__title { font-size: var(--text-xl); font-weight: var(--font-bold); color: white; margin-bottom: var(--space-2); }
.step-card__desc  { font-size: var(--text-sm); color: rgba(255,255,255,.6); line-height: var(--leading-relaxed); }
/* ── Services grid ────────────────────────────────────── */
.services-section { padding: var(--space-24) 0; }
/* ── Experts section ──────────────────────────────────── */
.experts-section { padding: var(--space-24) 0; background: var(--primary-50); }
/* ── Stats banner ─────────────────────────────────────── */
.stats-banner {
    background: white;
    border-radius: var(--radius-3xl);
    padding: var(--space-12) var(--space-16);
    box-shadow: var(--shadow-xl);
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-8);
    border: 1px solid var(--color-border-subtle);
}
@@media (max-width: 768px) { .stats-banner { grid-template-columns: repeat(2,1fr); padding: var(--space-8); } }
@@media (max-width: 480px) { .stats-banner { grid-template-columns: 1fr; } }
.stats-item { text-align: center; }
.stats-value {
    font-size: var(--text-4xl); font-weight: var(--font-black);
    background: var(--gradient-primary); -webkit-background-clip: text;
    -webkit-text-fill-color: transparent; background-clip: text;
    letter-spacing: -.03em; line-height: 1; margin-bottom: var(--space-2);
}
.stats-label { font-size: var(--text-sm); color: var(--color-text-secondary); font-weight: var(--font-medium); }
/* ── CTA Section ──────────────────────────────────────── */
.cta-section {
    padding: var(--space-24) 0;
    background: linear-gradient(135deg, var(--primary-600) 0%, var(--accent-500) 100%);
    position: relative; overflow: hidden;
}
.cta-section::before {
    content: ''; position: absolute; inset: -50%;
    background: radial-gradient(ellipse, rgba(255,255,255,.08) 0%, transparent 60%);
    animation: float 10s ease-in-out infinite;
    pointer-events: none;
}
</style>

@* ═══════════════════════════════════════════════════════
   HERO
   ═══════════════════════════════════════════════════════ *@
<section class="hero">
    <div class="hs-container">
        <div class="row g-5 align-items-center" style="--bs-gutter-x:3rem">
            <div class="col-lg-6" data-reveal="up">
                <div class="hero__eyebrow">
                    <span style="width:6px;height:6px;border-radius:50%;background:var(--success-500);display:inline-block;"></span>
                    پلتفرم شماره ۱ خدمات منزل
                </div>
                <h1 class="hero__title">
                    متخصصان باکیفیت<br />
                    برای <span class="highlight">خانه‌تان</span><br />
                    پیدا کنید
                </h1>
                <p class="hero__sub">
                    درخواست خود را ثبت کنید، پیشنهاد کارشناسان تأییدشده را مقایسه کنید
                    و بهترین را با اطمینان کامل انتخاب کنید.
                </p>
                <div class="hero__actions">
                    <a asp-controller="ServiceRequests" asp-action="Create"
                       class="btn btn-primary btn-lg hover-lift">
                        ثبت درخواست رایگان
                    </a>
                    <a asp-controller="Experts" asp-action="Index"
                       class="btn btn-secondary btn-lg">
                        مشاهده کارشناسان
                    </a>
                </div>
                <div class="hero__trust">
                    <div class="hero__trust-item">
                        <span class="hero__trust-dot"></span>
                        <span>@Model.Stats.VerifiedExperts کارشناس تأییدشده</span>
                    </div>
                    <div class="hero__trust-item">
                        <span class="hero__trust-dot"></span>
                        <span>پرداخت ۱۰۰٪ امن</span>
                    </div>
                    <div class="hero__trust-item">
                        <span class="hero__trust-dot"></span>
                        <span>ضمانت کیفیت</span>
                    </div>
                </div>
            </div>

            <div class="col-lg-6" data-reveal="left">
                <div class="hero-search">
                    <div class="hero-search__label">جستجوی سریع خدمت</div>
                    <form asp-controller="Services" asp-action="Index" method="get">
                        <input type="text" name="search" class="hero-search__field"
                               placeholder="مثلاً لوله‌کشی، نظافت، برق‌کاری..." autocomplete="off" />
                        <div class="hero-search__select-wrap">
                            <select name="categoryId" class="hero-search__field hero-search__field--select"
                                    asp-items="@(new SelectList(Model.Categories, "Id", "Name"))">
                                <option value="">همه دسته‌بندی‌ها</option>
                            </select>
                        </div>
                        <button type="submit" class="btn btn-primary btn-block btn-lg">
                            جستجو در خدمات
                        </button>
                    </form>
                    <div style="margin-top:var(--space-5);">
                        <div style="font-size:var(--text-xs);color:var(--color-text-tertiary);margin-bottom:var(--space-3);font-weight:var(--font-semibold);">دسترسی سریع:</div>
                        @{
                            var quickCats = Model.Categories.Take(8).ToList();

                            // آیکون اختصاصی هر دسته بر اساس محتوای آن (سبک Feather/lucide)
                            var catIcons = new Dictionary<string, string>
                            {
                                ["house-cleaning"]    = "<path d='m19.36 19.36a2 2 0 0 1-2.83 0l-3.18-3.18a3 3 0 0 1-.86-2.12l-.3-3.35 3.35.3a3 3 0 0 1 2.12.86l3.18 3.18a2 2 0 0 1 0 2.83Z'/><path d='m14.5 7.5-7 7'/><path d='M3 3l4.36 4.36'/>",                                  /* جارو */
                                ["plumbing"]          = "<path d='M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z'/>",                                                                                                                                           /* قطره آب */
                                ["electrical"]        = "<polygon points='13 2 3 14 12 14 11 22 21 10 12 10 13 2'/>",                                                                                                                                  /* الکتریسیته */
                                ["hvac"]              = "<path d='M9.59 4.59A2 2 0 1 1 11 8H2m10.59 11.41A2 2 0 1 0 14 16H2m15.73-8.27A2.5 2.5 0 1 1 19.5 12H2'/>",                                                                                     /* باد/تهویه */
                                ["interior-painting"] = "<path d='M9.06 11.9l8.07-8.06a2.85 2.85 0 1 1 4.03 4.03l-8.06 8.08'/><path d='M7.07 14.94c-1.66 0-3 1.35-3 3.02 0 1.33-2.5 1.52-2 2.02 1.08 1.1 2.49 2.02 4 2.02 2.2 0 4-1.8 4-4.04a3.01 3.01 0 0 0-3-3.02z'/>", /* قلم‌مو */
                                ["flooring"]          = "<polygon points='12 2 2 7 12 12 22 7 12 2'/><polyline points='2 17 12 22 22 17'/><polyline points='2 12 12 17 22 12'/>",                                                                              /* لایه‌ها */
                                ["appliance-repair"]  = "<path d='M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z'/>",                              /* آچار */
                                ["roofing"]           = "<path d='M3 9.5L12 3l9 6.5V20a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V9.5z'/><path d='M9 21V12h6v9'/>",                                                                                                        /* بام خانه */
                                ["exterior-painting"] = "<path d='M12 19l7-7 3 3-7 7-3-3z'/><path d='M18 13l-1.5-7.5L2 2l3.5 14.5L13 18l5-5z'/><path d='M2 2l7.586 7.586'/><circle cx='11' cy='11' r='2'/>",                                                  /* قلم طراحی نما */
                                ["siding"]            = "<rect x='3' y='3' width='7' height='7'/><rect x='14' y='3' width='7' height='7'/><rect x='14' y='14' width='7' height='7'/><rect x='3' y='14' width='7' height='7'/>",                              /* کاشی/سنگ نما */
                                ["landscaping"]       = "<path d='M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z'/><path d='M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12'/>",                                        /* برگ/فضای سبز */
                                ["tree-service"]      = "<circle cx='6' cy='6' r='3'/><circle cx='6' cy='18' r='3'/><line x1='20' y1='4' x2='8.12' y2='15.88'/><line x1='14.47' y1='14.48' x2='20' y2='20'/><line x1='8.12' y1='8.12' x2='12' y2='12'/>",        /* قیچی هرس */
                                ["pest-control"]      = "<path d='m8 2 1.88 1.88'/><path d='M14.12 3.88 16 2'/><path d='M9 7.13v-1a3.003 3.003 0 1 1 6 0v1'/><path d='M12 20c-3.3 0-6-2.7-6-6v-3a4 4 0 0 1 4-4h4a4 4 0 0 1 4 4v3c0 3.3-2.7 6-6 6'/><path d='M12 20v-9'/><path d='M6.53 9C4.6 8.8 3 7.1 3 5'/><path d='M6 13H2'/><path d='M3 21c0-2.1 1.7-3.9 3.8-4'/><path d='M20.97 5c0 2.1-1.6 3.8-3.5 4'/><path d='M22 13h-4'/><path d='M17.2 17c2.1.1 3.8 1.9 3.8 4'/>", /* حشره */
                                ["handyman"]          = "<path d='M15 12l-8.5 8.5a2.12 2.12 0 0 1-3-3L12 9'/><path d='M17.64 15L22 10.64'/><path d='M20.91 11.7L16.3 7.09a2 2 0 0 0-2.83 0L11 9.5l4.5 4.5 5.41-2.3z'/>",                                   /* چکش */
                                ["carpet-cleaning"]   = "<path d='M3 3h.01'/><path d='M7 5h.01'/><path d='M11 7h.01'/><path d='M3 7h.01'/><path d='M7 9h.01'/><path d='M3 11h.01'/><rect width='4' height='4' x='15' y='5'/><path d='m19 9 2 2v10c0 .6-.4 1-1 1h-6c-.6 0-1-.4-1-1V11l2-2'/><path d='m15 5 0-2'/>", /* اسپری */
                            };
                            var fallbackIcon = catIcons["handyman"];
                        }
                        @if (quickCats.Any())
                        {
                            <div class="marquee-track" id="cat-marquee">
                                <div class="marquee-track__inner" id="cat-marquee-inner">
                                    @foreach (var cat in quickCats)
                                    {
                                        var paths = catIcons.TryGetValue(cat.Slug, out var p) ? p : fallbackIcon;
                                        <a class="cat-pill" asp-controller="Services" asp-action="Index" asp-route-categoryId="@cat.Id">
                                            <span class="cat-pill__icon">
                                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" style="width:22px;height:22px;">@Html.Raw(paths)</svg>
                                            </span>
                                            <span class="cat-pill__name">@cat.Name</span>
                                        </a>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@* ═══════════════════════════════════════════════════════
   STATS BANNER
   ═══════════════════════════════════════════════════════ *@
<div class="hs-container" style="margin-top:-var(--space-8);position:relative;z-index:2;padding-top:var(--space-10);">
    <div class="stats-banner" data-stagger>
        <div class="stats-item" data-reveal="up">
            <div class="stats-value" data-counter="@Model.Stats.VerifiedExperts">@Model.Stats.VerifiedExperts</div>
            <div class="stats-label">کارشناس تأییدشده</div>
        </div>
        <div class="stats-item" data-reveal="up">
            <div class="stats-value" data-counter="@Model.Stats.CompletedProjects">@Model.Stats.CompletedProjects</div>
            <div class="stats-label">پروژه انجام‌شده</div>
        </div>
        <div class="stats-item" data-reveal="up">
            @if (Model.Stats.HasRatingData)
            {
                <div class="stats-value" data-counter="@Model.Stats.SatisfactionPercent" data-counter-suffix="٪">@(Model.Stats.SatisfactionPercent)٪</div>
            }
            else
            {
                <div class="stats-value">—</div>
            }
            <div class="stats-label">رضایت مشتریان</div>
        </div>
        <div class="stats-item" data-reveal="up">
            @if (Model.Stats.HasRatingData)
            {
                <div class="stats-value">@Model.Stats.AverageRating.ToString("0.0")</div>
            }
            else
            {
                <div class="stats-value">—</div>
            }
            <div class="stats-label">میانگین امتیاز</div>
        </div>
    </div>
</div>

@* ═══════════════════════════════════════════════════════
   HOW IT WORKS
   ═══════════════════════════════════════════════════════ *@
<section class="steps">
    <div class="hs-container">
        <div class="section-header section-header--center" style="color:white;">
            <div class="section-label" style="background:rgba(255,255,255,.1);color:rgba(255,255,255,.9);">
                ساده، سریع، مطمئن
            </div>
            <h2 class="section-title" style="color:white;">در سه گام ساده خدمت بگیرید</h2>
            <p class="section-subtitle" style="color:rgba(255,255,255,.65);margin:0 auto;">
                بدون پیچیدگی — از ثبت درخواست تا تکمیل کار در کمترین زمان
            </p>
        </div>
        <div class="row g-4" data-stagger>
            <div class="col-md-4" data-reveal="up">
                <div class="step-card">
                    <div class="step-number">۱</div>
                    <div class="step-card__title">درخواست خود را ثبت کنید</div>
                    <div class="step-card__desc">نوع خدمت، توضیحات، آدرس و بودجه خود را وارد کنید. کاملاً رایگان است.</div>
                </div>
            </div>
            <div class="col-md-4" data-reveal="up">
                <div class="step-card">
                    <div class="step-number">۲</div>
                    <div class="step-card__title">پیشنهادها را مقایسه کنید</div>
                    <div class="step-card__desc">کارشناسان واجد شرایط پیشنهاد قیمت و زمان ارسال می‌کنند. امتیاز و نظرات را ببینید.</div>
                </div>
            </div>
            <div class="col-md-4" data-reveal="up">
                <div class="step-card">
                    <div class="step-number">۳</div>
                    <div class="step-card__title">بهترین را انتخاب کنید</div>
                    <div class="step-card__desc">پیشنهاد مناسب را تأیید کنید، کار انجام شود، و پس از رضایت پرداخت کنید.</div>
                </div>
            </div>
        </div>
    </div>
</section>

@* ═══════════════════════════════════════════════════════
   POPULAR SERVICES
   ═══════════════════════════════════════════════════════ *@
@if (Model.PopularServices.Any())
{
    <section class="services-section">
        <div class="hs-container">
            <div class="d-flex justify-content-between align-items-end" style="margin-bottom:var(--space-10);">
                <div data-reveal="up">
                    <div class="section-label">پرطرفدارترین‌ها</div>
                    <h2 class="section-title" style="margin-bottom:0">خدمات محبوب</h2>
                </div>
                <a asp-controller="Services" asp-action="Index"
                   class="btn btn-secondary" data-reveal="up">مشاهده همه ←</a>
            </div>
            <div class="row g-4 row-cols-1 row-cols-md-2 row-cols-lg-3" data-stagger>
                @foreach (var svc in Model.PopularServices.Take(6))
                {
                    <div class="col" data-reveal="up">
                        <div class="service-card hover-lift" style="cursor:pointer"
                             onclick="window.location='@Url.Action("Details","Services",new{id=svc.Id})'">
                            <div class="service-card__image">
                                <span class="service-card__image-icon">
                                    @{ var svcIcon = Model.Categories.FirstOrDefault(c => c.Id == svc.CategoryId) is { } cat && catIcons.TryGetValue(cat.Slug, out var sip) ? sip : fallbackIcon; }
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" style="width:3.5rem;height:3.5rem;">@Html.Raw(svcIcon)</svg>
                                </span>
                                @if (svc.IsFixedPrice)
                                {
                                    <span class="badge badge--success" style="position:absolute;top:.75rem;right:.75rem;">قیمت ثابت</span>
                                }
                            </div>
                            <div class="service-card__body">
                                <div class="service-card__category">@(svc.CategoryName ?? "خدمات عمومی")</div>
                                <a asp-controller="Services" asp-action="Details" asp-route-id="@svc.Id"
                                   class="service-card__title">@svc.Title</a>
                                @if (!string.IsNullOrEmpty(svc.Description))
                                {
                                    <p class="service-card__desc">@svc.Description</p>
                                }
                                <div class="service-card__footer">
                                    <div>
                                        @if (svc.BasePrice.HasValue)
                                        {
                                            <div class="service-card__price-label">شروع از</div>
                                            <div class="service-card__price">@svc.BasePrice.Value.ToString("N0") ت</div>
                                        }
                                        else
                                        {
                                            <div class="service-card__price" style="font-size:var(--text-base)">توافقی</div>
                                        }
                                    </div>
                                    <a asp-controller="ServiceRequests" asp-action="Create" asp-route-serviceId="@svc.Id"
                                       class="btn btn-primary btn-sm" onclick="event.stopPropagation()">درخواست</a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </section>
}

@* ═══════════════════════════════════════════════════════
   TOP EXPERTS
   ═══════════════════════════════════════════════════════ *@
@if (Model.TopExperts.Any())
{
    <section class="experts-section">
        <div class="hs-container">
            <div class="d-flex justify-content-between align-items-end" style="margin-bottom:var(--space-10);">
                <div data-reveal="up">
                    <div class="section-label">مورداعتمادترین‌ها</div>
                    <h2 class="section-title" style="margin-bottom:0">کارشناسان برتر</h2>
                </div>
                <a asp-controller="Experts" asp-action="Index"
                   class="btn btn-secondary" data-reveal="up">مشاهده همه ←</a>
            </div>
            <div class="row g-4 row-cols-1 row-cols-md-2 row-cols-lg-3" data-stagger>
                @foreach (var expert in Model.TopExperts.Take(6))
                {
                    <div class="col" data-reveal="up">
                        <div class="expert-card hover-lift">
                            <div class="expert-card__avatar-wrap">
                                <div class="expert-card__avatar">@(expert.BusinessName?.FirstOrDefault() ?? 'P')</div>
                                @if (expert.IsVerified)
                                {
                                    <div class="expert-card__verified">✓ تأیید شده</div>
                                }
                            </div>
                            <a asp-controller="Experts" asp-action="Details" asp-route-id="@expert.Id"
                               class="expert-card__name">@expert.BusinessName</a>
                            @if (!string.IsNullOrWhiteSpace(expert.City))
                            {
                                <div class="expert-card__location">@IconSvg.Pin @expert.City</div>
                            }
                            <div class="expert-card__stars">
                                @for (int i = 1; i <= 5; i++)
                                {
                                    <span class="star @(i <= Math.Round(expert.RatingAverage) ? "star--filled" : "")">★</span>
                                }
                                <span class="expert-card__rating-text">@expert.RatingAverage.ToString("0.0")</span>
                                <span class="expert-card__rating-count">(@expert.ReviewCount)</span>
                            </div>
                            <div class="expert-card__stats">
                                <div class="expert-card__stat">
                                    <div class="expert-card__stat-value">@expert.JobsCompleted</div>
                                    <div class="expert-card__stat-label">پروژه</div>
                                </div>
                                <div class="expert-card__stat">
                                    <div class="expert-card__stat-value">@(expert.ResponseTimeMinutes ?? 60)</div>
                                    <div class="expert-card__stat-label">دقیقه پاسخ</div>
                                </div>
                            </div>
                            @if (expert.CategoryNames.Any())
                            {
                                <div class="expert-card__tags">
                                    @foreach (var cat in expert.CategoryNames.Take(3))
                                    {
                                        <span class="badge badge--primary">@cat</span>
                                    }
                                </div>
                            }
                            <div class="expert-card__cta">
                                <a asp-controller="Experts" asp-action="Details" asp-route-id="@expert.Id"
                                   class="btn btn-primary btn-block">مشاهده پروفایل</a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </section>
}

@* ═══════════════════════════════════════════════════════
   CTA
   ═══════════════════════════════════════════════════════ *@
<section class="cta-section">
    <div class="hs-container" style="position:relative;z-index:1;text-align:center;">
        <div data-reveal="up">
            <h2 style="font-size:clamp(2rem,4vw,3rem);font-weight:var(--font-black);color:white;letter-spacing:-.03em;margin-bottom:var(--space-4);">
                آماده شروع هستید؟
            </h2>
            <p style="font-size:var(--text-xl);color:rgba(255,255,255,.8);margin-bottom:var(--space-10);max-width:480px;margin-left:auto;margin-right:auto;line-height:1.6;">
                اولین درخواست خود را همین الان ثبت کنید. رایگان، سریع، بدون تعهد.
            </p>
            <div style="display:flex;gap:var(--space-3);justify-content:center;flex-wrap:wrap;">
                <a asp-controller="ServiceRequests" asp-action="Create"
                   class="btn btn-xl hover-lift"
                   style="background:white;color:var(--primary-700);font-weight:var(--font-bold);box-shadow:0 8px 32px rgba(0,0,0,.2);">
                    ثبت درخواست رایگان ←
                </a>
                <a asp-controller="Account" asp-action="Register"
                   class="btn btn-xl"
                   style="background:rgba(255,255,255,.15);color:white;border:1.5px solid rgba(255,255,255,.4);">
                    ایجاد حساب کاربری
                </a>
            </div>
        </div>
    </div>
</section>

@section Scripts {
<script>
(function () {
    var track = document.getElementById('cat-marquee');
    var inner = document.getElementById('cat-marquee-inner');
    if (!track || !inner || !inner.children.length) return;

    /* ── دنباله قطاری نامحدود ─────────────────────────────
       آیتم‌ها آن‌قدر کلون می‌شوند که همیشه عرض داخلی از
       «عرض مسیر + دو ست کامل» بیشتر باشد؛ سپس با یک حلقه
       rAF موقعیت به‌صورت پیوسته جابجا و به پیمانه (mod)
       عرض یک ست گرد می‌شود — هیچ‌گاه صفحه خالی دیده نمی‌شود.
    ────────────────────────────────────────────────────── */

    var GAP = 12;                     // فاصله بین آیتم‌ها (باید با gap در CSS یکی باشد)
    var AUTO_SPEED = 0.55;            // px per frame (~33px/s)
    var reduceMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // ── کلون کردن تا پوشش کامل ──
    var baseHTML = inner.innerHTML;
    var baseCount = inner.children.length;   // تعداد آیتم‌های ست اصلی (پیش از کلون)
    function ensureCopies() {
        var trackW = track.clientWidth;
        var setW = inner.scrollWidth + GAP;   // عرض یک ست + گپ اتصال
        // هر بار یک ست کامل اضافه می‌کنیم تا عرض درون‌گر ≥ مسیر + ۲ ست شود
        while (inner.scrollWidth < trackW + setW * 2) {
            inner.insertAdjacentHTML('beforeend', baseHTML);
        }
        return setW;
    }
    var setWidth = ensureCopies();
    // اندازه‌گیری دقیق عرض یک ست: فاصله افقی قرص نخست دو ست متوالی
    // (تقسیم scrollWidth تقریبی است و با پهنای متفاوت آیتم‌ها محل اتصال را جابجا می‌کند)
    (function measureExact() {
        var pills = inner.children;
        if (pills.length >= baseCount * 2) {
            var a = pills[0].getBoundingClientRect();
            var b = pills[baseCount].getBoundingClientRect();
            var d = Math.abs(a.right - b.right) || Math.abs(a.left - b.left);
        if (d > 0) setWidth = d;
    }
    })();

    var pos = 0;          // جابجایی فعلی (px) — مثبت = حرکت محتوا به راست (درست برای RTL)
    var vel = 0;          // سرعت باقیمانده از درگ (اینرسی)
    var dragging = false;
    var lastX = 0;
    var movedTotal = 0;

    function wrap(p) { return ((p % setWidth) + setWidth) % setWidth; }
    function render() { inner.style.transform = 'translateX(' + pos.toFixed(2) + 'px)'; }

    // ── حلقه اصلی ──
    function loop() {
        if (!dragging) {
            if (vel !== 0) {
                pos += vel;
                vel *= 0.94;                       // اصطکاک اینرسی
                if (Math.abs(vel) < 0.05) vel = 0;
            }
            if (!reduceMotion) pos += AUTO_SPEED;  // حرکت خودکار همیشگی
        }
        pos = wrap(pos);
        render();
        requestAnimationFrame(loop);
    }
    requestAnimationFrame(loop);

    // ── درگ با ماوس/لمس ──
    function startXOf(e) { return e.touches ? e.touches[0].clientX : e.clientX; }

    function onDragStart(e) {
        dragging = true;
        vel = 0;
        lastX = startXOf(e);
        movedTotal = 0;
        track.classList.add('dragging');
        if (e.cancelable) e.preventDefault();
    }

    function onDragMove(e) {
        if (!dragging) return;
        var x = startXOf(e);
        var dx = x - lastX;
        lastX = x;
        movedTotal += Math.abs(dx);
        pos = wrap(pos + dx);      // محتوا دنبال انگشت/نشانگر می‌آید
        vel = dx * 0.9;            // ثبت سرعت برای اینرسی
        render();
        if (e.cancelable) e.preventDefault();
    }

    function onDragEnd() {
        if (!dragging) return;
        dragging = false;
        track.classList.remove('dragging');
    }

    track.addEventListener('mousedown',  onDragStart);
    window.addEventListener('mousemove', onDragMove);
    window.addEventListener('mouseup',   onDragEnd);

    track.addEventListener('touchstart', onDragStart, { passive: false });
    window.addEventListener('touchmove', onDragMove,  { passive: false });
    window.addEventListener('touchend',  onDragEnd);

    // کلیک پس از درگ واقعی لغو شود (تا هنگام کشیدن، لینک باز نشود)
    track.addEventListener('click', function (e) {
        if (movedTotal > 6) { e.preventDefault(); movedTotal = 0; }
    });

    // در تغییر اندازه پنجره، پوشش کلون‌ها دوباره تضمین می‌شود
    window.addEventListener('resize', function () {
        ensureCopies();
    });
}());
</script>
}
