@using HomeServices.Mvc.Extensions
@model IReadOnlyList<CategoryDto>
@{
    ViewData["Title"] = "مدیریت دسته‌بندی‌ها";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <p class="text-muted mb-0">@Model.Count دسته‌بندی</p>
    <a asp-action="Create" class="btn btn-brand btn-sm">+ دسته‌بندی جدید</a>
</div>

<div class="admin-card">
    <div class="table-responsive">
        <table class="admin-table">
            <thead>
                <tr>
                    <th>نام</th>
                    <th>گروه</th>
                    <th>زیردسته</th>
                    <th>خدمات</th>
                    <th>وضعیت</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr><td colspan="6" class="text-center text-muted py-4">دسته‌بندی‌ای وجود ندارد</td></tr>
                }
                else
                {
                    foreach (var c in Model)
                    {
                        <tr>
                            <td>
                                @if (!string.IsNullOrEmpty(c.IconUrl))
                                {<img src="@c.IconUrl" style="width:24px;height:24px;object-fit:cover;border-radius:6px;" /> }
                                <span class="fw-700">@c.Name</span>
                            </td>
                            <td>@c.Group.ToDisplay()</td>
                            <td>@c.SubCategoryCount</td>
                            <td>@c.ServiceCount</td>
                            <td>
                                @if (c.IsActive) { <span class="badge-soft badge-success-soft">فعال</span> }
                                else { <span class="badge-soft badge-warning-soft">غیرفعال</span> }
                            </td>
                            <td>
                                <a asp-action="Edit" asp-route-id="@c.Id" class="btn btn-sm btn-outline-brand">ویرایش</a>
                                <form asp-action="Delete" asp-route-id="@c.Id" method="post" class="d-inline"
                                      onsubmit="return confirm('حذف شود؟');">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">حذف</button>
                                </form>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
