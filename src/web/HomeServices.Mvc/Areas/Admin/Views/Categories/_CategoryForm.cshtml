@using HomeServices.Mvc.Extensions
@model CategoryFormViewModel
@{
    var parents = (IReadOnlyList<CategoryDto>)ViewBag.Parents;
    var isEdit = Model.Id > 0;
}

<div class="admin-card">
    <h5 class="admin-card-title">@(isEdit ? "ویرایش دسته‌بندی" : "دسته‌بندی جدید")</h5>
    <form asp-action="@(isEdit ? "Edit" : "Create")" method="post">
        <input type="hidden" asp-for="Id" />
        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Slug" class="form-label"></label>
                <input asp-for="Slug" class="form-control" placeholder="خالی بگذارید تا خودکار ساخته شود" />
                <span asp-validation-for="Slug" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Group" class="form-label"></label>
                <select asp-for="Group" class="form-select">
                    @foreach (CategoryGroup g in Enum.GetValues(typeof(CategoryGroup)))
                    {
                        <option value="@g" selected="@(Model.Group == g)">@g.ToDisplay()</option>
                    }
                </select>
            </div>
            <div class="col-md-6">
                <label asp-for="ParentCategoryId" class="form-label">دسته‌بندی والد (اختیاری)</label>
                <select asp-for="ParentCategoryId" class="form-select" asp-items="@(new SelectList(parents, "Id", "Name"))">
                    <option value="">— اصلی —</option>
                </select>
            </div>
            <div class="col-md-4">
                <label asp-for="IconUrl" class="form-label"></label>
                <input asp-for="IconUrl" class="form-control" placeholder="آدرس آیکن" />
            </div>
            <div class="col-md-4">
                <label asp-for="DisplayOrder" class="form-label"></label>
                <input asp-for="DisplayOrder" class="form-control" type="number" min="0" />
            </div>
            <div class="col-md-4 d-flex align-items-end">
                <div class="form-check form-switch">
                    <input asp-for="IsActive" class="form-check-input" type="checkbox" />
                    <label asp-for="IsActive" class="form-check-label">فعال</label>
                </div>
            </div>
            <div class="col-12">
                <label asp-for="Description" class="form-label"></label>
                <textarea asp-for="Description" class="form-control" rows="2"></textarea>
            </div>
        </div>
        <div class="mt-3 d-flex gap-2">
            <button type="submit" class="btn btn-brand">@(isEdit ? "ذخیره تغییرات" : "ایجاد دسته‌بندی")</button>
            <a asp-action="Index" class="btn btn-outline-brand">انصراف</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
