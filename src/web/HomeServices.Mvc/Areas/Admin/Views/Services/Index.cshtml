@using HomeServices.Mvc.Extensions
@model PagedResult<ServiceDto>
@{
    ViewData["Title"] = "مدیریت خدمات";
    var categories = (IReadOnlyList<CategoryDto>)ViewBag.Categories;
    var filter = (ServiceFilterDto)ViewBag.CurrentFilter;
}

<form method="get" class="admin-filters">
    <div class="row g-2 align-items-end">
        <div class="col-md-5">
            <label class="form-label small">جستجو</label>
            <input name="search" value="@filter.SearchTerm" class="form-control form-control-sm" placeholder="عنوان خدمت..." />
        </div>
        <div class="col-md-4">
            <label class="form-label small">دسته‌بندی</label>
            <select name="categoryId" class="form-select form-select-sm" asp-items="@(new SelectList(categories, "Id", "Name", filter.CategoryId))">
                <option value="">همه</option>
            </select>
        </div>
        <div class="col-md-3">
            <button type="submit" class="btn btn-brand btn-sm w-100">فیلتر</button>
        </div>
    </div>
</form>

<div class="d-flex justify-content-between align-items-center mb-3">
    <p class="text-muted mb-0">@Model.TotalCount خدمت</p>
    <a asp-action="Create" class="btn btn-brand btn-sm">+ خدمت جدید</a>
</div>

<div class="admin-card">
    <div class="table-responsive">
        <table class="admin-table">
            <thead>
                <tr>
                    <th>عنوان</th>
                    <th>دسته</th>
                    <th>قیمت پایه</th>
                    <th>مدت</th>
                    <th>وضعیت</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Items.Any())
                {
                    <tr><td colspan="6" class="text-center text-muted py-4">خدمتی یافت نشد</td></tr>
                }
                else
                {
                    foreach (var s in Model.Items)
                    {
                        <tr>
                            <td><span class="fw-700">@s.Title</span></td>
                            <td>@s.CategoryName</td>
                            <td>@(s.BasePrice.HasValue ? s.BasePrice.Value.ToString("N0") + " ت" : "—")</td>
                            <td>@(s.EstimatedDurationMinutes.HasValue ? s.EstimatedDurationMinutes + " دقیقه" : "—")</td>
                            <td>
                                @if (s.IsActive) { <span class="badge-soft badge-success-soft">فعال</span> }
                                else { <span class="badge-soft badge-warning-soft">غیرفعال</span> }
                            </td>
                            <td>
                                <a asp-action="Edit" asp-route-id="@s.Id" class="btn btn-sm btn-outline-brand">ویرایش</a>
                                <form asp-action="Delete" asp-route-id="@s.Id" method="post" class="d-inline"
                                      onsubmit="return confirm('حذف شود؟');">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">حذف</button>
                                </form>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    @{
        var totalPages = (int)Math.Ceiling((double)Model.TotalCount / Model.PageSize);
        if (totalPages > 1)
        {
            <nav class="mt-3">
                <ul class="pagination pagination-sm justify-content-center">
                    @for (int i = 1; i <= totalPages; i++)
                    {
                        <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                            <a class="page-link" asp-action="Index" asp-route-page="@i"
                               asp-route-categoryId="@filter.CategoryId" asp-route-search="@filter.SearchTerm">@i</a>
                        </li>
                    }
                </ul>
            </nav>
        }
    }
</div>
