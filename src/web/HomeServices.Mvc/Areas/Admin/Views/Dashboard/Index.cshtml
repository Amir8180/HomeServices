@{
    ViewData["Title"] = "داشبورد";
    var openReq = (int)ViewBag.OpenRequestsCount;
    var inProg = (int)ViewBag.InProgressRequestsCount;
    var completed = (int)ViewBag.CompletedOrdersCount;
    var totalOrders = (int)ViewBag.TotalOrdersCount;
    var pendingReviews = (int)ViewBag.PendingReviewsCount;
    var pendingExperts = (int)ViewBag.PendingExpertsCount;
    var servicesCount = (int)ViewBag.ServicesCount;
    var categoriesCount = (int)ViewBag.CategoriesCount;
    var revenue = (decimal)ViewBag.TotalRevenue;
}

<div class="row g-3 mb-4">
    <div class="col-6 col-xl-3">
        <div class="admin-stat">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <div class="stat-value">@openReq</div>
                    <div class="stat-label">درخواست باز</div>
                </div>
                <div class="stat-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" style="width:22px;height:22px;"><path d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2"/><rect x="9" y="3" width="6" height="4" rx="1"/><path d="M9 12h6M9 16h4"/></svg>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="admin-stat" style="border-inline-start-color: #F59E0B;">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <div class="stat-value">@inProg</div>
                    <div class="stat-label">در حال انجام</div>
                </div>
                <div class="stat-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" style="width:22px;height:22px;"><path d="M14.7 6.3a1 1 0 000 1.4l1.6 1.6a1 1 0 001.4 0l3.77-3.77a6 6 0 01-7.94 7.94l-6.91 6.91a2.12 2.12 0 01-3-3l6.91-6.91a6 6 0 017.94-7.94l-3.76 3.76z"/></svg>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="admin-stat" style="border-inline-start-color: var(--secondary);">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <div class="stat-value">@totalOrders</div>
                    <div class="stat-label">کل سفارش‌ها</div>
                </div>
                <div class="stat-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" style="width:22px;height:22px;"><path d="M21 16V8a2 2 0 00-1-1.73l-7-4a2 2 0 00-2 0l-7 4A2 2 0 003 8v8a2 2 0 001 1.73l7 4a2 2 0 002 0l7-4A2 2 0 0021 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></svg>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="admin-stat" style="border-inline-start-color: #15803D;">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <div class="stat-value">@revenue.ToString("N0")</div>
                    <div class="stat-label">درآمد (تومان)</div>
                </div>
                <div class="stat-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" style="width:22px;height:22px;"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 100 7h5a3.5 3.5 0 110 7H6"/></svg>
                </div>
        </div>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-6 col-xl-3">
        <div class="admin-stat">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <div class="stat-value">@completed</div>
                    <div class="stat-label">سفارش تکمیل‌شده</div>
                </div>
                <div class="stat-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" style="width:22px;height:22px;"><path d="M22 11.08V12a10 10 0 11-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <a asp-controller="Reviews" asp-action="Index" asp-route-status="@ReviewStatus.Pending" class="text-decoration-none">
            <div class="admin-stat" style="border-inline-start-color: #F59E0B;">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <div class="stat-value">@pendingReviews</div>
                        <div class="stat-label">نظر در انتظار بررسی</div>
                    </div>
                    <div class="stat-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" style="width:22px;height:22px;"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                    </div>
                </div>
            </div>
        </a>
    </div>
    <div class="col-6 col-xl-3">
        <a asp-controller="Experts" asp-action="Index" asp-route-approved="false" class="text-decoration-none">
            <div class="admin-stat" style="border-inline-start-color: var(--secondary);">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <div class="stat-value">@pendingExperts</div>
                        <div class="stat-label">کارشناس در انتظار تأیید</div>
                    </div>
                    <div class="stat-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" style="width:22px;height:22px;"><path d="M14.7 6.3a1 1 0 000 1.4l1.6 1.6a1 1 0 001.4 0l3.77-3.77a6 6 0 01-7.94 7.94l-6.91 6.91a2.12 2.12 0 01-3-3l6.91-6.91a6 6 0 017.94-7.94l-3.76 3.76z"/></svg>
                </div>
            </div>
        </a>
    </div>
    <div class="col-6 col-xl-3">
        <div class="admin-stat" style="border-inline-start-color: #15803D;">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <div class="stat-value">@servicesCount</div>
                    <div class="stat-label">خدمات فعال</div>
                </div>
                <div class="stat-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" style="width:22px;height:22px;"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"/><path d="M16 21V5a2 2 0 00-2-2h-4a2 2 0 00-2 2v16"/></svg>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="admin-card">
    <h5 class="admin-card-title">به پنل مدیریت خوش آمدید</h5>
    <p class="text-muted mb-0">
        از منوی کناری برای مدیریت درخواست‌ها، خدمات، دسته‌بندی‌ها، کارشناسان، نظرات، کاربران و تنظیمات سایت استفاده کنید.
        @categoriesCount دسته‌بندی و @servicesCount خدمت در حال حاضر در سایت فعال است.
    </p>
</div>
