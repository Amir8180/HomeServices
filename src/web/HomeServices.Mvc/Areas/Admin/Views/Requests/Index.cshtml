@using HomeServices.Mvc.Extensions
@model PagedResult<ServiceRequestDto>
@{
    ViewData["Title"] = "مدیریت درخواست‌ها";
    var categories = (IReadOnlyList<CategoryDto>)ViewBag.Categories;
    var filter = (ServiceRequestFilterDto)ViewBag.CurrentFilter;
}

<form method="get" class="admin-filters">
    <div class="row g-2 align-items-end">
        <div class="col-md-3">
            <label class="form-label small">جستجو</label>
            <input name="search" value="@filter.SearchTerm" class="form-control form-control-sm" placeholder="عنوان..." />
        </div>
        <div class="col-md-3">
            <label class="form-label small">دسته‌بندی</label>
            <select name="categoryId" class="form-select form-select-sm" asp-items="@(new SelectList(categories, "Id", "Name", filter.CategoryId))">
                <option value="">همه</option>
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label small">وضعیت</label>
            <select name="status" class="form-select form-select-sm">
                <option value="">همه</option>
                @foreach (RequestStatus s in Enum.GetValues(typeof(RequestStatus)))
                {
                    <option value="@s" selected="@(filter.Status == s)">@s.ToDisplay()</option>
                }
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label small">فوریت</label>
            <select name="urgency" class="form-select form-select-sm">
                <option value="">همه</option>
                @foreach (UrgencyLevel u in Enum.GetValues(typeof(UrgencyLevel)))
                {
                    <option value="@u" selected="@(filter.Urgency == u)">@u.ToDisplay()</option>
                }
            </select>
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-brand btn-sm w-100">فیلتر</button>
        </div>
    </div>
</form>

<div class="admin-card">
    <div class="table-responsive">
        <table class="admin-table">
            <thead>
                <tr>
                    <th>عنوان</th>
                    <th>دسته</th>
                    <th>شهر</th>
                    <th>فوریت</th>
                    <th>وضعیت</th>
                    <th>تاریخ</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Items.Any())
                {
                    <tr><td colspan="7" class="text-center text-muted py-4">درخواستی یافت نشد</td></tr>
                }
                else
                {
                    foreach (var r in Model.Items)
                    {
                        <tr>
                            <td><a asp-action="Details" asp-route-id="@r.Id" class="fw-700">@r.Title</a></td>
                            <td>@r.CategoryName</td>
                            <td>@(r.City ?? "—")</td>
                            <td><span class="badge-soft badge-info-soft">@r.Urgency.ToDisplay()</span></td>
                            <td><span class="badge-soft @r.Status.StatusClass()">@r.Status.ToDisplay()</span></td>
                            <td class="small text-muted">@r.CreatedAt.ToPersianDate()</td>
                            <td><a asp-action="Details" asp-route-id="@r.Id" class="btn btn-sm btn-outline-brand">جزئیات</a></td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    @{
        var totalPages = (int)Math.Ceiling((double)Model.TotalCount / Model.PageSize);
        if (totalPages > 1)
        {
            <nav class="mt-3">
                <ul class="pagination pagination-sm justify-content-center">
                    @for (int i = 1; i <= totalPages; i++)
                    {
                        <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                            <a class="page-link" asp-action="Index" asp-route-page="@i"
                               asp-route-categoryId="@filter.CategoryId" asp-route-status="@filter.Status"
                               asp-route-urgency="@filter.Urgency" asp-route-search="@filter.SearchTerm">@i</a>
                        </li>
                    }
                </ul>
            </nav>
        }
    }
</div>
